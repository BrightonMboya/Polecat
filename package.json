{
  "name": "polycate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/main",
    "apps/marketing/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@polycate/main' dev",
    "dev:lp": "bun run --filter '@polycate/polecat-lp' dev",
    "build": "bun run --filter '*' build",
    "build:main": "bun run --filter '@polycate/main' build",
    "build:lp": "bun run --filter '@polycate/polecat-lp' build"
  }
}
