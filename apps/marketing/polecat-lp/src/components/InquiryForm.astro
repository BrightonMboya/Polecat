---
/*
 * Inquiry form — WhatsApp-first lead capture, ported from the Mufasa landing
 * page (~/web/mufasa) so both campaigns capture leads the same way. On submit
 * it composes a message from the field values and opens wa.me/<number> with
 * everything pre-filled, so the visitor lands in a chat and the lead arrives in
 * the WhatsApp inbox. In parallel it emails the lead via Web3Forms, which
 * catches everyone who submits but never actually sends the message.
 * No backend required.
 *
 * All visitor-facing labels come from `copy` (src/content/fr.ts), so this
 * component carries no hardcoded copy — see LandingPage.astro.
 */
import { CONTACT, WEB3FORMS, GOOGLE_ADS, LEAD_SOURCE } from '../config'
import type { FormCopy } from '../content/types'

interface Props {
    id?: string
    copy: FormCopy
    privacyPath: string
    submitLabel?: string
}

const { id = 'inquiry', copy, privacyPath, submitLabel = copy.submitLabelDefault } = Astro.props

/*
 * One chronological month+year list, rather than a month field and a year field
 * the visitor has to combine. Two fields let them submit a window that cannot be
 * booked — "Janvier" paired with a year whose January has already gone — or a
 * half-answer like a "Flexible" month with a fixed year. A single list can only
 * produce a real travel window.
 *
 * Runs from the current month to the end of the third calendar year. Rebuilt at
 * build time, so redeploys keep it from drifting into the past; a page cached
 * across a month boundary only ever shows one stale option, and it stays
 * selectable rather than breaking.
 */
const now = new Date()
const currentYear = now.getFullYear()
const travelWindows: { value: string; label: string }[] = []
for (let y = currentYear; y <= currentYear + 2; y++) {
    for (let m = y === currentYear ? now.getMonth() : 0; m < 12; m++) {
        travelWindows.push({
            // ISO-ish value so the script can translate it for the lead email
            // without a second French→English month table.
            value: `${y}-${String(m + 1).padStart(2, '0')}`,
            label: `${copy.months[m]} ${y}`,
        })
    }
}

// Passed to the client script as JSON so it can build the WhatsApp message
// without re-implementing the copy in JS.
const waCopyJson = JSON.stringify({ intro: copy.waIntro, labels: copy.waLabels })
---

<form id={id} class="space-y-4" data-wa-number={CONTACT.whatsappNumber} data-w3f-key={WEB3FORMS.accessKey}
      data-gads-conversion={GOOGLE_ADS.conversionSendTo} data-wa-copy={waCopyJson}
      data-source-tag={LEAD_SOURCE.tag} data-source-label={LEAD_SOURCE.label} novalidate>
    {/* Honeypot — hidden from people, tempting to bots. Web3Forms drops any
        submission where this is filled, so the public key doesn't invite spam. */}
    <input type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
    <div class="flex items-center gap-2 rounded-lg bg-green-50 px-3 py-2 text-sm">
        <svg class="h-4 w-4 shrink-0 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span class="text-gray-700">{copy.badgeText}</span>
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-name`}>{copy.nameLabel}</label>
        <input id={`${id}-name`} name="name" type="text" required placeholder={copy.namePlaceholder}
            class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30" />
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-email`}>{copy.emailLabel}</label>
        <input id={`${id}-email`} name="email" type="email" required placeholder={copy.emailPlaceholder}
            class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30" />
    </div>

    {/* Optional, and worth the extra field: the lead email exists to catch
        visitors who submit but never send the WhatsApp message — and for those
        the team otherwise has an address and no phone number. Left optional so
        it can't cost a submission. `inputmode` gives phones a numeric keypad. */}
    <div>
        <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-whatsapp`}>
            {copy.whatsappNumberLabel} <span class="font-normal text-gray-500">{copy.optionalSuffix}</span>
        </label>
        <input id={`${id}-whatsapp`} name="whatsapp" type="tel" inputmode="tel" autocomplete="tel"
            placeholder={copy.whatsappNumberPlaceholder}
            class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30" />
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div>
            <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-travel`}>{copy.travelLabel}</label>
            <select id={`${id}-travel`} name="travel" required
                class="h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30">
                <option value="">{copy.travelPlaceholder}</option>
                {travelWindows.map((w) => <option value={w.value}>{w.label}</option>)}
                {/* Kept as an explicit choice: a traveller who hasn't settled on
                    dates is still a lead, and forcing a month would either lose
                    them or invent a date the team then quotes against. */}
                <option value="flexible">{copy.travelFlexibleLabel}</option>
            </select>
        </div>
        <div>
            <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-travellers`}>{copy.travellersLabel}</label>
            <input id={`${id}-travellers`} name="travellers" type="number" min="1" max="20" value="2"
                class="h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30" />
        </div>
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-800" for={`${id}-message`}>
            {copy.messageLabel} <span class="font-normal text-gray-500">{copy.optionalSuffix}</span>
        </label>
        <textarea id={`${id}-message`} name="message" placeholder={copy.messagePlaceholder}
            class="min-h-[70px] w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-primary focus:ring-2 focus:ring-primary/30"></textarea>
    </div>

    <button type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-full bg-primary py-3 text-base font-semibold text-white transition-colors hover:bg-primary-dark">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        {submitLabel}
    </button>
    <p class="text-center text-xs text-gray-500">
        {copy.disclaimerPrefix}
        {' '}
        <a href={privacyPath} class="underline underline-offset-2 hover:text-primary">{copy.disclaimerLinkText}</a>.
    </p>

    {/* Shown after submit — guarantees feedback even if the WhatsApp tab was
        blocked, and offers a manual link as a fallback. */}
    <div data-wa-success class="hidden rounded-lg border border-green-200 bg-green-50 p-4 text-center text-sm">
        <p class="font-semibold text-green-800">{copy.successHeading}</p>
        <p class="mt-1 text-gray-600">
            {copy.successBody}
            {' '}
            <a data-wa-link href="#" target="_blank" rel="noopener noreferrer" class="font-medium text-green-700 underline underline-offset-2">{copy.successLinkText}</a>.
        </p>
    </div>
</form>

<script>
    // On submit we do two independent things so a lead is never lost:
    //   1. Open WhatsApp — the primary, instant path.
    //   2. Email the lead via Web3Forms — a capture that survives even if the
    //      visitor never sends the WhatsApp message.
    // Neither can break the other: WhatsApp opens synchronously (so a popup
    // blocker can't eat the user-gesture), and the email POST is best-effort.
    document.querySelectorAll<HTMLFormElement>('form[data-wa-number]').forEach((form) => {
        const waCopy: { intro: string; labels: Record<string, string> } =
            JSON.parse(form.dataset.waCopy ?? '{}')

        form.addEventListener('submit', (e) => {
            e.preventDefault()
            if (!form.reportValidity()) return

            const number = form.dataset.waNumber
            const w3fKey = form.dataset.w3fKey
            const get = (n: string) =>
                (form.elements.namedItem(n) as HTMLInputElement | null)?.value?.trim() ?? ''

            // Google Ads conversion — fired first so nothing downstream can stop it.
            const sendTo = form.dataset.gadsConversion
            const gtag = (window as any).gtag
            if (sendTo && typeof gtag === 'function') {
                gtag('event', 'conversion', { send_to: sendTo })
            }

            const name = get('name')
            const email = get('email')
            const whatsapp = get('whatsapp')
            const travellers = get('travellers')
            const note = get('message')

            // Where the lead came from — full URL, so any utm_* / gclid the ad
            // click carried survives into the inbox, and the team can open the
            // exact page (and form: hero vs. bottom) the visitor submitted from.
            const pageUrl = window.location.href

            // African Polecat Safaris also take quote requests through their
            // main site and by phone, so the email says outright that this one
            // came from the landing page — and, where the URL reveals it, which
            // click paid for it. `gclid` is appended by Google Ads auto-tagging.
            const sourceTag = form.dataset.sourceTag || 'Landing Page'
            const sourceLabel = form.dataset.sourceLabel || 'Campaign landing page'
            const params = new URLSearchParams(window.location.search)
            const utmSource = params.get('utm_source')
            const utmCampaign = params.get('utm_campaign')
            const channel = params.get('gclid')
                ? 'Google Ads — paid click'
                : utmSource
                  ? [utmSource, utmCampaign].filter(Boolean).join(' · ')
                  : 'Direct / organic (no ad click tracked)'

            // The travel window renders twice: French for WhatsApp and the form
            // (visitor-facing), English for the lead email (the Arusha team
            // reads it). The French side is the option's own label, so there is
            // no second copy of the month names to keep in sync; the English
            // side is derived from the "YYYY-MM" value.
            const MONTHS_EN = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December',
            ]
            const travelField = form.elements.namedItem('travel') as HTMLSelectElement | null
            const travelValue = travelField?.value ?? ''
            const travelFr = travelField?.selectedOptions[0]?.textContent?.trim() ?? ''
            const travelEn = /^\d{4}-\d{2}$/.test(travelValue)
                ? `${MONTHS_EN[Number(travelValue.slice(5)) - 1]} ${travelValue.slice(0, 4)}`
                : 'Flexible dates'

            // 1) WhatsApp — synchronous, so the click gesture isn't lost.
            const waLines = [
                waCopy.intro,
                '',
                `${waCopy.labels.name}: ${name}`,
                `${waCopy.labels.email}: ${email}`,
                ...(whatsapp ? [`${waCopy.labels.whatsapp}: ${whatsapp}`] : []),
                `${waCopy.labels.travel}: ${travelFr}`,
                `${waCopy.labels.travellers}: ${travellers}`,
            ]
            if (note) waLines.push(`${waCopy.labels.notes}: ${note}`)
            waLines.push('', `${waCopy.labels.page}: ${pageUrl}`)
            const waUrl = `https://wa.me/${number}?text=${encodeURIComponent(waLines.join('\n'))}`
            window.open(waUrl, '_blank', 'noopener')

            // 2) Email via Web3Forms — parallel, best-effort. `keepalive` lets it
            //    finish even if the tab is closed right after. Skipped (no error)
            //    if no access key is set in config.ts.
            if (w3fKey) {
                fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    keepalive: true,
                    body: JSON.stringify({
                        access_key: w3fKey,
                        subject: `[${sourceTag}] New safari lead — ${name || 'no name'} (${travellers || '?'} pax · ${travelEn})`,
                        from_name: sourceTag,
                        replyto: email,
                        botcheck: get('botcheck'),
                        // Web3Forms renders the fields in the order given, so the
                        // two source rows land at the top of the email, above the
                        // traveller's own details.
                        'Request came from': sourceLabel,
                        'Traffic source': channel,
                        Name: name,
                        Email: email,
                        WhatsApp: whatsapp || '—',
                        'Travel window': travelEn,
                        Travellers: travellers,
                        Notes: note || '—',
                        'Page URL': pageUrl,
                        Form: form.id || '—',
                    }),
                }).catch(() => {
                    // The WhatsApp path already carries this lead; ignore transient
                    // email failures rather than block or alarm the visitor.
                })
            }

            // 3) Always confirm, and expose a manual WhatsApp link in case the
            //    popup was blocked.
            const success = form.querySelector<HTMLElement>('[data-wa-success]')
            const link = form.querySelector<HTMLAnchorElement>('[data-wa-link]')
            if (link) link.href = waUrl
            if (success) success.classList.remove('hidden')
        })
    })
</script>
