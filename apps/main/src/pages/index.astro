---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import ImpactSplit from '../components/ImpactSplit.astro'
import Packages from '../components/Packages.astro'
// import Journal from '../components/Journal.astro'
import Reviews from '../components/Reviews.astro'
import Partners from '../components/Partners.astro'
import Newsletter from '../components/Newsletter.astro'
import Footer from '../components/Footer.astro'
import { HERO } from '../content/home'
---

<Layout
    title="Polecat Safaris — Private Tanzania & Zanzibar Safaris from Arusha"
    description="Owner-run, private safaris across northern Tanzania and Zanzibar — Tarangire, the Ngorongoro Crater, the Serengeti and the coast, built around our own guides and the seasons worth travelling for."
    preloadImage={HERO.image}
    preloadImageSrcset={HERO.imageSrcset}
    preloadImageSizes={HERO.imageSizes}
>
    <Header />
    <main>
        <Hero />
        <Packages />
        <Reviews />
        <ImpactSplit />
        {/* <Journal /> — journal section hidden for now */}
        <Partners />
        <Newsletter />
    </main>
    <Footer />
</Layout>
