---
/**
 * /travel-information/ — the operator's own pre-departure guide, published as
 * one long page with an index rather than split into a dozen little ones. It
 * is the page a guest opens the week before they fly and again in the taxi to
 * the airport, so everything is on one URL and every section has an anchor.
 *
 * The copy lives in src/content/travel-info.ts. Nothing practical should be
 * edited here: the numbers in it are the operator's, and the medical, visa and
 * insurance paragraphs deliberately point at official sources rather than
 * answering for them. See the header of that file before changing wording.
 *
 * The path has no WordPress ancestor — the old site had no equivalent page —
 * so it is a new URL and is in the sitemap and the footer as one.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Newsletter from '../components/Newsletter.astro'
import SectionHeading from '../components/SectionHeading.astro'
import TravelSection from '../components/TravelSection.astro'
import { CONTACT, SITE, whatsappLink } from '../config'
import { NAV } from '../content/home'
import {
    TRAVEL_CHAPTERS,
    TRAVEL_CLOSING,
    TRAVEL_FAQS,
    TRAVEL_INTRO,
    TRAVEL_SECTIONS,
    TRAVEL_SUPPORT,
} from '../content/travel-info'

const sectionById = new Map(TRAVEL_SECTIONS.map((section) => [section.id, section]))

/** A chapter's sections, in the order the chapter names them. */
const sectionsOf = (ids: readonly string[]) =>
    ids.map((id) => {
        const section = sectionById.get(id)
        if (section == null) throw new Error(`Unknown travel-info section: ${id}`)
        return section
    })

/* Chapters alternate white and cream; the Questions chapter is the stone one
   in the middle, which is also how the itinerary pages mark a change of
   register. Notes and cards inside a section take the opposite surface. */
const groundOf = (index: number, id: string): 'white' | 'cream' | 'stone' =>
    id === 'faqs' ? 'stone' : index % 2 === 0 ? 'white' : 'cream'
const GROUND_CLASS = { white: 'bg-white', cream: 'bg-cream', stone: 'bg-stone' } as const

const whatsapp = whatsappLink(
    'Hello Polecat Safaris — I have a question about preparing for my safari.'
)

/*
 * Two nodes. The page itself declares its chapters, so the anchors the team
 * sends guests to are stated rather than inferred; the FAQ chapter is a real
 * FAQPage, which is the one piece of structured data on this site that can
 * earn its own result. Both are emitted alongside the sitewide TravelAgency
 * node — see Layout.astro.
 */
const pageSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebPage',
            name: 'Tanzania Safari Travel Information',
            description:
                'Pre-departure guide for guests travelling with African Polecat Safaris: seasons and temperatures, what to pack, health, money, visas and what to do before you fly.',
            url: 'https://africanpolecatsafaris.com/travel-information/',
            inLanguage: 'en-GB',
            about: { '@type': 'Country', name: 'Tanzania' },
            hasPart: TRAVEL_CHAPTERS.map((chapter) => ({
                '@type': 'WebPageElement',
                name: chapter.heading,
                url: `https://africanpolecatsafaris.com/travel-information/#${chapter.id}`,
            })),
        },
        {
            '@type': 'FAQPage',
            url: 'https://africanpolecatsafaris.com/travel-information/#faqs',
            mainEntity: TRAVEL_FAQS.map((faq) => ({
                '@type': 'Question',
                name: faq.question,
                acceptedAnswer: {
                    '@type': 'Answer',
                    /* One plain-text answer per question. The list, where a
                       question has one, is part of the answer. */
                    text: [...faq.answer, ...(faq.list ?? [])].join(' '),
                },
            })),
        },
    ],
}
---

<Layout
    title="Travel Information — Your Tanzania Safari Travel Guide | Polecat Safaris"
    description="What to pack, what to wear, light-aircraft luggage limits, weather by season, health, money, tipping and visa notes — everything to know before you travel to Tanzania with Polecat Safaris."
    preloadImage={TRAVEL_INTRO.image}
    pageSchema={pageSchema}
>
    <Header />
    <main>
        {/* Full-bleed banner with the page title on it, in the same shape as
            the itinerary heroes: a fixed frame, the photograph under a
            gradient, the type on the floor of it.

            The gradient is heavier than theirs because this photograph is
            brighter. Measured the way scripts/hero-scrim.py measures the
            homepage hero: the brightest pixel under the title column is pure
            white in every band of this frame, which needs 0.48 alpha for the
            title (large text, 3:1) and 0.61 for the line under it (20px
            italic, so not large text, 4.5:1). The stops put the title in
            0.50+ and the italic line in 0.69+, and the top of the frame stays
            light enough for the photograph to read. */}
        <section
            class="relative flex h-90 w-full flex-col justify-end overflow-hidden bg-ink lg:h-125"
        >
            <img
                src={TRAVEL_INTRO.image}
                alt={TRAVEL_INTRO.imageAlt}
                class="absolute inset-0 size-full object-cover object-[50%_45%]"
                fetchpriority="high"
                decoding="async"
            />
            <div
                class="absolute inset-0"
                style="background: linear-gradient(180deg, rgba(35,32,27,0.28) 0%, rgba(35,32,27,0.36) 45%, rgba(35,32,27,0.58) 64%, rgba(35,32,27,0.86) 100%)"
                aria-hidden="true"
            >
            </div>

            <div class="gutter relative flex w-full flex-col items-center pb-12 lg:pb-14">
                <div class="shell flex max-w-215 flex-col items-center gap-4 text-center">
                    <h1
                        class="font-display text-[38px] leading-[1.1] font-light tracking-[-0.014em] text-white sm:text-[48px] lg:text-[62px] lg:leading-[1.06]"
                    >
                        {TRAVEL_INTRO.heading}
                    </h1>
                    <p class="font-display text-[19px] leading-7.5 text-white italic lg:text-[22px] lg:leading-8.5">
                        {TRAVEL_INTRO.standfirst}
                    </p>
                </div>
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-cream pt-13 pb-14 lg:pt-18 lg:pb-16">
            <div class="shell flex max-w-215 flex-col items-center gap-5 text-center">
                <h2
                    class="font-display text-[30px] leading-[1.18] font-light text-ink lg:text-[38px] lg:leading-12"
                >
                    {TRAVEL_INTRO.guideHeading}
                </h2>
                <div class="flex flex-col gap-4 pt-1">
                    {
                        TRAVEL_INTRO.paragraphs.map((paragraph) => (
                            <p class="text-[16px] leading-7.5 text-muted">{paragraph}</p>
                        ))
                    }
                </div>
            </div>
        </section>

        {/* Four chapters, so the bar is four links rather than an index of
            thirteen. It sticks: this is a long page and the thing a guest
            wants most, three screens down, is the way back to the other
            chapters. Same treatment as the itinerary section bar. */}
        <nav
            class="gutter sticky top-0 z-20 flex flex-col items-center border-y border-line bg-cream/95 backdrop-blur"
            aria-label="In this guide"
        >
            <ul class="shell flex items-center gap-6 overflow-x-auto py-4 lg:justify-center lg:gap-10">
                {
                    TRAVEL_CHAPTERS.map((chapter) => (
                        <li class="shrink-0">
                            <a
                                href={`#${chapter.id}`}
                                class="text-[11px] leading-4 font-medium tracking-[0.18em] whitespace-nowrap text-muted uppercase transition-colors hover:text-primary"
                            >
                                {chapter.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        {
            TRAVEL_CHAPTERS.map((chapter, index) => {
                const ground = groundOf(index, chapter.id)

                return (
                    <section
                        id={chapter.id}
                        class:list={[
                            'gutter flex scroll-mt-16 flex-col items-center py-15 lg:py-22',
                            GROUND_CLASS[ground],
                        ]}
                    >
                        <div class="shell flex flex-col">
                            <div class="flex max-w-215 flex-col gap-4">
                                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase">
                                    {chapter.label}
                                </p>
                                <h2 class="font-display text-[32px] leading-[1.18] font-light tracking-[-0.012em] text-ink lg:text-[42px] lg:leading-13">
                                    {chapter.heading}
                                </h2>
                                <p class="text-[16px] leading-7.5 text-muted">
                                    {chapter.standfirst}
                                </p>
                            </div>

                            {chapter.images && (
                                <ul class="mt-10 grid grid-cols-1 gap-5.5 sm:grid-cols-2 lg:mt-12">
                                    {chapter.images.map((image) => (
                                        <li>
                                            <img
                                                src={image.src}
                                                srcset={image.srcset}
                                                sizes="(min-width: 640px) 50vw, 100vw"
                                                alt={image.alt}
                                                width="1400"
                                                height="933"
                                                loading="lazy"
                                                decoding="async"
                                                class="aspect-[3/2] w-full object-cover"
                                            />
                                        </li>
                                    ))}
                                </ul>
                            )}

                            <div class="mt-12 lg:mt-14">
                                {chapter.id === 'faqs' ? (
                                    <dl class="grid grid-cols-1 gap-x-16 gap-y-0 lg:grid-cols-2">
                                        {TRAVEL_FAQS.map((faq) => (
                                            <div class="flex flex-col gap-3 border-t border-line py-8">
                                                <dt class="font-display text-[21px] leading-7.5 font-light text-ink lg:text-[23px] lg:leading-8">
                                                    {faq.question}
                                                </dt>
                                                <dd class="flex flex-col gap-3.5">
                                                    {faq.answer.map((paragraph) => (
                                                        <p class="text-[15px] leading-7 text-muted">
                                                            {paragraph}
                                                        </p>
                                                    ))}
                                                    {faq.list && (
                                                        <ul class="flex flex-col gap-2.5 pt-1">
                                                            {faq.list.map((item) => (
                                                                <li class="flex items-start gap-3.5 text-[15px] leading-6.75 text-muted">
                                                                    <span
                                                                        class="mt-3.25 h-px w-3 shrink-0 bg-primary"
                                                                        aria-hidden="true"
                                                                    />
                                                                    <span class="min-w-0">
                                                                        {item}
                                                                    </span>
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    )}
                                                </dd>
                                            </div>
                                        ))}
                                    </dl>
                                ) : (
                                    sectionsOf(chapter.sections).map((section, sectionIndex) => (
                                        <TravelSection
                                            section={section}
                                            ground={ground}
                                            first={sectionIndex === 0}
                                        />
                                    ))
                                )}
                            </div>
                        </div>
                    </section>
                )
            })
        }

        {/* Support, and the four ways to reach the team. The numbers come from
            src/config.ts; the name is in the content file. */}
        <section id="support" class="gutter flex scroll-mt-8 flex-col items-center bg-stone py-16 lg:py-22">
            <div
                class="shell grid grid-cols-1 gap-10 lg:grid-cols-[1fr_24rem] lg:gap-16 xl:grid-cols-[1fr_26rem]"
            >
                <div class="flex flex-col items-start gap-4">
                    <p
                        class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase"
                    >
                        {TRAVEL_SUPPORT.eyebrow}
                    </p>
                    <h2
                        class="font-display max-w-200 text-[30px] leading-10 font-light text-ink lg:text-[38px] lg:leading-12"
                    >
                        {TRAVEL_SUPPORT.heading}
                    </h2>
                    <div class="flex max-w-200 flex-col gap-4 pt-1">
                        {
                            TRAVEL_SUPPORT.paragraphs.map((paragraph) => (
                                <p class="text-[16px] leading-7.5 text-muted">{paragraph}</p>
                            ))
                        }
                    </div>
                </div>

                <aside class="border-t-2 border-primary bg-white p-7 lg:p-8" aria-label="Contact">
                    <p class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                        {TRAVEL_SUPPORT.contactRole}
                    </p>
                    <p class="font-display mt-3 text-[30px] leading-9 font-light text-ink">
                        {TRAVEL_SUPPORT.contactName}
                    </p>

                    <dl class="mt-7 flex flex-col gap-4 border-t border-line pt-7 text-[15px] leading-6">
                        <div class="flex flex-col gap-1">
                            <dt class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                                WhatsApp
                            </dt>
                            <dd>
                                <a
                                    href={whatsapp}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-primary transition-colors hover:underline"
                                    >{CONTACT.phone}</a
                                >
                            </dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                                Office
                            </dt>
                            <dd>
                                <a
                                    href={CONTACT.officePhoneHref}
                                    class="text-ink transition-colors hover:text-primary"
                                    >{CONTACT.officePhone}</a
                                >
                            </dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                                Email
                            </dt>
                            <dd>
                                <a
                                    href={`mailto:${CONTACT.email}`}
                                    class="break-words text-primary transition-colors hover:underline"
                                    >{CONTACT.email}</a
                                >
                            </dd>
                        </div>
                        <div class="flex flex-col gap-1">
                            <dt class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                                Based in
                            </dt>
                            <dd class="text-muted">{SITE.city}</dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>

        {/* The sign-off, on green — the operator's own closing lines. */}
        <section class="gutter flex flex-col items-center bg-primary py-16 lg:py-22">
            <div class="shell flex max-w-220 flex-col items-start gap-5">
                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-gold uppercase">
                    {TRAVEL_CLOSING.eyebrow}
                </p>
                <h2
                    class="font-display text-[32px] leading-[1.2] font-light tracking-[-0.008em] text-cream lg:text-[44px] lg:leading-14"
                >
                    {TRAVEL_CLOSING.heading}
                </h2>
                <div class="flex flex-col gap-4 pt-1">
                    {
                        TRAVEL_CLOSING.paragraphs.map((paragraph) => (
                            <p class="text-[16px] leading-7.25 text-sage">{paragraph}</p>
                        ))
                    }
                </div>
                <p class="font-display pt-3 text-[26px] leading-9 text-gold lg:text-[28px]">
                    {TRAVEL_CLOSING.welcome}
                </p>
                <p class="text-[11px] leading-4 font-medium tracking-[0.24em] text-sage-dim uppercase">
                    {TRAVEL_CLOSING.signoff}
                </p>
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-cream pt-18 pb-18 lg:pt-22 lg:pb-24">
            <SectionHeading
                eyebrow="Next Step"
                heading="Still deciding when to come?"
                body="The seasons above change the safari more than anything else you will choose. Tell us roughly what you have in mind and we will write back with a draft itinerary built around the right months."
            />
            <div class="flex flex-wrap items-center justify-center gap-5 pt-9">
                <a
                    href={NAV.enquire.href}
                    class="flex items-center justify-center bg-primary px-9 py-4 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-[#083329]"
                >
                    {NAV.enquire.label}
                </a>
                <a
                    href="/safari-packages/"
                    class="flex items-center justify-center border border-primary px-9 py-4 text-[12px] leading-4 font-medium tracking-[0.2em] text-primary uppercase transition-colors hover:bg-primary hover:text-white"
                >
                    See The Itineraries
                </a>
            </div>
        </section>

        <Newsletter />
    </main>
    <Footer />
</Layout>
