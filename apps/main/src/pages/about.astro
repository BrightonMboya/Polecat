---
/**
 * /about/ — the company page the header's "About Us" link lands on.
 *
 * The path is `/about/` rather than `/about-us/` because that is the URL the
 * old WordPress site was indexed under (africanpolecatsafaris.com/about/), and
 * this rebuild keeps the URLs it inherited — see the journal migration.
 *
 * Everything asserted here is checkable: Arusha, TATO membership, the
 * Tripadvisor rating and "private only".
 *
 * The one claim that is not checkable from this repo is the #impact section:
 * that the business puts money into schooling for young Tanzanians. The
 * subject comes from the equivalent band on ~/web/atlas, which is a different
 * operator's site, so it is unconfirmed for this one. It names no programme,
 * no school and no sum, which keeps it from being a false specific — but if
 * the operator does not in fact do this, the section has to come out.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { SITE, TRIPADVISOR } from '../config'
import { NAV } from '../content/home'

/** Three claims the business can stand behind, in the design's card rhythm. */
const PRINCIPLES = [
    {
        heading: 'Exclusively private',
        body: 'Every journey is reserved for you alone: one vehicle, one dedicated guide and your party. It means the days, the lodges and the pace can be shaped around you, before you travel and on the morning itself.',
    },
    {
        heading: 'Deep, not wide',
        body: 'We focus on northern Tanzania, Kilimanjaro and Zanzibar, and we know them intimately. Every park, camp and lodge in our itineraries is one our team works in week after week. We never resell a circuit from afar.',
    },
    {
        heading: 'Guides of distinction',
        body: 'Our guides are the heart of every safari, and our guests remember them by name. They are our own team, chosen for their knowledge, their warmth and their eye for the moment, and never subcontracted.',
    },
]

/*
 * The shape of this section follows the "beyond the journey" band on
 * ~/web/atlas — schooling for young Tanzanians, illustrated with the same
 * photograph. Nothing else is borrowed. Atlas runs a *named* initiative
 * ("Ongeza Hatua Zangu") that belongs to that operator and their Pages.docx;
 * naming a programme here would invent one for Polecat, so this describes the
 * commitment and stops there.
 *
 * Deliberately unspecific about money: no percentage, no per-night levy and
 * no figure, because none has been confirmed. Anything concrete added here —
 * a sum, a school, a number of children — has to come from the operator.
 */
const IMPACT_PARAGRAPHS = [
    'A fortnight in Tanzania ought to leave more behind than a set of photographs. The part of this business that has nothing to do with selling safaris goes to children and teenagers here who are growing up with very little room for error.',
    'Schooling, mostly. The encouragement that keeps a young person in it when a year goes badly, and the openings that let them carry on once school is behind them. Most of the difference gets made at the point where someone would otherwise have quietly stopped turning up.',
    'Our guests come for their own reasons and leave with their own memories, and we would not dress that up as charity. But the same journeys are what make the work possible, and we would rather you knew it was going on than found out about it afterwards.',
]

const pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${SITE.legalName}`,
    description: `${SITE.legalName} designs private, tailor-made journeys through northern Tanzania, Kilimanjaro and Zanzibar from its base in Arusha.`,
    url: 'https://africanpolecatsafaris.com/about/',
}

/*
 * The intro photograph is one of the package images and ships at the same
 * three widths they do. Here it is half the shell on a wide screen and the
 * full column below that.
 */
const INTRO_SRCSET =
    '/images/family-walk-maasai-guide-900.webp 900w, /images/family-walk-maasai-guide-1400.webp 1400w, /images/family-walk-maasai-guide-1920.webp 1920w'
const INTRO_SIZES = '(min-width: 1024px) 636px, calc(100vw - 48px)'
---

<Layout
    title="About Us | Private, tailor-made safaris from Arusha | Polecat Safaris"
    description="African Polecat Safaris designs private, tailor-made journeys through northern Tanzania, Kilimanjaro and Zanzibar from Arusha, with our own expert guides, our own vehicles, and every detail arranged around you."
    preloadImage="/images/family-walk-maasai-guide-1400.webp"
    preloadImageSrcset={INTRO_SRCSET}
    preloadImageSizes={INTRO_SIZES}
    pageSchema={pageSchema}
>
    <Header />
    <main>
        {/* Page head. Copy left, photograph right — a family out on foot with
            their guide and Maasai companions. The page is about who runs the
            safaris, so the image is people rather than an empty vehicle. */}
        <section class="gutter flex flex-col items-center bg-cream pt-14 pb-16 lg:pt-20 lg:pb-24">
            <div
                class="shell flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16"
            >
                {/* `min-w-0` on both halves, and no `shrink-0`: two 50% columns
                    plus the gap are wider than the shell, and an <img> flex item
                    defaults to `min-width: auto` — its intrinsic 1600px — so
                    without this the photograph bleeds past the gutter. */}
                <div class="flex min-w-0 flex-col items-start gap-4 lg:w-1/2">
                    <p
                        class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase"
                    >
                        About Us
                    </p>
                    <h1
                        class="font-display text-[36px] leading-[1.18] font-light text-ink lg:text-[52px] lg:leading-[1.12]"
                    >
                        The art of the private Tanzanian safari
                    </h1>
                    <p class="max-w-160 pt-2 text-[17px] leading-7.75 text-muted">
                        {SITE.legalName} designs private, tailor-made journeys through northern
                        Tanzania, Kilimanjaro and Zanzibar. From our home in Arusha, the gateway to the
                        Serengeti, the Ngorongoro Crater and Tarangire, we arrange every detail
                        ourselves: the lodges, the guides, the vehicles and the pace of each day.
                    </p>
                    {/* The operator's own slogan (SITE.slogan), in their
                        voice, on the one page that is about them rather than
                        about a trip. */}
                    <p
                        class="font-display pt-1 text-[23px] leading-8.5 text-primary italic lg:text-[26px] lg:leading-9.5"
                    >
                        {SITE.slogan}
                    </p>
                    <div class="flex flex-wrap items-center gap-4 pt-4">
                        <a
                            href={NAV.enquire.href}
                            class="flex items-center justify-center bg-primary px-8 py-3.75 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-primary-dark"
                        >
                            Start Planning
                        </a>
                        <a
                            href="/safari-packages/"
                            class="text-[12px] underline-offset-4 hover:underline leading-4 font-medium tracking-[0.2em] text-primary uppercase"
                        >
                            See The Itineraries
                        </a>
                    </div>
                </div>

                <img
                    src="/images/family-walk-maasai-guide-1400.webp"
                    srcset={INTRO_SRCSET}
                    sizes={INTRO_SIZES}
                    alt="A grandfather and his granddaughter out on foot with their guide and two Maasai men, zebra grazing on the plain behind them"
                    width="1400"
                    height="1001"
                    fetchpriority="high"
                    decoding="async"
                    class="aspect-[3/2] w-full min-w-0 object-cover lg:w-1/2"
                />
            </div>
        </section>

        {/* The story, in the journal's measure rather than the card grid. */}
        <section class="gutter flex flex-col items-center bg-white pt-18 pb-18 lg:pt-24 lg:pb-24">
            <div class="shell flex flex-col items-center">
                <SectionHeading
                    eyebrow="Our Story"
                    heading="Crafted on the ground, not from a brochure"
                />
                <div class="prose mt-9 max-w-220 lg:mt-11">
                    <p>
                        Arusha is where every northern-circuit safari begins, and it is where we
                        have chosen to build ours. Being here means we know the circuit as it is
                        this week, not as it was described in last season's brochure: which gates
                        open earliest, how the crater roads are running, where the herds have moved
                        and which lodges are at their best. That knowledge shapes every itinerary
                        we write.
                    </p>
                    <p>
                        Our journeys are paced the way a safari ought to be travelled. Tarangire in
                        the soft early light. A full day on the crater floor rather than a hurried
                        morning. At least two nights in the central Serengeti, so there is time to
                        watch rather than simply pass through. Every element can be refined around
                        you, before you travel and on the day itself.
                    </p>
                    <p>
                        And every journey is private: your own expert guide, your own vehicle, your
                        own rhythm. It is the only way a guide can linger for two hours at a leopard
                        sighting because you wished to stay, and it is why our guests return, and
                        send the people closest to them.
                    </p>
                    <p>
                        We are proud members of the <strong
                            >Tanzania Association of Tour Operators</strong
                        >, featured on SafariBookings and rated {TRIPADVISOR.ratingValue} out of 5
                        on Tripadvisor, where guests so often name their guide personally. Of all
                        the recognition we receive, that is the one we value most.
                    </p>
                </div>
            </div>
        </section>

        {/* Three principles. Same card treatment as the destination grid. */}
        <section class="gutter flex flex-col items-center bg-cream pt-18 pb-18 lg:pt-24 lg:pb-26">
            <SectionHeading
                eyebrow="How We Work"
                heading="Our commitments to you"
                body="Three standards that define every journey we design, and that we hold to without exception."
            />
            <ul
                class="shell mt-10 grid grid-cols-1 gap-6.5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3"
            >
                {
                    PRINCIPLES.map((principle) => (
                        <li class="flex flex-col items-start gap-3.5 border-t-2 border-primary bg-white px-7 pt-8 pb-9">
                            <h3 class="font-display text-[27px] leading-9 text-ink">
                                {principle.heading}
                            </h3>
                            <p class="text-[15px] leading-6.75 text-muted">{principle.body}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        {/* #impact — the target of the homepage's "Learn More" button and of
            the footer's "Our positive impact". It is a commitment to schooling
            rather than a breakdown of where a quote goes. Wording and heading
            are ours; only the subject and the photograph follow the equivalent
            band on ~/web/atlas. */}
        <section id="impact" class="flex scroll-mt-8 flex-col bg-primary lg:flex-row">
            <div
                class="flex flex-col items-start justify-center gap-5.5 px-6 py-16 md:px-10 lg:w-1/2 lg:px-27.5 lg:py-20"
            >
                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-gold uppercase">
                    Beyond The Journey
                </p>
                <h2
                    class="font-display text-[36px] leading-[1.2] font-light tracking-[-0.008em] text-cream lg:text-[46px] lg:leading-14.5"
                >
                    What a safari can leave behind
                </h2>
                <p class="font-display text-[20px] leading-8 text-sage italic lg:text-[22px]">
                    Helping young Tanzanians take the next step, and the one after it
                </p>
                <div class="flex flex-col gap-4 pt-1">
                    {
                        IMPACT_PARAGRAPHS.map((paragraph) => (
                            <p class="text-[16px] leading-7.25 text-sage">{paragraph}</p>
                        ))
                    }
                </div>
                <p class="font-display pt-3 text-[26px] leading-9 text-gold lg:text-[28px]">
                    Leave something behind that keeps going.
                </p>
            </div>
            {/* Schoolchildren in the highlands. Copied into this app's
                public/images rather than referenced across repos, and renamed
                off the other site's programme name. */}
            <img
                src="/images/impact-schoolchildren.webp"
                alt="Schoolchildren in uniform sitting together on a grassy hillside, listening, with the highlands behind them"
                width="2400"
                height="1600"
                loading="lazy"
                decoding="async"
                class="h-75 w-full object-cover lg:h-auto lg:w-1/2 lg:self-stretch"
            />
        </section>
    </main>
    <Footer />
</Layout>
