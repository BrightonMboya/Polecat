---
/**
 * /zanzibar-travel-guide/ — the operator's Zanzibar guide. The copy, the
 * photographs and where each one came from are in src/content/zanzibar.ts;
 * the order of the sections is the one the operator's document recommends,
 * with "Combine Your Safari with Zanzibar" as the band that asks for the
 * enquiry. Linked from the footer, beside the Tanzania travel guide.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { CONTACT, whatsappLink } from '../config'
import {
    ZANZIBAR_ADVICE,
    ZANZIBAR_BEACHES,
    ZANZIBAR_BEYOND,
    ZANZIBAR_CLOSING,
    ZANZIBAR_COMBINE,
    ZANZIBAR_FAQS,
    ZANZIBAR_INTRO,
    ZANZIBAR_REASONS,
    ZANZIBAR_SEASONS,
    ZANZIBAR_TASTE,
    ZANZIBAR_THOUGHTFUL,
    type GuidePhoto,
} from '../content/zanzibar'

const intro = ZANZIBAR_INTRO

/* Every Commons photograph on the page, in the order it appears, for the
   credits line its licence asks for. */
const credited = [...ZANZIBAR_REASONS.map((r) => r.image), ...ZANZIBAR_BEYOND.items.map((i) => i.image)].filter(
    (image): image is GuidePhoto & { credit: NonNullable<GuidePhoto['credit']> } => !!image?.credit
)

const whatsapp = whatsappLink('Hello Polecat Safaris — I would like to plan a trip to Zanzibar.')

const pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: new URL('/zanzibar-travel-guide/', Astro.site).href,
    mainEntity: ZANZIBAR_FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
}

const CARD_SIZES = '(min-width: 1440px) 320px, (min-width: 1024px) 23vw, (min-width: 640px) 46vw, calc(100vw - 48px)'
const BEYOND_SIZES = '(min-width: 1440px) 428px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, calc(100vw - 48px)'
---

<Layout
    title="Zanzibar Travel Guide — Beaches, Stone Town & Safari Extensions | Polecat Safaris"
    description="Which Zanzibar beach suits you, what to do beyond the sand, the best months to go, how long to stay and how to pair the island with a Tanzania safari — the Polecat Safaris guide to Zanzibar."
    preloadImage={intro.image.src}
    pageSchema={pageSchema}
>
    <Header />
    <main>
        {/* Same banner as /travel-information/: the scrim is the background of
            the title block only, 0.64 under the type — enough over a pure
            white pixel, which this frame's sand has plenty of. */}
        <section class="relative flex h-100 w-full flex-col justify-end overflow-hidden bg-ink lg:h-150">
            <img
                src={intro.image.src}
                srcset={intro.image.srcset}
                sizes="100vw"
                alt={intro.image.alt}
                class="absolute inset-0 size-full object-cover"
                fetchpriority="high"
                decoding="async"
            />
            <div
                class="gutter relative flex w-full flex-col items-center pt-20 pb-12 lg:pb-14"
                style="background: linear-gradient(0deg, rgba(35,32,27,0.64) 0%, rgba(35,32,27,0.64) calc(100% - 5rem), rgba(35,32,27,0) 100%)"
            >
                <div class="shell flex max-w-215 flex-col items-center gap-4 text-center">
                    <h1 class="font-display text-[40px] leading-[1.1] font-light tracking-[-0.014em] text-white sm:text-[52px] lg:text-[66px] lg:leading-[1.05]">
                        {intro.heading}
                    </h1>
                    <p class="font-display text-[19px] leading-7.5 text-white italic lg:text-[22px] lg:leading-8.5">
                        {intro.standfirst}
                    </p>
                </div>
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-cream py-14 lg:py-20">
            <div class="shell flex max-w-200 flex-col items-center gap-5 text-center">
                <p class="font-display text-[26px] leading-9 font-light text-ink lg:text-[32px] lg:leading-11">{intro.lead}</p>
                {intro.paragraphs.map((p) => <p class="text-[16px] leading-7.5 text-muted">{p}</p>)}
            </div>
        </section>

        {/* The visual hook: eight places as image cards. */}
        <section class="gutter flex flex-col items-center bg-white py-18 lg:py-24">
            <SectionHeading eyebrow="The island" heading="8 Reasons to Fall in Love with Zanzibar" />
            <ol class="shell mt-10 grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
                {
                    ZANZIBAR_REASONS.map((reason) => (
                        <li class="flex flex-col">
                            <div class="overflow-hidden bg-line">
                                <img
                                    src={reason.image.src}
                                    srcset={reason.image.srcset}
                                    sizes={CARD_SIZES}
                                    alt={reason.image.alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="aspect-[3/2] w-full object-cover"
                                />
                            </div>
                            <p class="pt-5 text-[11px] leading-3.5 tracking-[0.16em] text-primary uppercase">
                                {reason.n} · {reason.theme}
                            </p>
                            <h3 class="font-display pt-2 text-[25px] leading-8 text-ink">{reason.place}</h3>
                            <p class="pt-2 text-[15px] leading-6.5 text-muted">{reason.body}</p>
                        </li>
                    ))
                }
            </ol>
        </section>

        <section class="gutter flex flex-col items-center bg-cream py-18 lg:py-24">
            <SectionHeading heading={ZANZIBAR_BEACHES.heading} body={ZANZIBAR_BEACHES.body} />
            <dl class="shell mt-10 grid max-w-250 grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:mt-12 lg:grid-cols-3">
                {
                    ZANZIBAR_BEACHES.items.map((beach) => (
                        <div class="flex flex-col gap-1.5 bg-white px-6 py-6">
                            <dt class="font-display text-[23px] leading-7.5 text-ink">{beach.place}</dt>
                            <dd class="text-[15px] leading-6.5 text-muted">{beach.note}</dd>
                        </div>
                    ))
                }
            </dl>
            <p class="shell mt-6 max-w-250 border-l-2 border-primary bg-white py-4 pr-5 pl-5 text-[15px] leading-6.5 text-ink">
                <span class="font-medium">A useful tip:</span> {ZANZIBAR_BEACHES.tip}
            </p>
        </section>

        <section class="gutter flex flex-col items-center bg-white py-18 lg:py-24">
            <SectionHeading heading={ZANZIBAR_BEYOND.heading} body={ZANZIBAR_BEYOND.body} />
            <ul class="shell mt-10 grid grid-cols-1 gap-x-6.5 gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3">
                {
                    ZANZIBAR_BEYOND.items.map((item) => (
                        <li class="flex flex-col">
                            {item.image && (
                                <div class="overflow-hidden bg-line">
                                    <img
                                        src={item.image.src}
                                        srcset={item.image.srcset}
                                        sizes={BEYOND_SIZES}
                                        alt={item.image.alt}
                                        loading="lazy"
                                        decoding="async"
                                        class="aspect-[3/2] w-full object-cover"
                                    />
                                </div>
                            )}
                            <h3 class="font-display pt-5 text-[25px] leading-8 text-ink">{item.title}</h3>
                            <p class="pt-2 text-[15px] leading-6.5 text-muted">{item.body}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        {/* The band that asks for the enquiry, as the operator's document
            recommends: the strongest image and the clearest way forward. */}
        <section class="flex flex-col bg-primary lg:flex-row">
            <div class="lg:w-1/2">
                <img
                    src={ZANZIBAR_COMBINE.image.src}
                    srcset={ZANZIBAR_COMBINE.image.srcset}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    alt={ZANZIBAR_COMBINE.image.alt}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[3/2] size-full object-cover lg:aspect-auto"
                />
            </div>
            <div class="gutter flex flex-col justify-center gap-5 py-16 lg:w-1/2 lg:py-24 lg:pr-20 lg:pl-16">
                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-gold uppercase">{ZANZIBAR_COMBINE.eyebrow}</p>
                <h2 class="font-display text-[32px] leading-10.5 font-light text-white lg:text-[42px] lg:leading-13">
                    {ZANZIBAR_COMBINE.heading}
                </h2>
                {ZANZIBAR_COMBINE.paragraphs.map((p) => <p class="text-[16px] leading-7.5 text-sage">{p}</p>)}
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[14px] leading-6 font-medium tracking-[0.06em] text-white">
                    {ZANZIBAR_COMBINE.route.map((stop, i) => (
                        <>
                            {i > 0 && <span class="text-gold" aria-hidden="true">→</span>}
                            <span>{stop}</span>
                        </>
                    ))}
                </p>
                <ul class="flex flex-col gap-2 pt-1">
                    {ZANZIBAR_COMBINE.combinations.map((c) => (
                        <li class="flex items-start gap-3 text-[15px] leading-6.5 text-sage">
                            <span class="mt-3 h-px w-3 shrink-0 bg-gold" aria-hidden="true" />
                            {c}
                        </li>
                    ))}
                </ul>
                <p class="text-[15px] leading-7 text-sage">{ZANZIBAR_COMBINE.closing}</p>
                <div class="flex flex-wrap gap-3 pt-2">
                    <a
                        href={ZANZIBAR_COMBINE.planHref}
                        class="bg-white px-7 py-4 text-[12px] leading-4 font-medium tracking-[0.18em] text-primary uppercase transition-colors hover:bg-cream"
                    >
                        Plan a Safari &amp; Zanzibar
                    </a>
                    <a
                        href={ZANZIBAR_COMBINE.itinerariesHref}
                        class="border border-white/60 px-7 py-4 text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-white/10"
                    >
                        See the itineraries
                    </a>
                </div>
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-cream py-18 lg:py-24">
            <SectionHeading heading={ZANZIBAR_SEASONS.heading} body={ZANZIBAR_SEASONS.body} />
            <table class="shell mt-10 max-w-200 border-collapse text-left lg:mt-12">
                <thead>
                    <tr class="border-b border-line">
                        <th scope="col" class="pb-3 text-[11px] leading-3.5 font-medium tracking-[0.2em] text-ink uppercase">Period</th>
                        <th scope="col" class="pb-3 text-[11px] leading-3.5 font-medium tracking-[0.2em] text-ink uppercase">What to expect</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        ZANZIBAR_SEASONS.rows.map((row) => (
                            <tr class="border-b border-line">
                                <th scope="row" class="w-2/5 py-4 pr-6 align-top text-[15px] leading-6.5 font-medium text-ink">
                                    {row.period}
                                </th>
                                <td class="py-4 text-[15px] leading-6.5 text-muted">{row.note}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
            <p class="shell mt-6 max-w-200 text-[15px] leading-7 text-muted">{ZANZIBAR_SEASONS.closing}</p>
        </section>

        <section class="gutter flex flex-col items-center bg-white py-18 lg:py-24">
            <div class="shell grid grid-cols-1 gap-x-16 gap-y-14 lg:grid-cols-2">
                {
                    ZANZIBAR_ADVICE.map((block) => (
                        <div class="flex flex-col">
                            <h2 class="font-display text-[28px] leading-9 font-light text-ink lg:text-[32px] lg:leading-10">
                                {block.heading}
                            </h2>
                            {'body' in block && <p class="pt-3 text-[15px] leading-7 text-muted">{block.body}</p>}
                            <dl class="flex flex-col pt-5">
                                {block.items.map(([label, text]) => (
                                    <div class="grid grid-cols-1 gap-1 border-t border-line py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
                                        <dt class="text-[14px] leading-6.5 font-medium text-ink">{label}</dt>
                                        <dd class="text-[15px] leading-6.5 text-muted">{text}</dd>
                                    </div>
                                ))}
                            </dl>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-cream py-18 lg:py-24">
            <div class="shell grid grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-2">
                {
                    [ZANZIBAR_TASTE, ZANZIBAR_THOUGHTFUL].map((block) => (
                        <div class="flex flex-col gap-4">
                            <h2 class="font-display text-[28px] leading-9 font-light text-ink lg:text-[32px] lg:leading-10">
                                {block.heading}
                            </h2>
                            {block.paragraphs.map((p) => <p class="text-[15px] leading-7 text-muted">{p}</p>)}
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-white py-18 lg:py-24">
            <SectionHeading heading="Frequently Asked Questions" />
            {/* Native <details>, as on /travel-information/. */}
            <div class="shell mt-10 flex max-w-215 flex-col lg:mt-12">
                {
                    ZANZIBAR_FAQS.map((faq) => (
                        <details class="group border-t border-line last:border-b">
                            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
                                <h3 class="font-display text-[21px] leading-7.5 font-light text-ink transition-colors group-hover:text-primary lg:text-[23px] lg:leading-8">
                                    {faq.question}
                                </h3>
                                <span class="relative mt-2.5 size-3.5 shrink-0 lg:mt-3" aria-hidden="true">
                                    <span class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-primary" />
                                    <span class="absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-primary transition-transform duration-200 group-open:scale-y-0" />
                                </span>
                            </summary>
                            <p class="pb-8 text-[15px] leading-7 text-muted lg:pr-12">{faq.answer}</p>
                        </details>
                    ))
                }
            </div>
        </section>

        <section class="gutter flex flex-col items-center bg-primary py-20 lg:py-26">
            <div class="shell flex max-w-200 flex-col items-center gap-5 text-center">
                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-gold uppercase">{ZANZIBAR_CLOSING.heading}</p>
                <p class="font-display text-[34px] leading-11 font-light text-white italic lg:text-[46px] lg:leading-14">
                    {ZANZIBAR_CLOSING.lines.map((line) => <span class="block">{line}</span>)}
                </p>
                <p class="text-[16px] leading-7.5 text-sage">{ZANZIBAR_CLOSING.body}</p>
                <h2 class="font-display pt-6 text-[26px] leading-9 font-light text-white lg:text-[30px]">{ZANZIBAR_CLOSING.ctaHeading}</h2>
                <p class="text-[15px] leading-7 text-sage">{ZANZIBAR_CLOSING.ctaBody}</p>
                <div class="flex flex-wrap justify-center gap-3 pt-3">
                    <a
                        href={ZANZIBAR_CLOSING.planHref}
                        class="bg-white px-8 py-4 text-[12px] leading-4 font-medium tracking-[0.18em] text-primary uppercase transition-colors hover:bg-cream"
                    >
                        Plan Your Zanzibar Escape
                    </a>
                    <a
                        href={whatsapp}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="border border-white/60 px-8 py-4 text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-white/10"
                    >
                        WhatsApp {CONTACT.phone}
                    </a>
                </div>
                <p class="font-display pt-4 text-[18px] leading-7 text-gold italic">{ZANZIBAR_CLOSING.signoff}</p>
            </div>
        </section>

        {
            credited.length > 0 && (
                <section class="gutter flex flex-col items-center bg-cream py-8">
                    <p class="shell text-[12px] leading-5 text-muted">
                        Photographs from Wikimedia Commons:{' '}
                        {credited.map((image, i) => (
                            <>
                                {i > 0 && '; '}
                                <a href={image.credit.pageUrl} class="underline underline-offset-2 hover:text-primary">
                                    {image.alt.split(',')[0]}
                                </a>{' '}
                                by {image.credit.author},{' '}
                                <a href={image.credit.licenceUrl} class="underline underline-offset-2 hover:text-primary">
                                    {image.credit.licence}
                                </a>
                            </>
                        ))}
                        . All other photographs are our own or our partners’.
                    </p>
                </section>
            )
        }
    </main>
    <Footer />
</Layout>
