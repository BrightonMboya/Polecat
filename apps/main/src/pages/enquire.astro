---
/**
 * /enquire/ — the destination of the header CTA, the hero's "Check
 * Availability" button and every "Enquire" link on the site.
 *
 * Same two-channel capture as the landing page's InquiryForm
 * (apps/marketing/polecat-lp): the fields are emailed through Web3Forms, and a
 * WhatsApp handoff sits beside the form for the many enquiries that arrive
 * that way. The difference is that this form does not *replace* itself with
 * WhatsApp — the main site's traffic is organic and slower, so the email is
 * the primary path and WhatsApp is offered rather than forced.
 *
 * No backend. The Web3Forms free tier is 250 submissions a month shared with
 * the landing page and the newsletter; move to a real inbox integration before
 * that matters.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { CONTACT, WEB3FORMS, SITE, whatsappLink } from '../config'
import { PACKAGES } from '../content/packages'

/*
 * One chronological month+year list rather than separate month and year
 * fields, which let a visitor submit a window that has already gone. Built at
 * build time and running to the end of the second calendar year ahead, so a
 * redeploy keeps it from drifting into the past. Same reasoning as the landing
 * page's version.
 */
const MONTHS = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
]
const now = new Date()
const travelWindows: { value: string; label: string }[] = []
for (let y = now.getFullYear(); y <= now.getFullYear() + 2; y++) {
    for (let m = y === now.getFullYear() ? now.getMonth() : 0; m < 12; m++) {
        travelWindows.push({
            value: `${MONTHS[m]} ${y}`,
            label: `${MONTHS[m]} ${y}`,
        })
    }
}

const whatsapp = whatsappLink(
    'Hello Polecat Safaris — I would like to plan a safari in Tanzania.'
)

/** What we need to know, and what we do with it. */
const ASSURANCES = [
    'A real person in Arusha reads every enquiry — usually the same day, always within one working day.',
    'You get a draft itinerary with named lodges and a firm per-person price, not a brochure.',
    'Nothing is booked and nothing is charged until you have said yes to a specific itinerary.',
]
---

<Layout
    title="Enquire — Plan a private Tanzania safari | Polecat Safaris"
    description="Tell us roughly when you want to travel and what you have in mind. You'll get a draft itinerary with named lodges and a firm price, written by the team in Arusha who would run it."
>
    <Header />
    <main>
        <section class="gutter flex flex-col items-center bg-cream pt-14 pb-18 lg:pt-20 lg:pb-24">
            <div
                class="shell flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between lg:gap-20"
            >
                {/* See about.astro: 50% + 50% + gap exceeds the shell, so both
                    columns have to be allowed to shrink. */}
                <div class="flex min-w-0 flex-col items-start gap-4 lg:w-1/2">
                    <p
                        class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase"
                    >
                        Enquire
                    </p>
                    <h1
                        class="font-display text-[36px] leading-[1.18] font-light text-ink lg:text-[50px] lg:leading-[1.12]"
                    >
                        Start planning your safari
                    </h1>
                    <p class="max-w-140 pt-2 text-[17px] leading-7.75 text-muted">
                        A rough month and a rough shape is enough. Every safari we run is private,
                        so nothing you tell us here is locked in — it is the starting point for an
                        itinerary we write around you.
                    </p>

                    <ul class="flex flex-col gap-4 pt-5">
                        {
                            ASSURANCES.map((line) => (
                                <li class="flex items-start gap-4">
                                    <span
                                        class="mt-3 h-px w-6 shrink-0 bg-primary"
                                        aria-hidden="true"
                                    />
                                    <p class="text-[15px] leading-7 text-muted">{line}</p>
                                </li>
                            ))
                        }
                    </ul>

                    <div
                        class="mt-6 flex w-full max-w-140 flex-col gap-3 border-t border-line pt-7"
                    >
                        <p
                            class="text-[11px] leading-3.5 font-medium tracking-[0.24em] text-ink uppercase"
                        >
                            Or reach us directly
                        </p>
                        <a
                            href={CONTACT.phoneHref}
                            class="text-[16px] leading-7 text-ink transition-colors hover:text-primary"
                            >{CONTACT.phone}</a
                        >
                        <a
                            href={`mailto:${CONTACT.email}`}
                            class="text-[16px] leading-7 text-primary hover:underline"
                            >{CONTACT.email}</a
                        >
                        <a
                            href={whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="rule-link mt-1 text-[12px] leading-4 font-medium tracking-[0.2em] text-primary uppercase"
                        >
                            Message Us On WhatsApp
                        </a>
                        <p class="pt-1 text-[13px] leading-5.5 text-muted">
                            {SITE.city} · East Africa Time (GMT+3)
                        </p>
                    </div>
                </div>

                {/* The form. `novalidate` so the messages below are ours rather
                    than the browser's, but every field keeps its real type so
                    mobile keyboards and autofill still behave. */}
                <div class="w-full min-w-0 bg-white px-6 py-9 sm:px-9 sm:py-11 lg:w-1/2">
                    <form id="enquiry-form" class="flex flex-col gap-6" novalidate>
                        {/* Honeypot — Web3Forms drops any submission where this
                            is filled, so the public key doesn't invite spam. */}
                        <input
                            type="checkbox"
                            name="botcheck"
                            class="hidden"
                            style="display:none"
                            tabindex="-1"
                            autocomplete="off"
                        />

                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                            <div class="flex flex-col gap-2">
                                <label
                                    for="enquiry-name"
                                    class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                    >Your name</label
                                >
                                <input
                                    id="enquiry-name"
                                    name="name"
                                    type="text"
                                    required
                                    autocomplete="name"
                                    class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                                />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label
                                    for="enquiry-email"
                                    class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                    >Email</label
                                >
                                <input
                                    id="enquiry-email"
                                    name="email"
                                    type="email"
                                    required
                                    autocomplete="email"
                                    class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                            <div class="flex flex-col gap-2">
                                <label
                                    for="enquiry-phone"
                                    class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                >
                                    Phone or WhatsApp
                                    <span class="font-normal tracking-normal text-muted normal-case"
                                        >(optional)</span
                                    >
                                </label>
                                <input
                                    id="enquiry-phone"
                                    name="phone"
                                    type="tel"
                                    inputmode="tel"
                                    autocomplete="tel"
                                    class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                                />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label
                                    for="enquiry-travellers"
                                    class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                    >Travellers</label
                                >
                                <input
                                    id="enquiry-travellers"
                                    name="travellers"
                                    type="number"
                                    min="1"
                                    max="24"
                                    value="2"
                                    class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                                />
                            </div>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label
                                for="enquiry-travel"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                >When would you travel</label
                            >
                            <select
                                id="enquiry-travel"
                                name="travel"
                                required
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            >
                                <option value="">Choose a month</option>
                                {
                                    travelWindows.map((window) => (
                                        <option value={window.value}>{window.label}</option>
                                    ))
                                }
                                {/* Kept as a real choice: someone without dates
                                    is still a lead, and forcing a month would
                                    invent one the team then quotes against. */}
                                <option value="Not decided yet">Not decided yet</option>
                            </select>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label
                                for="enquiry-itinerary"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                            >
                                Itinerary you have in mind
                                <span class="font-normal tracking-normal text-muted normal-case"
                                    >(optional)</span
                                >
                            </label>
                            {/* Sourced from packages.ts so this list can never
                                offer an itinerary the site no longer sells. */}
                            <select
                                id="enquiry-itinerary"
                                name="itinerary"
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            >
                                <option value="">Not sure yet — advise me</option>
                                {
                                    PACKAGES.map((pkg) => (
                                        <option value={pkg.name}>{pkg.name}</option>
                                    ))
                                }
                                <option value="Something else entirely"
                                    >Something else entirely</option
                                >
                            </select>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label
                                for="enquiry-message"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                            >
                                Anything else
                                <span class="font-normal tracking-normal text-muted normal-case"
                                    >(optional)</span
                                >
                            </label>
                            <textarea
                                id="enquiry-message"
                                name="message"
                                rows="4"
                                placeholder="Children and their ages, a budget, Zanzibar days on the end, dietary needs — whatever shapes the trip."
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-7 text-ink placeholder:text-[15px] placeholder:text-muted focus:border-primary focus:outline-none"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="mt-1 flex cursor-pointer items-center justify-center bg-primary px-9 py-4.25 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-[#083329] disabled:cursor-wait disabled:opacity-70"
                        >
                            Send Enquiry
                        </button>

                        <p class="text-[12px] leading-5 text-muted">
                            We use your details to answer this enquiry and nothing else — see our
                            <a
                                href="/privacy-policy/"
                                class="text-primary underline underline-offset-2">privacy policy</a
                            >.
                        </p>

                        {/* Announced rather than focus-moved, so a screen reader
                            hears the outcome where the user already is. */}
                        <p
                            data-enquiry-status
                            role="status"
                            aria-live="polite"
                            class="hidden text-[14px] leading-6"
                        >
                        </p>
                    </form>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script
    define:vars={{
        endpoint: WEB3FORMS.endpoint,
        accessKey: WEB3FORMS.accessKey,
        subject: WEB3FORMS.enquirySubject,
        whatsapp,
        email: CONTACT.email,
    }}
>
    const form = document.getElementById('enquiry-form')
    const status = form?.querySelector('[data-enquiry-status]')
    const button = form?.querySelector('button[type="submit"]')

    function show(message, ok) {
        if (!status) return
        status.innerHTML = message
        status.classList.remove('hidden')
        status.style.color = ok ? 'var(--color-primary)' : '#A8371E'
    }

    const field = (name) => form?.elements.namedItem(name)

    form?.addEventListener('submit', async (event) => {
        event.preventDefault()

        // Validated by hand so the message reads like the rest of the page and
        // so the first bad field is the one that gets focus.
        for (const name of ['name', 'email', 'travel']) {
            const input = field(name)
            if (input && !input.checkValidity()) {
                show('Please fill in your name, a valid email address and a month.', false)
                input.focus()
                return
            }
        }

        if (button) button.disabled = true

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({
                    access_key: accessKey,
                    subject,
                    from_name: 'Polecat Safaris — main site',
                    replyto: field('email')?.value,
                    botcheck: field('botcheck')?.checked ?? false,
                    Name: field('name')?.value,
                    Email: field('email')?.value,
                    Phone: field('phone')?.value || '—',
                    Travellers: field('travellers')?.value || '—',
                    'Travel window': field('travel')?.value,
                    Itinerary: field('itinerary')?.value || 'Not specified',
                    Message: field('message')?.value || '—',
                    // The full URL, so any utm_* the visit carried survives
                    // into the inbox alongside the fields.
                    'Page URL': window.location.href,
                }),
            })
            if (!response.ok) throw new Error(String(response.status))
            form.reset()
            show(
                'Thank you — your enquiry is with the team in Arusha. You’ll hear back within one working day.',
                true
            )
        } catch {
            // Nothing else captures this enquiry, so the visitor has to be told
            // it failed and handed a channel that works.
            show(
                `That didn’t go through. Please email <a href="mailto:${email}" style="color:inherit;text-decoration:underline">${email}</a> or <a href="${whatsapp}" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:underline">message us on WhatsApp</a> instead.`,
                false
            )
        } finally {
            if (button) button.disabled = false
        }
    })
</script>
