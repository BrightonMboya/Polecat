---
/**
 * /enquire/ — the destination of the header CTA, the hero's "Check
 * Availability" button and every "Enquire" link on the site.
 *
 * The five-step card from serengetiwakandatours.com/plan, on its own — no
 * photographic banner and no side column. The steps are trip type, dates and
 * length, guests, budget and interests, and contact. Restyled to this site's
 * tokens.
 *
 * Kept from the planner it replaces:
 *   - ?itinerary=<slug> from an itinerary page names the journey above the
 *     card, presets the trip type and length, and reaches the inbox.
 *   - ?plan=<slug> from the homepage travel-style cards presets the answers
 *     the card's title already gives (TRAVEL_STYLES[].preset).
 *   - the answers POST to Web3Forms as labelled fields, and on failure the
 *     visitor is handed email and WhatsApp instead.
 *
 * No backend. The Web3Forms free tier is 250 submissions a month shared with
 * the landing page and the newsletter; move to a real inbox integration
 * before that matters.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { CONTACT, WEB3FORMS, whatsappLink } from '../config'
import { PACKAGES } from '../content/packages'
import { TRAVEL_STYLES } from '../content/home'

const TRIP_TYPES = [
    { value: 'safari', label: 'Safari', hint: 'Serengeti, Ngorongoro & Tarangire' },
    { value: 'kilimanjaro', label: 'Kilimanjaro', hint: 'Marangu, Machame, Lemosho & more' },
    { value: 'zanzibar', label: 'Zanzibar', hint: 'Beach days & Stone Town' },
    { value: 'combination', label: 'Combination', hint: 'Safari with the beach or the mountain' },
]

/* Up to US$ 3k covers the treks and the shortest safaris; the catalogue's
   safaris run from about US$ 3k to 6.3k pp. */
const BUDGETS = [
    { value: 'under-3k', label: 'Under $3k pp' },
    { value: '3k-5k', label: '$3k–5k pp' },
    { value: '5k-8k', label: '$5k–8k pp' },
    { value: '8k-plus', label: '$8k+ pp' },
    { value: 'not-sure', label: 'Not sure yet' },
]

/* Only things an itinerary on this site can deliver. */
const INTERESTS = [
    { value: 'wildlife', label: 'Wildlife & Big Five' },
    { value: 'migration', label: 'Great Migration' },
    { value: 'honeymoon', label: 'Honeymoon' },
    { value: 'family', label: 'Family with kids' },
    { value: 'photography', label: 'Photography' },
    { value: 'culture', label: 'Cultural visits' },
    { value: 'walking', label: 'Walking safaris' },
    { value: 'fly-in', label: 'Fly-in safaris' },
]

const STEP_COUNT = 5

// Never offer a date in the past.
const minDate = new Date().toISOString().slice(0, 10)

const optionLabels: Record<string, string> = {}
for (const [step, options] of [
    ['trip', TRIP_TYPES],
    ['budget', BUDGETS],
    ['interests', INTERESTS],
] as const) {
    for (const option of options) optionLabels[`${step}:${option.value}`] = option.label
}

/* Presets from the homepage cards, checked at build time so a renamed option
   is an error rather than a chip that quietly stops lighting up. */
const presetOptions: Record<string, readonly { value: string }[]> = {
    trip: TRIP_TYPES,
    interests: INTERESTS,
}
const plans = Object.fromEntries(
    TRAVEL_STYLES.items.map((style) => {
        for (const [stepId, values] of Object.entries(style.preset ?? {})) {
            for (const value of values ?? []) {
                if (!presetOptions[stepId]?.some((option) => option.value === value)) {
                    throw new Error(
                        `TRAVEL_STYLES "${style.slug}" presets "${stepId}: ${value}", which /enquire/ does not offer.`
                    )
                }
            }
        }
        return [style.slug, { label: style.title, answers: style.preset ?? {} }]
    })
)

/* The trip type an itinerary implies: a climb is Kilimanjaro, a safari with
   Zanzibar days on the end is a combination. */
const tripFor = (routes: readonly string[]) =>
    routes.includes('trekking')
        ? 'kilimanjaro'
        : routes.includes('zanzibar')
          ? routes.includes('northern-circuit')
              ? 'combination'
              : 'zanzibar'
          : 'safari'

const itineraries = Object.fromEntries(
    PACKAGES.map((pkg) => {
        const path = `/safari-packages/${pkg.slug}/`
        return [
            pkg.slug,
            {
                name: pkg.name,
                days: pkg.days,
                trip: tripFor(pkg.routes),
                path,
                url: new URL(path, Astro.site).href,
            },
        ]
    })
)

/*
 * Dial codes for the phone field — the markets guests actually come from,
 * plus East Africa. No phone library: npm is unreachable from this repo's
 * machine, and a dial code plus a number is all the inbox needs.
 */
const DIAL_CODES = [
    ['GB', 'United Kingdom', '44'],
    ['US', 'United States', '1'],
    ['CA', 'Canada', '1'],
    ['FR', 'France', '33'],
    ['DE', 'Germany', '49'],
    ['NL', 'Netherlands', '31'],
    ['BE', 'Belgium', '32'],
    ['CH', 'Switzerland', '41'],
    ['AT', 'Austria', '43'],
    ['IT', 'Italy', '39'],
    ['ES', 'Spain', '34'],
    ['PT', 'Portugal', '351'],
    ['IE', 'Ireland', '353'],
    ['SE', 'Sweden', '46'],
    ['NO', 'Norway', '47'],
    ['DK', 'Denmark', '45'],
    ['FI', 'Finland', '358'],
    ['PL', 'Poland', '48'],
    ['CZ', 'Czechia', '420'],
    ['AU', 'Australia', '61'],
    ['NZ', 'New Zealand', '64'],
    ['ZA', 'South Africa', '27'],
    ['TZ', 'Tanzania', '255'],
    ['KE', 'Kenya', '254'],
    ['UG', 'Uganda', '256'],
    ['RW', 'Rwanda', '250'],
    ['NG', 'Nigeria', '234'],
    ['AE', 'United Arab Emirates', '971'],
    ['SA', 'Saudi Arabia', '966'],
    ['IL', 'Israel', '972'],
    ['IN', 'India', '91'],
    ['CN', 'China', '86'],
    ['HK', 'Hong Kong', '852'],
    ['SG', 'Singapore', '65'],
    ['JP', 'Japan', '81'],
    ['KR', 'South Korea', '82'],
    ['BR', 'Brazil', '55'],
    ['MX', 'Mexico', '52'],
    ['AR', 'Argentina', '54'],
] as const

const flag = (iso: string) =>
    String.fromCodePoint(...[...iso].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65))

const whatsapp = whatsappLink(
    'Hello Polecat Safaris — I would like to plan a safari in Tanzania.'
)

const label = 'text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase'
const input =
    'w-full border border-line bg-white px-4 py-3.5 text-[16px] leading-6 text-ink placeholder:text-muted/60 transition-colors focus:border-primary focus:outline-none'
---

<Layout
    title="Enquire — Plan a private Tanzania safari | Polecat Safaris"
    description="Five short questions about the trip you have in mind. A guide in Arusha replies personally within one working day with a draft itinerary, named lodges and a firm price."
>
    <Header />
    <main data-planner>
        <section class="gutter flex flex-col items-center bg-cream pt-12 pb-16 lg:pt-18 lg:pb-22">
            <h1 class="sr-only">Plan your Tanzania safari</h1>
            <div class="w-full max-w-190">
                <div class="border border-line bg-white p-6 sm:p-10">
                    {/* Filled in by the script when the visitor came from an
                        itinerary page. */}
                    <p
                        class="mb-6 hidden border-l-2 border-primary bg-cream py-3 pr-4 pl-4 text-[14px] leading-6 text-muted"
                        data-source
                    >
                        Enquiring about <a
                            data-source-link
                            class="text-ink underline underline-offset-4 hover:text-primary"
                            href="/safari-packages/"></a>
                    </p>

                    <div data-progress>
                        <div
                            class="flex items-baseline justify-between text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                        >
                            <span>Step <span data-step-num>1</span> of {STEP_COUNT}</span>
                            <span class="text-muted" data-step-pct>20%</span>
                        </div>
                        <div class="mt-3 grid grid-cols-5 gap-1.5" aria-hidden="true">
                            {
                                Array.from({ length: STEP_COUNT }, (_, i) => (
                                    <span
                                        class="h-0.5 bg-line transition-colors data-[done]:bg-primary"
                                        data-segment={i}
                                    />
                                ))
                            }
                        </div>
                    </div>

                    <form id="enquiry-form" class="mt-8" novalidate>
                        {/* Honeypot — Web3Forms drops any submission where
                            this is filled. */}
                        <input
                            type="checkbox"
                            name="botcheck"
                            class="hidden"
                            style="display:none"
                            tabindex="-1"
                            autocomplete="off"
                        />

                        {/* 1. Trip type */}
                        <fieldset data-step="0" class="flex flex-col">
                            <legend class="font-display text-[28px] leading-9 text-ink lg:text-[32px]">
                                What kind of trip?
                            </legend>
                            <p class="pt-1 text-[15px] leading-6 text-muted">
                                Pick the journey closest to the one you have in mind.
                            </p>
                            <div class="grid grid-cols-1 gap-3.5 pt-7 sm:grid-cols-2">
                                {
                                    TRIP_TYPES.map((trip) => (
                                        <button
                                            type="button"
                                            class="flex cursor-pointer flex-col items-start gap-1 border border-line px-5 py-5 text-left transition-colors hover:border-primary data-[selected]:border-primary data-[selected]:bg-primary/5"
                                            data-option="trip"
                                            data-value={trip.value}
                                            aria-pressed="false"
                                        >
                                            <span class="text-[17px] leading-6 font-medium text-ink">
                                                {trip.label}
                                            </span>
                                            <span class="text-[13px] leading-5 text-muted">
                                                {trip.hint}
                                            </span>
                                        </button>
                                    ))
                                }
                            </div>
                        </fieldset>

                        {/* 2. When */}
                        <fieldset data-step="1" class="hidden flex-col">
                            <legend class="font-display text-[28px] leading-9 text-ink lg:text-[32px]">
                                When are you travelling?
                            </legend>
                            <p class="pt-1 text-[15px] leading-6 text-muted">
                                An approximate date is fine — we can move it later.
                            </p>
                            <div class="flex flex-col gap-2 pt-7">
                                <label for="enquiry-arrival" class={label}>Arrival date *</label>
                                <div class="relative">
                                    <input
                                        id="enquiry-arrival"
                                        name="arrival"
                                        type="date"
                                        min={minDate}
                                        class:list={[input, 'planner-date pr-12']}
                                    />
                                    <svg
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-primary"
                                        aria-hidden="true"
                                    >
                                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                        <path d="M8 3v4M16 3v4M3 10h18"></path>
                                    </svg>
                                </div>
                                <p class="min-h-5 text-[14px] leading-5 text-primary" data-arrival-pretty></p>
                                <label class="flex cursor-pointer items-center gap-2.5 text-[14px] leading-5 text-muted">
                                    <input
                                        type="checkbox"
                                        name="undecided"
                                        class="size-4 cursor-pointer accent-[var(--color-primary)]"
                                    />
                                    I haven't decided on dates yet
                                </label>
                            </div>
                            <div class="flex flex-col gap-2 pt-6 sm:max-w-1/2">
                                <label for="enquiry-days" class={label}>Number of days</label>
                                <input
                                    id="enquiry-days"
                                    name="days"
                                    type="number"
                                    inputmode="numeric"
                                    min="1"
                                    max="60"
                                    placeholder="e.g. 8"
                                    class={input}
                                />
                            </div>
                        </fieldset>

                        {/* 3. Guests */}
                        <fieldset data-step="2" class="hidden flex-col">
                            <legend class="font-display text-[28px] leading-9 text-ink lg:text-[32px]">
                                How many guests?
                            </legend>
                            <p class="pt-1 text-[15px] leading-6 text-muted">
                                Every trip is private, whatever the size of the group.
                            </p>
                            <div class="grid grid-cols-1 gap-5 pt-7 sm:grid-cols-2">
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-adults" class={label}>Adults *</label>
                                    <input
                                        id="enquiry-adults"
                                        name="adults"
                                        type="number"
                                        inputmode="numeric"
                                        min="1"
                                        max="40"
                                        value="2"
                                        required
                                        class={input}
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-children" class={label}>Children</label>
                                    <input
                                        id="enquiry-children"
                                        name="children"
                                        type="number"
                                        inputmode="numeric"
                                        min="0"
                                        max="40"
                                        value="0"
                                        class={input}
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-ages" class={label}>Children's ages</label>
                                    <input
                                        id="enquiry-ages"
                                        name="ages"
                                        type="text"
                                        placeholder="e.g. 5, 8, 12"
                                        class={input}
                                    />
                                </div>
                            </div>
                        </fieldset>

                        {/* 4. Budget and interests */}
                        <fieldset data-step="3" class="hidden flex-col">
                            <legend class="font-display text-[28px] leading-9 text-ink lg:text-[32px]">
                                What's your budget?
                            </legend>
                            <p class="pt-1 text-[15px] leading-6 text-muted">
                                It helps us shape a proposal that fits.
                            </p>
                            <p class:list={[label, 'pt-7']}>Budget per person *</p>
                            <div class="grid grid-cols-1 gap-3 pt-3 sm:grid-cols-2">
                                {
                                    BUDGETS.map((budget) => (
                                        <button
                                            type="button"
                                            class="cursor-pointer border border-line px-4 py-3.5 text-center text-[15px] leading-6 text-ink transition-colors hover:border-primary data-[selected]:border-primary data-[selected]:bg-primary data-[selected]:text-white"
                                            data-option="budget"
                                            data-value={budget.value}
                                            aria-pressed="false"
                                        >
                                            {budget.label}
                                        </button>
                                    ))
                                }
                            </div>
                            <p class:list={[label, 'pt-7']}>Interests (optional)</p>
                            <div class="flex flex-wrap gap-2.5 pt-3">
                                {
                                    INTERESTS.map((interest) => (
                                        <button
                                            type="button"
                                            class="cursor-pointer rounded-full border border-line px-4 py-2 text-[13px] leading-5 text-ink transition-colors hover:border-primary data-[selected]:border-primary data-[selected]:bg-primary data-[selected]:text-white"
                                            data-option="interests"
                                            data-multi
                                            data-value={interest.value}
                                            aria-pressed="false"
                                        >
                                            {interest.label}
                                        </button>
                                    ))
                                }
                            </div>
                        </fieldset>

                        {/* 5. Contact */}
                        <fieldset data-step="4" class="hidden flex-col">
                            <legend class="font-display text-[28px] leading-9 text-ink lg:text-[32px]">
                                Almost done
                            </legend>
                            <p class="pt-1 text-[15px] leading-6 text-muted">
                                A guide in Arusha will reply personally within one working day.
                            </p>
                            <div class="flex flex-col gap-5 pt-7">
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-name" class={label}>Your name *</label>
                                    <input
                                        id="enquiry-name"
                                        name="name"
                                        type="text"
                                        required
                                        autocomplete="name"
                                        class={input}
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-email" class={label}>Email *</label>
                                    <input
                                        id="enquiry-email"
                                        name="email"
                                        type="email"
                                        required
                                        autocomplete="email"
                                        class={input}
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-phone" class={label}>Phone / WhatsApp *</label>
                                    <div
                                        class="flex border border-line bg-white transition-colors focus-within:border-primary"
                                    >
                                        {/* The select sits invisibly over a
                                            flag-and-code label, so the closed
                                            state stays narrow while the list
                                            still names every country. */}
                                        <label class="relative flex shrink-0 items-center border-r border-line py-3.5 pr-8 pl-4">
                                            <span class="sr-only">Country dialling code</span>
                                            <span class="text-[16px] leading-6 whitespace-nowrap text-ink" aria-hidden="true" data-dial-display></span>
                                            <select
                                                name="dial"
                                                class="absolute inset-0 cursor-pointer opacity-0"
                                                data-dial
                                            >
                                                {
                                                    DIAL_CODES.map(([iso, country, code]) => (
                                                        <option value={iso} data-code={code}>
                                                            {flag(iso)} {country} +{code}
                                                        </option>
                                                    ))
                                                }
                                            </select>
                                            <svg
                                                width="10"
                                                height="6"
                                                viewBox="0 0 10 6"
                                                fill="none"
                                                class="pointer-events-none absolute right-3 text-muted"
                                                aria-hidden="true"
                                            >
                                                <path
                                                    d="M1 1l4 4 4-4"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                />
                                            </svg>
                                        </label>
                                        <input
                                            id="enquiry-phone"
                                            name="phone"
                                            type="tel"
                                            inputmode="tel"
                                            autocomplete="tel-national"
                                            required
                                            class="min-w-0 flex-1 bg-transparent px-4 py-3.5 text-[16px] leading-6 text-ink focus:outline-none"
                                        />
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-country" class={label}>Country</label>
                                    <input
                                        id="enquiry-country"
                                        name="country"
                                        type="text"
                                        autocomplete="country-name"
                                        placeholder="e.g. United Kingdom"
                                        class={input}
                                    />
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label for="enquiry-message" class={label}>Anything else?</label>
                                    <textarea
                                        id="enquiry-message"
                                        name="message"
                                        rows="3"
                                        placeholder="Special occasions, must-sees, dietary needs…"
                                        class={input}></textarea>
                                </div>
                            </div>
                        </fieldset>

                        <p
                            data-enquiry-status
                            role="status"
                            aria-live="polite"
                            class="mt-6 hidden text-[14px] leading-6"
                        >
                        </p>

                        <div class="mt-9 flex flex-wrap items-center justify-between gap-3">
                            <button
                                type="button"
                                class="flex cursor-pointer items-center gap-2 py-3 text-[14px] leading-5 text-ink transition-colors hover:text-primary disabled:cursor-default disabled:opacity-35"
                                data-back
                                disabled
                            >
                                <span aria-hidden="true">‹</span> Back
                            </button>
                            <div class="flex flex-wrap items-center gap-3">
                                <button
                                    type="button"
                                    class="hidden cursor-pointer items-center gap-2 border border-[#25D366] px-5 py-3.5 text-[13px] leading-4 font-medium tracking-[0.06em] text-[#128C4B] transition-colors hover:bg-[#25D366]/10"
                                    data-whatsapp
                                >
                                    <svg
                                        width="16"
                                        height="16"
                                        viewBox="0 0 18 18"
                                        fill="none"
                                        stroke="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M5.18 13.37A6.1 6.1 0 103.21 10.28L1.31 13.2Z"
                                            stroke-width="1.2"
                                            stroke-linejoin="round"></path>
                                        <path
                                            d="M7.4 7.1c-.5.8.1 2 1 2.9.9.9 2.1 1.5 2.9 1"
                                            stroke-width="1.5"
                                            stroke-linecap="round"></path>
                                    </svg>
                                    Send via WhatsApp
                                </button>
                                <button
                                    type="button"
                                    class="flex cursor-pointer items-center gap-2 bg-primary px-7 py-3.75 text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-primary-dark disabled:cursor-not-allowed disabled:opacity-35"
                                    data-next
                                    disabled
                                >
                                    Continue <span aria-hidden="true">›</span>
                                </button>
                                <button
                                    type="submit"
                                    class="hidden cursor-pointer items-center bg-primary px-7 py-3.75 text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-primary-dark disabled:cursor-wait disabled:opacity-70"
                                    data-submit
                                >
                                    Send Enquiry
                                </button>
                            </div>
                        </div>

                        <p class="mt-6 hidden text-[12px] leading-5 text-muted" data-fineprint>
                            Nothing is booked and nothing is charged until you have said yes to an
                            itinerary. We use your details to answer this enquiry and nothing else.
                        </p>
                    </form>

                    {/* Thank you, in place of the form. */}
                    <div class="hidden flex-col items-start" data-thanks>
                        <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase">
                            Enquiry received
                        </p>
                        <h2
                            class="font-display pt-4 text-[30px] leading-[1.15] font-light text-ink lg:text-[38px]"
                            data-thanks-title
                        >
                            Thank you — it's on its way to us.
                        </h2>
                        <p class="pt-4 text-[16px] leading-7.5 text-muted">
                            A guide in Arusha will read what you've shared and reply personally,
                            usually the same day and always within one working day.
                        </p>
                        <a
                            href="/"
                            class="mt-8 flex items-center justify-center bg-primary px-8 py-4 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-primary-dark"
                        >
                            Back To Home
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script
    define:vars={{
        endpoint: WEB3FORMS.endpoint,
        accessKey: WEB3FORMS.accessKey,
        subject: WEB3FORMS.enquirySubject,
        optionLabels,
        whatsapp,
        whatsappNumber: CONTACT.whatsappNumber,
        email: CONTACT.email,
        plans,
        itineraries,
        total: STEP_COUNT,
    }}
>
    const root = document.querySelector('[data-planner]')
    const form = document.getElementById('enquiry-form')
    if (root && form) {
        const steps = [...form.querySelectorAll('[data-step]')]
        const back = form.querySelector('[data-back]')
        const next = form.querySelector('[data-next]')
        const submit = form.querySelector('[data-submit]')
        const wa = form.querySelector('[data-whatsapp]')
        const fineprint = form.querySelector('[data-fineprint]')
        const status = form.querySelector('[data-enquiry-status]')
        const progress = root.querySelector('[data-progress]')
        const thanks = root.querySelector('[data-thanks]')
        const field = (name) => form.elements.namedItem(name)

        const answers = { trip: [], budget: [], interests: [] }
        let index = 0
        let intent = null
        let source = null

        const labelsFor = (step) => answers[step].map((v) => optionLabels[`${step}:${v}`] ?? v)

        function paintOptions(step) {
            form.querySelectorAll(`[data-option="${step}"]`).forEach((b) => {
                const on = answers[step].includes(b.dataset.value)
                b.toggleAttribute('data-selected', on)
                b.setAttribute('aria-pressed', on ? 'true' : 'false')
            })
        }

        /* Whether the current step has what it needs to move on. */
        function complete(i) {
            if (i === 0) return answers.trip.length > 0
            if (i === 1) return field('arrival').value !== '' || field('undecided').checked
            if (i === 2) return Number(field('adults').value) >= 1
            if (i === 3) return answers.budget.length > 0
            return true
        }

        function sync() {
            next.disabled = !complete(index)
        }

        function show(i) {
            index = i
            steps.forEach((s, n) => {
                s.classList.toggle('hidden', n !== i)
                s.classList.toggle('flex', n === i)
            })
            const last = i === total - 1
            back.disabled = i === 0
            next.classList.toggle('hidden', last)
            next.classList.toggle('flex', !last)
            submit.classList.toggle('hidden', !last)
            submit.classList.toggle('flex', last)
            wa.classList.toggle('hidden', !last)
            wa.classList.toggle('flex', last)
            fineprint.classList.toggle('hidden', !last)
            status.classList.add('hidden')

            const pct = Math.round(((i + 1) / total) * 100)
            progress.querySelector('[data-step-num]').textContent = String(i + 1)
            progress.querySelector('[data-step-pct]').textContent = `${pct}%`
            progress.querySelectorAll('[data-segment]').forEach((seg) => {
                seg.toggleAttribute('data-done', Number(seg.dataset.segment) <= i)
            })
            sync()
        }

        form.querySelectorAll('[data-option]').forEach((b) =>
            b.addEventListener('click', () => {
                const step = b.dataset.option
                const value = b.dataset.value
                if (b.hasAttribute('data-multi')) {
                    const set = new Set(answers[step])
                    set.has(value) ? set.delete(value) : set.add(value)
                    answers[step] = [...set]
                } else {
                    answers[step] = [value]
                }
                paintOptions(step)
                sync()
            })
        )
        form.addEventListener('input', sync)

        next.addEventListener('click', () => {
            if (!complete(index)) return
            show(index + 1)
            root.querySelector('[data-progress]')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
        })
        back.addEventListener('click', () => index > 0 && show(index - 1))

        /* Enter in a text field moves on rather than submitting early. */
        form.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' || event.target.tagName === 'TEXTAREA') return
            if (index < total - 1) {
                event.preventDefault()
                next.click()
            }
        })

        /* Dial code: the visitor's own region where we list it, else the UK. */
        const dial = field('dial')
        const region = (navigator.language.split('-')[1] ?? '').toUpperCase()
        dial.value = [...dial.options].some((o) => o.value === region) ? region : 'GB'
        const dialCode = () => dial.selectedOptions[0]?.dataset.code ?? ''
        const dialDisplay = root.querySelector('[data-dial-display]')
        const paintDial = () => {
            const flag = (dial.selectedOptions[0]?.textContent ?? '').trim().split(' ')[0]
            dialDisplay.textContent = `${flag}\u00a0 +${dialCode()}`
        }
        dial.addEventListener('change', paintDial)
        paintDial()
        const fullPhone = () => {
            const national = field('phone').value.trim().replace(/^0+/, '')
            return national ? `+${dialCode()} ${national}` : ''
        }

        /* Presets from the query string. */
        const params = new URLSearchParams(location.search)
        const plan = plans[params.get('plan') ?? '']
        if (plan) {
            intent = plan.label
            for (const [step, values] of Object.entries(plan.answers)) {
                answers[step] = [...values]
                paintOptions(step)
            }
        }
        const itinerary = itineraries[params.get('itinerary') ?? '']
        if (itinerary) {
            source = itinerary
            intent = intent ?? itinerary.name
            answers.trip = [itinerary.trip]
            paintOptions('trip')
            field('days').value = String(itinerary.days)
            const strip = root.querySelector('[data-source]')
            const link = strip.querySelector('[data-source-link]')
            link.textContent = itinerary.name
            link.href = itinerary.path
            strip.classList.remove('hidden')
        }

        /** "Saturday, 12 June 2027", or "" if the value isn't a real date. */
        function longDate(iso) {
            if (!iso) return ''
            const when = new Date(`${iso}T00:00:00`)
            if (Number.isNaN(when.getTime())) return ''
            return when.toLocaleDateString('en-GB', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
                year: 'numeric',
            })
        }

        /** The last day away, counting the arrival day as day one. */
        function lastDay() {
            const iso = field('arrival').value
            const days = Number(field('days').value)
            if (field('undecided').checked || !iso || !(days >= 1)) return ''
            const end = new Date(`${iso}T00:00:00`)
            end.setDate(end.getDate() + days - 1)
            // Local parts, not toISOString(), which east of UTC gives the day before.
            const pad = (n) => String(n).padStart(2, '0')
            return longDate(`${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}`)
        }

        /* Spell the date out under the picker, with the last day once the
           length is known. Choosing a date unticks "not decided", and ticking
           it clears the date. */
        const arrivalPretty = root.querySelector('[data-arrival-pretty]')
        function paintArrival() {
            const arriving = field('undecided').checked ? '' : longDate(field('arrival').value)
            const end = lastDay()
            arrivalPretty.textContent = arriving
                ? end
                    ? `${arriving} — last day ${end}`
                    : arriving
                : ''
        }
        field('arrival').addEventListener('change', () => {
            if (field('arrival').value) field('undecided').checked = false
            paintArrival()
            sync()
        })
        field('undecided').addEventListener('change', () => {
            if (field('undecided').checked) field('arrival').value = ''
            paintArrival()
            sync()
        })
        field('days').addEventListener('input', paintArrival)

        function brief() {
            const adults = field('adults').value || '—'
            const children = Number(field('children').value) || 0
            const ages = field('ages').value.trim()
            return {
                'Trip type': labelsFor('trip')[0] ?? '—',
                'Arrival date': field('undecided').checked
                    ? 'Not decided yet'
                    : longDate(field('arrival').value) || '—',
                'Last day': lastDay() || '—',
                'Number of days': field('days').value || '—',
                Adults: adults,
                Children: children ? `${children}${ages ? ` (ages ${ages})` : ''}` : '0',
                'Budget per person': labelsFor('budget')[0] ?? '—',
                Interests: labelsFor('interests').join(', ') || '—',
                'Interested in': intent ?? '—',
            }
        }

        function showStatus(message, ok) {
            status.innerHTML = message
            status.classList.remove('hidden')
            status.style.color = ok ? 'var(--color-primary)' : '#A8371E'
        }

        function validContact(requireAll) {
            const names = requireAll ? ['name', 'email', 'phone'] : ['name']
            for (const name of names) {
                const el = field(name)
                if (!el.checkValidity() || !el.value.trim()) {
                    showStatus(
                        requireAll
                            ? 'Please add your name, a valid email and a phone number so we can reply.'
                            : 'Please add your name first.',
                        false
                    )
                    el.focus()
                    return false
                }
            }
            return true
        }

        /* WhatsApp: the same brief as a message, sent from the visitor's own
           phone — nothing is posted from here. */
        wa.addEventListener('click', () => {
            if (!validContact(false)) return
            const lines = Object.entries(brief())
                .filter(([, v]) => v && v !== '—')
                .map(([k, v]) => `${k}: ${v}`)
            const extra = field('message').value.trim()
            const text = [
                `Hello Polecat Safaris — I'm ${field('name').value.trim()} and I'd like to plan a trip.`,
                '',
                ...lines,
                ...(source ? [`Itinerary: ${source.url}`] : []),
                ...(extra ? ['', extra] : []),
            ].join('\n')
            window.open(
                `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`,
                '_blank',
                'noopener'
            )
        })

        form.addEventListener('submit', async (event) => {
            event.preventDefault()
            if (index !== total - 1 || !validContact(true)) return

            submit.disabled = true
            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({
                        access_key: accessKey,
                        subject,
                        from_name: 'Polecat Safaris — main site',
                        replyto: field('email').value,
                        botcheck: field('botcheck').checked,
                        Name: field('name').value,
                        Email: field('email').value,
                        'Phone / WhatsApp': fullPhone(),
                        Country: field('country').value || '—',
                        ...brief(),
                        Message: field('message').value || '—',
                        'Requested from': source?.url ?? 'Came straight to /enquire/',
                        // Keeps any utm_* the visit carried.
                        'Page URL': location.href,
                    }),
                })
                if (!response.ok) throw new Error(String(response.status))

                const first = field('name').value.trim().split(' ')[0]
                if (first) {
                    root.querySelector('[data-thanks-title]').textContent =
                        `Thank you, ${first} — it's on its way to us.`
                }
                form.classList.add('hidden')
                progress.classList.add('hidden')
                thanks.classList.remove('hidden')
                thanks.classList.add('flex')
            } catch {
                showStatus(
                    `That didn’t go through. Please email <a href="mailto:${email}" style="color:inherit;text-decoration:underline">${email}</a> or <a href="${whatsapp}" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:underline">message us on WhatsApp</a> instead.`,
                    false
                )
            } finally {
                submit.disabled = false
            }
        })

        show(0)
    }
</script>

<style>
    /* Light picker chrome; an empty field reads as a prompt. */
    .planner-date {
        color-scheme: light;
    }
    .planner-date:not(:focus):invalid::-webkit-datetime-edit,
    .planner-date[value='']:not(:focus)::-webkit-datetime-edit {
        color: var(--color-muted);
    }
    /* The whole field opens the calendar, not just the icon. */
    .planner-date::-webkit-calendar-picker-indicator {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        opacity: 0;
        cursor: pointer;
    }

    /* The spinners add nothing to a short number field. */
    input[type='number'] {
        -moz-appearance: textfield;
        appearance: textfield;
    }
    input[type='number']::-webkit-outer-spin-button,
    input[type='number']::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>
