---
/**
 * /enquire/ — the destination of the header CTA, the hero's "Check
 * Availability" button and every "Enquire" link on the site.
 *
 * Ported from the trip planner on ~/web/atlas (src/pages/plan-my-trip.astro):
 * one question per screen — what you'd like to see, what draws you, who is
 * travelling, roughly when and for how long — and only then the contact
 * fields. Same screens, same interaction, restyled to this site's tokens and
 * Header/Footer. The trip length shares the date screen rather than taking a
 * fifth one, as it does in ~/web/mufasa_new.
 *
 * Atlas opens on a full-bleed "Let's Begin" splash; this page does not. Every
 * link that lands here is already a decision to enquire, so the first screen
 * is the first question and the h1 is visually hidden above it.
 *
 * Two things this version keeps that atlas's does not:
 *   - the answers are actually sent. Atlas's planner ends at a thank-you
 *     screen and posts nowhere; here the last screen POSTs to Web3Forms like
 *     the flat form it replaces, with the four answers carried along as
 *     labelled fields so the inbox reads like a brief.
 *   - the direct channels (phone, email, WhatsApp) stay on the contact
 *     screen. Plenty of this site's enquiries arrive that way and the flat
 *     form offered them.
 *
 * No backend. The Web3Forms free tier is 250 submissions a month shared with
 * the landing page and the newsletter; move to a real inbox integration
 * before that matters.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { CONTACT, WEB3FORMS, SITE, whatsappLink } from '../config'
import { PACKAGES } from '../content/packages'
import { TRAVEL_STYLES } from '../content/home'

interface Option {
    value: string
    label: string
}

interface Step {
    id: string
    kind: 'single' | 'multi' | 'date'
    title: string
    hint: string
    skip?: string
    /** Omitted on "date" steps, which render a picker instead of chips. */
    options?: Option[]
}

/*
 * Every option below is something we actually sell — the parks in
 * packages.ts' PLACES, and the three route tags (northern circuit, trekking,
 * Zanzibar). Nothing here should offer a country or an activity that no
 * itinerary on the site can deliver.
 */
const steps: Step[] = [
    {
        id: 'see',
        kind: 'multi',
        title: 'What would you like to see?',
        hint: 'Select one or more',
        options: [
            { value: 'serengeti', label: "The Serengeti's endless plains" },
            { value: 'crater', label: 'The Ngorongoro Crater' },
            { value: 'tarangire', label: "Tarangire's elephant herds" },
            { value: 'manyara', label: 'Lake Manyara' },
            { value: 'zanzibar', label: "Zanzibar's beaches" },
            { value: 'kilimanjaro', label: 'Kilimanjaro' },
            { value: 'culture', label: 'Maasai and Hadzabe country' },
        ],
    },
    {
        id: 'interests',
        kind: 'multi',
        title: 'What draws you?',
        hint: 'Select one or more',
        options: [
            { value: 'migration', label: 'The great migration' },
            { value: 'bigcats', label: 'Big cats and predators' },
            { value: 'firsttime', label: 'A first safari, the highlights' },
            { value: 'culture', label: 'Culture and community' },
            { value: 'romance', label: 'Romance and seclusion' },
            { value: 'summit', label: 'Trekking and the summit' },
            { value: 'beach', label: 'Beach and ocean' },
        ],
    },
    {
        id: 'occasion',
        kind: 'single',
        title: "Who's travelling?",
        hint: 'Select one',
        options: [
            { value: 'couple', label: 'Just the two of us' },
            { value: 'honeymoon', label: 'A honeymoon' },
            { value: 'family', label: 'With family' },
            { value: 'friends', label: 'With friends' },
            { value: 'solo', label: 'On my own' },
        ],
    },
    {
        id: 'arrival',
        kind: 'date',
        title: 'When would you like to travel?',
        hint: 'An approximate date is fine — we can move it later',
        skip: "I haven't decided yet",
    },
]

const totalSteps = steps.length

// Never offer a date in the past.
const minDate = new Date().toISOString().slice(0, 10)

/*
 * Trip length, asked in the same step as the date — ported from the planner in
 * ~/web/mufasa_new (PlannerFlow.astro's `duration` block on its date step): a
 * minus/number/plus stepper rather than a set of chips, so the answer is an
 * exact figure and nobody has to reply asking "how many, exactly?".
 *
 * The catalogue runs 6 to 13 days. The bounds are wider than that on purpose:
 * the planner also has to take a short private trip and a safari with a
 * Zanzibar week on the end. 7 opens the field — the length of the two
 * most-asked itineraries.
 */
const DAYS_MIN = 3
const DAYS_MAX = 30
const DAYS_INITIAL = 7

/*
 * Chip label lookup for the client script, so the inbox gets "The Ngorongoro
 * Crater" rather than "crater". Built here rather than in the browser because
 * the options only exist at build time.
 */
const optionLabels: Record<string, string> = {}
for (const step of steps) {
    for (const option of step.options ?? []) {
        optionLabels[`${step.id}:${option.value}`] = option.label
    }
}

/*
 * The "How do you want to travel?" cards on the homepage link here as
 * /enquire/?plan=<slug>. A plan carries two things: the card's title, which
 * reaches the inbox as the enquiry's stated intent, and the answers the
 * card's own title already gives, which arrive preselected so nobody is asked
 * something they have just told us.
 *
 * Built from TRAVEL_STYLES so the cards and the planner cannot drift, and
 * checked here rather than trusted: a preset naming a step or an option this
 * page does not offer is a build error, not a chip that quietly stops
 * lighting up when a question is reworded.
 */
const plans = Object.fromEntries(
    TRAVEL_STYLES.items.map((style) => {
        for (const [stepId, values] of Object.entries(style.preset ?? {})) {
            const step = steps.find((candidate) => candidate.id === stepId)
            if (!step) {
                throw new Error(
                    `TRAVEL_STYLES "${style.slug}" presets step "${stepId}", which /enquire/ does not ask.`
                )
            }
            for (const value of values ?? []) {
                if (!step.options?.some((option) => option.value === value)) {
                    throw new Error(
                        `TRAVEL_STYLES "${style.slug}" presets "${value}", which step "${stepId}" does not offer.`
                    )
                }
            }
        }
        return [style.slug, { label: style.title, answers: style.preset ?? {} }]
    })
)

/*
 * The itinerary pages no longer carry a form of their own: every "Enquire"
 * on /safari-packages/<slug>/ lands here as /enquire/?itinerary=<slug>.
 *
 * A slug that matches buys three things — the planner says on screen which
 * journey it is answering for, the contact screen's itinerary list opens on
 * it, and the trip length starts at the itinerary's own rather than at seven.
 * It also puts the itinerary's URL in the email, which `Page URL` cannot do:
 * that field can only ever say /enquire/, and the page someone enquired from
 * is the most useful line in the message.
 *
 * Built from PACKAGES, like the select on the contact screen, so this can
 * never name an itinerary the site has stopped selling. A slug that does not
 * match is ignored and the planner opens as it does for everybody else.
 */
const itineraries = Object.fromEntries(
    PACKAGES.map((pkg) => {
        const path = `/safari-packages/${pkg.slug}/`
        return [
            pkg.slug,
            { name: pkg.name, days: pkg.days, path, url: new URL(path, Astro.site).href },
        ]
    })
)

const whatsapp = whatsappLink(
    'Hello Polecat Safaris — I would like to plan a safari in Tanzania.'
)
---

<Layout
    title="Enquire — Plan a private Tanzania safari | Polecat Safaris"
    description="Answer four questions about what you'd love to see and who's coming. You'll get a draft itinerary with named lodges and a firm price, written by the team in Arusha who would run it."
>
    <Header />
    <main class="bg-cream" data-planner>
        <h1 class="sr-only">Plan your Tanzania safari</h1>

        {/* Filled in and unhidden by the script below when the visitor
            arrived from an itinerary page, so the first thing they see is
            that the planner already knows which journey they mean — and the
            way back to the page they left, in case they came here by
            accident. Stays put across all six screens. */}
        <aside
            class="gutter hidden border-b border-line bg-white py-4"
            data-source
            aria-label="What you are enquiring about"
        >
            <div
                class="shell flex flex-col gap-x-4 gap-y-1.5 sm:flex-row sm:flex-wrap sm:items-baseline"
            >
                <p class="text-[11px] leading-4 font-medium tracking-[0.2em] text-primary uppercase">
                    Enquiring about
                </p>
                <p class="text-[15px] leading-6 text-ink">
                    <a
                        data-source-link
                        class="underline decoration-line underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
                        href="/safari-packages/"></a>
                </p>
                <p
                    class="text-[13px] leading-6 break-all text-muted/75 sm:ml-auto"
                    data-source-url
                >
                </p>
            </div>
        </aside>

        {/* Steps */}
        {
            steps.map((step, i) => (
                <section
                    class="gutter hidden min-h-[70vh] flex-col items-center justify-center py-20 text-center lg:py-25"
                    data-screen="step"
                    data-step-id={step.id}
                    data-step-kind={step.kind}
                >
                    <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-muted uppercase">
                        <span class="text-primary">{i + 1}</span> / {totalSteps}
                    </p>
                    <h2 class="font-display max-w-200 pt-4 text-[32px] leading-[1.14] font-light tracking-[-0.014em] text-balance text-ink lg:text-[46px]">
                        {step.title}
                    </h2>
                    <p class="pt-3 pb-10 text-[15px] leading-7 text-muted">{step.hint}</p>

                    {step.kind === 'date' ? (
                        <div class="flex w-full flex-col items-center gap-5">
                            <label class="relative block w-full max-w-100">
                                <span class="sr-only">Arrival date</span>
                                <input
                                    type="date"
                                    min={minDate}
                                    class="planner-date w-full border border-line bg-white px-5 py-4 pr-14 text-center text-[17px] leading-6 text-ink transition-colors hover:border-primary/60 focus:border-primary focus:outline-none"
                                    data-date-field
                                />
                                <span
                                    aria-hidden="true"
                                    class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-primary"
                                >
                                    <svg
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <rect x="3" y="5" width="18" height="16" rx="2" />
                                        <path d="M8 3v4M16 3v4M3 10h18" />
                                    </svg>
                                </span>
                            </label>
                            <p
                                class="font-display min-h-8 text-[22px] leading-8 text-primary italic"
                                data-date-pretty
                            />

                            <div class="flex w-full flex-col items-center gap-3.5 pt-1">
                                <span class="text-[11px] leading-3.5 font-medium tracking-[0.22em] text-muted uppercase">
                                    And how many days on safari?
                                </span>
                                {/* The unit sits outside the stepper so the two
                                    buttons stay evenly spaced around the
                                    number; on a phone there is no room beside
                                    it, so it drops underneath. */}
                                <div class="relative flex flex-wrap items-center justify-center gap-3">
                                    <button
                                        type="button"
                                        class="flex h-14 w-12 cursor-pointer items-center justify-center border border-line bg-white text-[20px] leading-none text-ink transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-35"
                                        data-days-step="-1"
                                        aria-label="One day fewer"
                                    >
                                        &#8722;
                                    </button>
                                    <label class="block">
                                        <span class="sr-only">Number of days</span>
                                        <input
                                            type="number"
                                            class="planner-count h-14 w-28 border border-line bg-white px-2 text-center text-[24px] leading-8 text-ink transition-colors focus:border-primary focus:outline-none"
                                            data-days-field
                                            inputmode="numeric"
                                            min={DAYS_MIN}
                                            max={DAYS_MAX}
                                            value={DAYS_INITIAL}
                                        />
                                    </label>
                                    <button
                                        type="button"
                                        class="flex h-14 w-12 cursor-pointer items-center justify-center border border-line bg-white text-[20px] leading-none text-ink transition-colors hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-35"
                                        data-days-step="1"
                                        aria-label="One day more"
                                    >
                                        +
                                    </button>
                                    <span
                                        class="w-full text-center text-[11px] leading-3.5 font-medium tracking-[0.2em] text-muted uppercase sm:absolute sm:left-[calc(100%+0.75rem)] sm:w-auto sm:text-left"
                                        data-days-unit
                                    >
                                        days
                                    </span>
                                </div>
                                {/* The far end of the trip, derived from the
                                    two answers above it. The arrival is
                                    already spelled out over this line, so this
                                    one names only the last day rather than
                                    restating the span. */}
                                <p
                                    class="min-h-6 text-[14px] leading-6 text-muted"
                                    data-days-span
                                />
                            </div>
                        </div>
                    ) : (
                        <div class="flex max-w-220 flex-wrap justify-center gap-3">
                            {step.options?.map((opt) => (
                                <button
                                    type="button"
                                    class="cursor-pointer border border-line bg-white px-5 py-3.5 text-[15px] leading-6 text-ink transition-colors hover:border-primary data-[selected]:border-primary data-[selected]:bg-primary data-[selected]:text-white"
                                    data-option
                                    data-step={step.id}
                                    data-value={opt.value}
                                    aria-pressed="false"
                                >
                                    {opt.label}
                                </button>
                            ))}
                        </div>
                    )}

                    {step.skip && (
                        <button
                            type="button"
                            class="mt-8 cursor-pointer text-[14px] leading-6 text-muted underline underline-offset-4 transition-colors hover:text-primary"
                            data-go-next
                            data-skip
                        >
                            {step.skip}
                        </button>
                    )}

                    <div class="mt-12 flex items-center gap-6">
                        <button
                            type="button"
                            class="cursor-pointer text-[11px] leading-4 tracking-[0.18em] text-muted uppercase transition-colors hover:text-ink"
                            data-go-back
                        >
                            Previous
                        </button>
                        <button
                            type="button"
                            class="flex cursor-pointer items-center justify-center bg-primary px-9 py-4.25 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-[#083329] disabled:cursor-not-allowed disabled:opacity-30"
                            data-go-next
                            disabled
                        >
                            {i === totalSteps - 1 ? 'Continue' : 'Next Step'}
                        </button>
                    </div>
                </section>
            ))
        }

        {/* Contact. `novalidate` so the messages below are ours rather than the
            browser's, but every field keeps its real type so mobile keyboards
            and autofill still behave. */}
        <section
            class="gutter hidden min-h-[70vh] flex-col justify-center py-16 lg:py-20"
            data-screen="contact"
        >
            <div class="mx-auto w-full max-w-150">
                <h2
                    class="font-display text-[32px] leading-[1.14] font-light tracking-[-0.014em] text-ink lg:text-[42px]"
                >
                    Where should we send your ideas?
                </h2>
                <p class="pt-3.5 text-[16px] leading-7.5 text-muted">
                    Leave your details and a guide in Arusha — not a call centre — will come back
                    with a draft itinerary, named lodges and a firm price.
                </p>

                <p
                    class="mt-7 hidden border-l-2 border-primary bg-white py-3.5 pr-4.5 pl-4.5 text-[14px] leading-6 text-muted"
                    data-answer-summary
                >
                </p>

                <form id="enquiry-form" class="mt-7 flex flex-col gap-5" novalidate>
                    {/* Honeypot — Web3Forms drops any submission where this is
                        filled, so the public key doesn't invite spam. */}
                    <input
                        type="checkbox"
                        name="botcheck"
                        class="hidden"
                        style="display:none"
                        tabindex="-1"
                        autocomplete="off"
                    />

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="enquiry-name"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                >Your name</label
                            >
                            <input
                                id="enquiry-name"
                                name="name"
                                type="text"
                                required
                                autocomplete="name"
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="enquiry-email"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                >Email</label
                            >
                            <input
                                id="enquiry-email"
                                name="email"
                                type="email"
                                required
                                autocomplete="email"
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="enquiry-phone"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                            >
                                Phone or WhatsApp
                                <span class="font-normal tracking-normal text-muted normal-case"
                                    >(optional)</span
                                >
                            </label>
                            <input
                                id="enquiry-phone"
                                name="phone"
                                type="tel"
                                inputmode="tel"
                                autocomplete="tel"
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="enquiry-travellers"
                                class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                                >Travellers</label
                            >
                            <input
                                id="enquiry-travellers"
                                name="travellers"
                                type="number"
                                min="1"
                                max="24"
                                value="2"
                                class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                            />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label
                            for="enquiry-itinerary"
                            class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                        >
                            An itinerary you have in mind
                            <span class="font-normal tracking-normal text-muted normal-case"
                                >(optional)</span
                            >
                        </label>
                        {/* Sourced from packages.ts so this list can never offer
                            an itinerary the site no longer sells. */}
                        <select
                            id="enquiry-itinerary"
                            name="itinerary"
                            class="planner-select border-b border-line bg-transparent pb-2.5 text-[16px] leading-6 text-ink focus:border-primary focus:outline-none"
                        >
                            <option value="">Not sure yet — advise me</option>
                            {PACKAGES.map((pkg) => <option value={pkg.name}>{pkg.name}</option>)}
                            <option value="Something else entirely">Something else entirely</option>
                        </select>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label
                            for="enquiry-message"
                            class="text-[11px] leading-3.5 font-medium tracking-[0.18em] text-ink uppercase"
                        >
                            Anything else we should know
                            <span class="font-normal tracking-normal text-muted normal-case"
                                >(optional)</span
                            >
                        </label>
                        <textarea
                            id="enquiry-message"
                            name="message"
                            rows="2"
                            placeholder="Children and their ages, a budget, dietary needs, Zanzibar days on the end."
                            class="border-b border-line bg-transparent pb-2.5 text-[16px] leading-7 text-ink placeholder:text-[15px] placeholder:text-muted/65 focus:border-primary focus:outline-none"
                        ></textarea>
                    </div>

                    {/* Announced rather than focus-moved, so a screen reader
                        hears the outcome where the user already is. */}
                    <p
                        data-enquiry-status
                        role="status"
                        aria-live="polite"
                        class="hidden text-[14px] leading-6"
                    >
                    </p>

                    <div class="mt-1 flex items-center justify-between gap-6">
                        <button
                            type="button"
                            class="cursor-pointer text-[11px] leading-4 tracking-[0.18em] text-muted uppercase transition-colors hover:text-ink"
                            data-go-back
                        >
                            Previous
                        </button>
                        <button
                            type="submit"
                            class="flex cursor-pointer items-center justify-center bg-primary px-9 py-4.25 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-[#083329] disabled:cursor-wait disabled:opacity-70"
                        >
                            Send My Enquiry
                        </button>
                    </div>

                    <p class="text-[12px] leading-5 text-muted">
                        Nothing is booked and nothing is charged until you have said yes to an
                        itinerary. We reply within one working day, and use your details to answer
                        this enquiry and nothing else.
                    </p>
                </form>

                <div class="mt-8 flex flex-col gap-3 border-t border-line pt-6">
                    <p
                        class="text-[11px] leading-3.5 font-medium tracking-[0.24em] text-ink uppercase"
                    >
                        Or reach us directly
                    </p>
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                        <a
                            href={CONTACT.phoneHref}
                            class="text-[16px] leading-7 text-ink transition-colors hover:text-primary"
                            >{CONTACT.phone}</a
                        >
                        <a
                            href={`mailto:${CONTACT.email}`}
                            class="text-[16px] leading-7 text-primary hover:underline"
                            >{CONTACT.email}</a
                        >
                        {/* The mark, then the number it reaches — drawn from
                            primitives in the house style of the footer's
                            social icons rather than lifted from a brand
                            asset. No `rule-link` here: the trailing rule read
                            as a stray line beside the icon. */}
                        <a
                            href={whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-2 text-[16px] leading-7 text-primary transition-colors hover:text-ink"
                        >
                            <svg
                                width="17"
                                height="17"
                                viewBox="0 0 18 18"
                                fill="none"
                                stroke="currentColor"
                                aria-hidden="true"
                                class="shrink-0"
                            >
                                <path
                                    d="M5.18 13.37A6.1 6.1 0 103.21 10.28L1.31 13.2Z"
                                    stroke-width="1.2"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M7.4 7.1c-.5.8.1 2 1 2.9.9.9 2.1 1.5 2.9 1"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </svg>
                            {CONTACT.phone}
                            <span class="sr-only">on WhatsApp</span>
                        </a>
                    </div>
                    <p class="pt-1 text-[13px] leading-5.5 text-muted">
                        {SITE.city} · East Africa Time (GMT+3)
                    </p>
                </div>
            </div>
        </section>

        {/* Thank you */}
        <section
            class="gutter hidden min-h-[70vh] flex-col items-center justify-center py-20 text-center lg:py-25"
            data-screen="thanks"
        >
            <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-muted uppercase">
                Enquiry received
            </p>
            <h2
                class="font-display max-w-160 pt-5 text-[32px] leading-[1.14] font-light tracking-[-0.014em] text-balance text-ink lg:text-[46px]"
                data-thanks-title
            >
                Thank you — it's on its way to us.
            </h2>
            <p class="max-w-140 pt-4 text-[16px] leading-7.5 text-muted">
                A guide in Arusha will read what you've shared and reply personally, usually the
                same day and always within one working day.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4 pt-9">
                <a
                    href="/"
                    class="flex items-center justify-center bg-primary px-9 py-4.25 text-[12px] leading-4 font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-[#083329]"
                >
                    Back To Home
                </a>
                <button
                    type="button"
                    class="flex cursor-pointer items-center justify-center border border-line bg-white px-9 py-4.25 text-[12px] leading-4 font-medium tracking-[0.2em] text-ink uppercase transition-colors hover:border-primary hover:text-primary"
                    data-restart
                >
                    Plan Another Trip
                </button>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script
    define:vars={{
        endpoint: WEB3FORMS.endpoint,
        accessKey: WEB3FORMS.accessKey,
        subject: WEB3FORMS.enquirySubject,
        optionLabels,
        whatsapp,
        email: CONTACT.email,
        daysMin: DAYS_MIN,
        daysMax: DAYS_MAX,
        daysInitial: DAYS_INITIAL,
        plans,
        itineraries,
    }}
>
    const root = document.querySelector('[data-planner]')
    if (root) {
        const screens = Array.from(root.querySelectorAll('[data-screen]'))
        const stepScreens = screens.filter((s) => s.dataset.screen === 'step')
        const form = document.getElementById('enquiry-form')
        const status = form?.querySelector('[data-enquiry-status]')
        const button = form?.querySelector('button[type="submit"]')
        const thanksTitle = root.querySelector('[data-thanks-title]')
        const summary = root.querySelector('[data-answer-summary]')
        const total = stepScreens.length

        /* `days` starts at its default rather than empty: the stepper always
           shows a figure, so that figure has to be the stored answer even if
           nobody touches it. */
        const answers = {
            see: [],
            interests: [],
            occasion: [],
            arrival: [],
            days: [String(daysInitial)],
        }

        const params = new URLSearchParams(window.location.search)

        /* Which itinerary page sent them here, if any. `source` is carried
           into the email as the page the enquiry was made from; the strip at
           the top of the planner says the same thing to the visitor, so
           nobody has to trust that a query string did its job. */
        let source = null
        const sourceStrip = root.querySelector('[data-source]')
        const itinerary = itineraries[params.get('itinerary') ?? '']

        function showSource(entry) {
            source = entry
            if (!sourceStrip) return
            if (!entry) {
                sourceStrip.classList.add('hidden')
                return
            }
            const link = sourceStrip.querySelector('[data-source-link]')
            const url = sourceStrip.querySelector('[data-source-url]')
            if (link) {
                link.textContent = entry.name
                link.href = entry.path
            }
            if (url) url.textContent = entry.url
            sourceStrip.classList.remove('hidden')
        }

        /* Which card sent them here, if any — reported to the inbox as the
           stated intent. The answers a plan presets are visible as selected
           chips, so the summary does not restate them. */
        let intent = null
        const plan = plans[params.get('plan') ?? '']
        if (plan) {
            intent = plan.label
            for (const [stepId, values] of Object.entries(plan.answers)) {
                answers[stepId] = [...values]
                root.querySelectorAll(`[data-option][data-step="${stepId}"]`).forEach((chip) => {
                    const on = values.includes(chip.dataset.value)
                    chip.toggleAttribute('data-selected', on)
                    chip.setAttribute('aria-pressed', on ? 'true' : 'false')
                })
            }
            stepScreens.forEach((screen) => syncNext(screen))
        }

        /** "12 June 2026", or "" if the value isn't a real date. */
        function longDate(iso, withWeekday = false) {
            if (!iso) return ''
            const when = new Date(`${iso}T00:00:00`)
            if (Number.isNaN(when.getTime())) return ''
            return when.toLocaleDateString('en-GB', {
                ...(withWeekday ? { weekday: 'long' } : {}),
                day: 'numeric',
                month: 'long',
                year: 'numeric',
            })
        }

        const labelsFor = (stepId) =>
            answers[stepId].map((value) => optionLabels[`${stepId}:${value}`] ?? value)

        /** The arrival date as it currently stands, or "" if none has been given. */
        const currentArrival = () => answers.arrival[0] ?? ''

        /* What the wizard heard, restated above the contact fields — the
           answers are three screens back by the time someone types their
           email, and they can still be changed with Previous. */
        function renderSummary() {
            if (!summary) return
            const parts = []
            const occasion = labelsFor('occasion')[0]
            if (occasion) parts.push(occasion)
            const seeing = [...labelsFor('see'), ...labelsFor('interests')]
            if (seeing.length) parts.push(seeing.join(', '))
            const arriving = longDate(currentArrival())
            parts.push(
                arriving
                    ? `${daysLabel()} from around ${arriving}`
                    : `${daysLabel()}, dates still open`
            )

            summary.textContent = `You told us: ${parts.join(' · ')}.`
            summary.classList.remove('hidden')
        }

        /* The page opens on the first question — there is no splash screen in
           front of it, so screen 0 is a step and the first step has nothing
           to go back to. */
        const CONTACT_SCREEN = total
        const THANKS = total + 1
        let index = 0

        function show(i) {
            index = i
            const isContact = i === CONTACT_SCREEN
            const isThanks = i === THANKS

            screens.forEach((s) => {
                s.classList.add('hidden')
                s.classList.remove('flex')
            })

            let target = null
            if (isContact) {
                target = root.querySelector('[data-screen="contact"]')
                renderSummary()
            } else if (isThanks) target = root.querySelector('[data-screen="thanks"]')
            else {
                target = stepScreens[i]
                syncNext(target)
            }
            target?.classList.remove('hidden')
            target?.classList.add('flex')

            // Only steps past the first can be reached from somewhere.
            target?.querySelectorAll('[data-go-back]').forEach((b) => {
                b.hidden = i === 0
            })

            window.scrollTo({ top: 0, behavior: 'smooth' })
        }

        root.querySelectorAll('[data-option]').forEach((chip) => {
            chip.addEventListener('click', () => {
                const stepId = chip.dataset.step
                const value = chip.dataset.value
                const screen = chip.closest('[data-screen="step"]')

                if (screen.dataset.stepKind === 'single') {
                    answers[stepId] = [value]
                    screen.querySelectorAll('[data-option]').forEach((c) => {
                        const on = c === chip
                        c.setAttribute('aria-pressed', on ? 'true' : 'false')
                        c.toggleAttribute('data-selected', on)
                    })
                    setTimeout(() => go(1), 180)
                    return
                }

                const set = new Set(answers[stepId])
                if (set.has(value)) set.delete(value)
                else set.add(value)
                answers[stepId] = Array.from(set)
                const on = set.has(value)
                chip.setAttribute('aria-pressed', on ? 'true' : 'false')
                chip.toggleAttribute('data-selected', on)
                syncNext(screen)
            })
        })

        const dateField = root.querySelector('[data-date-field]')
        const datePretty = root.querySelector('[data-date-pretty]')

        /* Trip length. There is one date step, so these are unique on the
           page and need no per-step lookup. */
        const daysField = root.querySelector('[data-days-field]')
        const daysUnit = root.querySelector('[data-days-unit]')
        const daysSpan = root.querySelector('[data-days-span]')

        const currentDays = () => Number(answers.days[0])
        const daysLabel = () => `${currentDays()} ${currentDays() === 1 ? 'day' : 'days'}`

        /** The last day away, counting the arrival day as day one. */
        function lastDay() {
            const iso = currentArrival()
            const days = currentDays()
            if (!iso || !Number.isFinite(days)) return ''
            const end = new Date(`${iso}T00:00:00`)
            if (Number.isNaN(end.getTime())) return ''
            end.setDate(end.getDate() + days - 1)
            // Local parts rather than toISOString(), which east of UTC would
            // hand back the day before.
            const pad = (n) => String(n).padStart(2, '0')
            return longDate(
                `${end.getFullYear()}-${pad(end.getMonth() + 1)}-${pad(end.getDate())}`,
                true
            )
        }

        function paintDays() {
            const days = currentDays()
            if (daysUnit) daysUnit.textContent = days === 1 ? 'day' : 'days'
            const end = lastDay()
            if (daysSpan) daysSpan.textContent = end ? `Your last day would be ${end}.` : ''
            root.querySelectorAll('[data-days-step]').forEach((b) => {
                b.disabled = Number(b.dataset.daysStep) < 0 ? days <= daysMin : days >= daysMax
            })
        }

        function commitDays(n) {
            const clamped = Math.min(daysMax, Math.max(daysMin, Number.isFinite(n) ? n : daysMin))
            if (daysField) daysField.value = String(clamped)
            answers.days = [String(clamped)]
            paintDays()
        }

        root.querySelectorAll('[data-days-step]').forEach((b) =>
            b.addEventListener('click', () =>
                commitDays(Number(daysField?.value) + Number(b.dataset.daysStep))
            )
        )

        /* Typing is only clamped once the field settles: clamping on every
           keystroke turns a half-typed "1" of 12 into a 3. */
        daysField?.addEventListener('input', () => {
            const n = Number(daysField.value)
            if (Number.isFinite(n) && n >= daysMin && n <= daysMax) {
                answers.days = [String(n)]
                paintDays()
            }
        })
        daysField?.addEventListener('blur', () => commitDays(Number(daysField.value)))

        function syncArrival() {
            const iso = currentArrival()
            if (dateField) dateField.value = iso
            if (datePretty) datePretty.textContent = longDate(iso, true)
            // The last-day line reads from the date, so it follows every change.
            paintDays()
        }

        dateField?.addEventListener('change', () => {
            answers.arrival = dateField.value ? [dateField.value] : []
            syncArrival()
        })

        commitDays(Number(daysField?.value))
        syncArrival()

        /* Now that the stepper holds a value, an itinerary from the query
           string can overwrite it. Applied here rather than beside the plan
           block above, because `commitDays` reads fields that are const and
           declared between the two. */
        if (itinerary) {
            showSource(itinerary)
            intent = intent ?? itinerary.name
            commitDays(itinerary.days)
            const select = form?.elements.namedItem('itinerary')
            /* Only if the list still offers it. Both are built from
               PACKAGES, so it does — but a select silently holding "" while
               the strip above names a journey would be the worst of both. */
            if (select && [...select.options].some((o) => o.value === itinerary.name)) {
                select.value = itinerary.name
            }
        }

        /* The date step can be passed with nothing chosen — there is a skip
           link for it — so it is the one step whose Next is never disabled. */
        function syncNext(screen) {
            if (!screen) return
            const next = screen.querySelector('[data-go-next]:not([data-skip])')
            if (!next) return
            const stepId = screen.dataset.stepId
            next.disabled = stepId === 'arrival' ? false : (answers[stepId] ?? []).length === 0
        }

        function go(dir) {
            const target = index + dir
            if (target < 0 || target > THANKS) return
            show(target)
        }

        root.querySelectorAll('[data-go-next]').forEach((b) =>
            b.addEventListener('click', () => {
                if (b.dataset.skip !== undefined) {
                    answers.arrival = []
                    syncArrival()
                }
                go(1)
            })
        )
        root.querySelectorAll('[data-go-back]').forEach((b) =>
            b.addEventListener('click', () => go(-1))
        )
        root.querySelectorAll('[data-restart]').forEach((b) =>
            b.addEventListener('click', () => {
                answers.see = []
                answers.interests = []
                answers.occasion = []
                answers.arrival = []
                intent = null
                showSource(null)
                commitDays(daysInitial)
                root.querySelectorAll('[data-option]').forEach((c) => {
                    c.removeAttribute('data-selected')
                    c.setAttribute('aria-pressed', 'false')
                })
                form?.reset()
                status?.classList.add('hidden')
                syncArrival()
                stepScreens.forEach((s) => syncNext(s))
                show(0)
            })
        )

        function showStatus(message, ok) {
            if (!status) return
            status.innerHTML = message
            status.classList.remove('hidden')
            status.style.color = ok ? 'var(--color-primary)' : '#A8371E'
        }

        const field = (name) => form?.elements.namedItem(name)

        form?.addEventListener('submit', async (event) => {
            event.preventDefault()

            // Validated by hand so the message reads like the rest of the page
            // and so the first bad field is the one that gets focus.
            for (const name of ['name', 'email']) {
                const input = field(name)
                if (input && !input.checkValidity()) {
                    showStatus('Please add your name and a valid email so we can reply.', false)
                    input.focus()
                    return
                }
            }

            if (button) button.disabled = true

            const arriving = longDate(currentArrival())

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({
                        access_key: accessKey,
                        subject,
                        from_name: 'Polecat Safaris — main site',
                        replyto: field('email')?.value,
                        botcheck: field('botcheck')?.checked ?? false,
                        Name: field('name')?.value,
                        Email: field('email')?.value,
                        Phone: field('phone')?.value || '—',
                        Travellers: field('travellers')?.value || '—',
                        'Travel window': arriving || 'Not decided yet',
                        'Trip length': daysLabel(),
                        'Interested in': intent ?? '—',
                        // The four planner answers, in the order they were asked.
                        'Would like to see': labelsFor('see').join(', ') || '—',
                        'Drawn to': labelsFor('interests').join(', ') || '—',
                        'Travelling as': labelsFor('occasion')[0] ?? '—',
                        Itinerary: field('itinerary')?.value || 'Not specified',
                        Message: field('message')?.value || '—',
                        // The itinerary page the enquiry was made from, where
                        // there was one. `Page URL` below is always /enquire/,
                        // so without this the inbox cannot tell a visitor who
                        // read a whole itinerary from one who arrived cold.
                        'Requested from': source?.url ?? 'Came straight to /enquire/',
                        // The full URL, so any utm_* the visit carried survives
                        // into the inbox alongside the fields.
                        'Page URL': window.location.href,
                    }),
                })
                if (!response.ok) throw new Error(String(response.status))

                const first = (field('name')?.value ?? '').trim().split(' ')[0]
                if (thanksTitle && first) {
                    thanksTitle.textContent = `Thank you, ${first} — it's on its way to us.`
                }
                form.reset()
                status?.classList.add('hidden')
                show(THANKS)
            } catch {
                // Nothing else captures this enquiry, so the visitor has to be
                // told it failed and handed a channel that works.
                showStatus(
                    `That didn’t go through. Please email <a href="mailto:${email}" style="color:inherit;text-decoration:underline">${email}</a> or <a href="${whatsapp}" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:underline">message us on WhatsApp</a> instead.`,
                    false
                )
            } finally {
                if (button) button.disabled = false
            }
        })

        show(0)
    }
</script>

<style>
    /* An untouched select is a prompt, not an answer, so it is dimmed until a
       real itinerary is chosen. :has() is doing the work a placeholder would
       do if <select> had one; where it is unsupported the prompt simply stays
       at full strength. */
    .planner-select:has(option[value='']:checked) {
        color: color-mix(in srgb, var(--color-muted) 65%, transparent);
    }

    /* Light picker chrome, and a blank field reads as a prompt rather than
       "mm/dd/yyyy" noise. */
    .planner-date {
        color-scheme: light;
    }

    .planner-date::-webkit-datetime-edit {
        color: var(--color-ink);
    }

    .planner-date:not(:focus):invalid::-webkit-datetime-edit,
    .planner-date[value='']:not(:focus)::-webkit-datetime-edit {
        color: var(--color-muted);
    }

    /* The spinner chrome is redundant next to the minus/plus buttons. */
    .planner-count {
        -moz-appearance: textfield;
        appearance: textfield;
    }

    .planner-count::-webkit-outer-spin-button,
    .planner-count::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Stretch the invisible picker trigger over the calendar icon block. */
    .planner-date::-webkit-calendar-picker-indicator {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        opacity: 0;
        cursor: pointer;
    }
</style>
