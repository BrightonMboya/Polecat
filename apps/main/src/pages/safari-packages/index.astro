---
/**
 * Every itinerary the operator sells: the ten northern-Tanzania safaris, then
 * the five Kilimanjaro climbs. Same cards the homepage uses.
 *
 * The climbs used to be left off here and reached only from /kilimanjaro,
 * which was the split the Journeys menu drew. That menu is gone from the
 * header, so this page is now the one place the whole catalogue is listed —
 * which is also what the comment above PACKAGES in src/content/home.ts has
 * always claimed of it, and what the "Safari Packages" breadcrumb on a climb's
 * own itinerary page has always implied.
 *
 * One page, not two bands. The climbs first arrived here as their own
 * section — second background, second full-size heading, its own closing
 * paragraph — and it read as a different page stapled on the end, with the
 * safaris' sign-off stranded in the middle of the catalogue. So the two lines
 * are groups now: one background, one rhythm, a labelled rule over each grid,
 * and a single sign-off after the last card. The label treatment is the one
 * the itinerary page uses over its own bands.
 *
 * /kilimanjaro stays. It is not a filtered view of this page: "Kilimanjaro
 * climb" is a far bigger search term than anything on the safari side, and it
 * carries the acclimatisation and crew detail that a trekker is actually
 * reading for. The group below is the listing, not a replacement for it.
 */
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import Newsletter from '../../components/Newsletter.astro'
import PackageCard from '../../components/PackageCard.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import { PACKAGES as PACKAGES_SECTION } from '../../content/home'
import { ROUTE_LABELS, SAFARIS, TREKS } from '../../content/packages'

/*
 * The two groups, in the order the page reads. `note` is the line ranged
 * against the label — what the group is and how much of it there is, so the
 * rule carries the orientation a second standfirst used to.
 */
const GROUPS = [
    {
        id: 'safaris',
        label: 'Safaris',
        note: 'Ten itineraries · Northern Tanzania & Zanzibar',
        items: SAFARIS,
    },
    {
        id: 'trekking',
        label: 'Kilimanjaro climbs',
        note: 'Five routes · Six to nine days on the mountain',
        items: TREKS,
    },
]
---

<Layout
    title="Safari Packages — Tanzania Safaris and Kilimanjaro Climbs | Polecat Safaris"
    description="Every itinerary we sell: ten private safaris across northern Tanzania and Zanzibar — honeymoon, family and Great Migration, six to thirteen days — and five routes up Kilimanjaro, each with day-by-day detail and rates."
>
    <Header />
    <main>
        <section class="gutter flex flex-col items-center bg-cream pt-16 pb-20 lg:pt-24 lg:pb-28.5">
            <SectionHeading heading={PACKAGES_SECTION.heading} body={PACKAGES_SECTION.body} />

            {/* Shown by the script below when the hash names a route. */}
            <p
                data-route-note
                hidden
                class="mt-8 text-center text-[13px] leading-5 text-muted"
                aria-live="polite"
            >
                <span data-route-note-text></span>
                <a href="/safari-packages/" class="ml-2 text-primary underline underline-offset-4">
                    Show all itineraries
                </a>
            </p>

            {
                GROUPS.map((group, groupIndex) => (
                    <div
                        id={group.id}
                        data-group
                        class:list={[
                            'shell w-full scroll-mt-8',
                            groupIndex === 0 ? 'mt-12 lg:mt-14' : 'mt-16 lg:mt-20',
                        ]}
                    >
                        {/* Label left, what-and-how-many right, a rule under
                            both. Stacks on a phone, where the two would
                            otherwise collide. */}
                        <div class="flex flex-col gap-1.5 border-b border-line pb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                            <h3 class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase">
                                {group.label}
                            </h3>
                            <p class="text-[12px] leading-4.5 text-muted">{group.note}</p>
                        </div>

                        <ul class="mt-6.5 grid grid-cols-1 gap-6.5 sm:grid-cols-2 lg:grid-cols-3">
                            {group.items.map((pkg, index) => (
                                <PackageCard
                                    pkg={pkg}
                                    loading={groupIndex === 0 && index < 3 ? 'eager' : 'lazy'}
                                    headingLevel={4}
                                />
                            ))}
                        </ul>
                    </div>
                ))
            }

            {/* One sign-off, after the last card rather than between the two
                grids. It answers for both lines, so it stays general. */}
            <p class="shell mt-14 max-w-180 text-center text-[16px] leading-7.25 text-muted lg:mt-16">
                Nothing here quite right? Every one of these is private, so the days, the camps and
                the season can all move. Tell us roughly what you have in mind and we will draft
                something against it.
            </p>
        </section>

        <Newsletter />
    </main>
    <Footer />
</Layout>

<script define:vars={{ ROUTE_LABELS }}>
    // /safari-packages/#<route> — from the homepage pills, the destination
    // cards and the footer — shows only the itineraries on that route, and
    // drops any band left empty. Any other hash, or none, shows everything.
    const groups = document.querySelectorAll('[data-group]')
    const note = document.querySelector('[data-route-note]')
    const noteText = document.querySelector('[data-route-note-text]')

    const apply = () => {
        const route = location.hash.slice(1)
        const label = ROUTE_LABELS[route]
        let total = 0

        for (const group of groups) {
            let shown = 0
            for (const card of group.querySelectorAll('li[data-routes]')) {
                const match = !label || card.dataset.routes.split(' ').includes(route)
                card.hidden = !match
                if (match) shown++
            }
            group.hidden = shown === 0
            total += shown
        }

        note.hidden = !label
        if (label) {
            noteText.textContent = `Showing ${total} ${total === 1 ? 'itinerary' : 'itineraries'} on the ${label} route.`
        }
    }

    apply()
    addEventListener('hashchange', apply)
</script>

<style is:global>
    /* A card's own display:flex would beat the hidden attribute. */
    [data-group] li[data-routes][hidden],
    [data-group][hidden] {
        display: none;
    }
</style>
