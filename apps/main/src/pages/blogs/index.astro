---
/**
 * The journal index. Lives at /blogs/ because that is where it lived on the
 * old WordPress site — the old paginated variants (/blogs/page/2/ and so on)
 * canonicalised to this URL, so there is nothing to preserve there.
 */
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import PostCard from '../../components/PostCard.astro'
import { SITE } from '../../config'
import { getCategories, getPosts } from '../../content/journal'

const posts = await getPosts()
const categories = await getCategories(posts)
const lead = posts[0]

const pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `Journal — ${SITE.legalName}`,
    url: new URL('/blogs/', Astro.site).href,
    blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        datePublished: post.data.pubDate.toISOString(),
        url: new URL(`/${post.id}/`, Astro.site).href,
    })),
}
---

<Layout
    title={`Journal - ${SITE.legalName}`}
    description="Field notes, park guides and route advice from our own guides — the rivers, the lakes, the crater and the coast, written by the people who drive them."
    preloadImage={lead?.data.heroImage}
    ogImage={lead?.data.heroImage}
    pageSchema={pageSchema}
>
    <Header />
    <main>
        <section class="gutter flex flex-col items-center bg-cream pt-16 pb-14 lg:pt-20 lg:pb-16">
            <div class="shell flex max-w-200 flex-col items-center gap-3">
                <p
                    class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase"
                >
                    From The Field
                </p>
                <h1
                    class="font-display text-center text-[40px] leading-[1.18] font-light text-ink lg:text-[56px] lg:leading-17"
                >
                    Journal
                </h1>
                <p class="pt-2 text-center text-[17px] leading-7.75 text-muted">
                    Guides to the places we travel, written by the people who guide them — {
                        posts.length
                    } notes from the parks, the rivers and the lakes of Tanzania.
                </p>
            </div>

            <nav
                class="flex flex-wrap items-center justify-center gap-2.5 pt-9"
                aria-label="Journal categories"
            >
                <span
                    aria-current="page"
                    class="border border-primary bg-primary px-5 py-2.5 text-[11px] leading-4 font-medium tracking-[0.18em] text-white uppercase"
                >
                    All Notes
                </span>
                {
                    categories.map((category) => (
                        <a
                            href={`/category/${category.slug}/`}
                            class="border border-line px-5 py-2.5 text-[11px] leading-4 font-medium tracking-[0.18em] text-muted uppercase transition-colors hover:border-primary hover:text-primary"
                        >
                            {category.label}
                        </a>
                    ))
                }
            </nav>
        </section>

        <section class="gutter flex flex-col items-center bg-cream pb-20 lg:pb-28">
            <ul class="shell grid grid-cols-1 gap-6.5 sm:grid-cols-2 lg:grid-cols-3">
                {
                    posts.map((post, index) => (
                        <PostCard post={post} loading={index < 3 ? 'eager' : 'lazy'} />
                    ))
                }
            </ul>
        </section>
    </main>
    <Footer />
</Layout>
