---
import '../styles/global.css'
import { SITE, CONTACT, TRIPADVISOR, SOCIAL } from '../config'

interface Props {
    title: string
    description: string
    /** Path of the LCP image, preloaded so the hero paints sooner. */
    preloadImage?: string
    /**
     * Candidates and sizes for a responsive LCP image. Both have to match the
     * <img> exactly, or the browser preloads one width and then fetches
     * another.
     */
    preloadImageSrcset?: string
    preloadImageSizes?: string
    /** Journal posts are `article`; everything else is a `website`. */
    ogType?: 'website' | 'article'
    /** Article timestamps, emitted only for posts. */
    publishedTime?: Date
    modifiedTime?: Date
    /**
     * Page-level structured data, emitted alongside the sitewide TravelAgency
     * node rather than instead of it — a post is a BlogPosting published by
     * the same business.
     */
    pageSchema?: Record<string, unknown>
}

const {
    title,
    description,
    preloadImage,
    preloadImageSrcset,
    preloadImageSizes,
    ogType = 'website',
    publishedTime,
    modifiedTime,
    pageSchema,
} = Astro.props

// Astro.site comes from astro.config.mjs, so these are absolute in the build.
// The trailing slash is deliberate: every URL this site inherited from the old
// WordPress install had one, and the canonical has to agree with it.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const canonical = new URL(path, Astro.site).href

/*
 * One card for the whole site rather than a per-page photograph. It is the
 * only image in the unfurl that carries the wordmark, and a link to a post or
 * an itinerary is still a link to this operator — which the bare hero shot it
 * used to send did not say. Built by scripts/og-image.py; re-run that after
 * editing the file, and keep the alt text below describing what it renders.
 */
const OG_IMAGE = '/images/og-default.jpg'
const OG_IMAGE_ALT =
    'Guests and their guide at a sundowner under a baobab at sunset, with the Polecat Safaris wordmark and the line “Private, tailor-made safaris in Tanzania & Zanzibar”'
const ogImageUrl = new URL(OG_IMAGE, Astro.site).href

const schema = {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    name: SITE.legalName,
    alternateName: SITE.name,
    description: SITE.tagline,
    url: new URL('/', Astro.site).href,
    image: ogImageUrl,
    email: CONTACT.email,
    telephone: CONTACT.phone,
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Arusha',
        addressCountry: 'TZ',
    },
    // The only two places this operator sells. Zanzibar is a region of
    // Tanzania, not a country, so it is typed as one.
    areaServed: [
        { '@type': 'Country', name: 'Tanzania' },
        { '@type': 'AdministrativeArea', name: 'Zanzibar' },
    ],
    sameAs: Object.values(SOCIAL),
    aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: TRIPADVISOR.ratingValue,
        reviewCount: TRIPADVISOR.reviewCount,
        bestRating: 5,
    },
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content="index, follow, max-image-preview:large" />

        {/* Shared with the landing page — same brand, same mark. */}
        <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
        <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        {/* Only the weights the design actually uses: Cormorant Garamond 300
            for display headings and 400 for card titles, Karla 400/500. */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Karla:wght@400;500;600&display=swap"
        />

        {
            preloadImage && (
                <link
                    rel="preload"
                    as="image"
                    href={preloadImage}
                    imagesrcset={preloadImageSrcset}
                    imagesizes={preloadImageSizes}
                    fetchpriority="high"
                />
            )
        }

        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={SITE.legalName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        {/* Dimensions let a crawler lay the card out before it has the bytes. */}
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={OG_IMAGE_ALT} />
        <meta property="og:locale" content="en_GB" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
        {
            publishedTime && (
                <meta property="article:published_time" content={publishedTime.toISOString()} />
            )
        }
        {
            modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime.toISOString()} />
            )
        }

        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        {
            pageSchema && (
                <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
            )
        }
    </head>
    <body>
        <slot />
    </body>
</html>
