---
/**
 * The day-by-day band. Ported from ItineraryDays.astro in ~/web/kan_safaris:
 * every day is a rule-topped row with an oversized numeral in a fixed left
 * rail, the prose beside it, and a meta strip holding the same slots on every
 * day so they read down the page as columns.
 *
 * kan's meta strip is Meals / On the road / Elevation / Highlight. Nothing in
 * this site's data records drive times or altitudes, so the slots here are
 * Meals / Overnight / Highlight — the three it does record.
 *
 * kan sets each slot as a label stacked over its value in a fixed-width column,
 * so the slots line up down the page. That was ported and then dropped: the
 * columns were 186px, and the two values that are always there did not fit in
 * one — "Breakfast, lunch & dinner" and a camp name with its region ("Lion's
 * Paw by Karibu Camps, Ngorongoro Crater rim" is the longest at 49 characters)
 * both wrapped to two lines on every single day. The strip now runs the label
 * and its value on one line and lets each slot take the width it needs, which
 * costs the column alignment and buys a meta strip that is one line per fact.
 * Highlight is the long one (up to 79 characters) so it wraps to its own line
 * when the three together outrun the measure.
 *
 * The lodge photography (StayGallery) and the optional extras are this site's
 * own and have no counterpart in kan; they keep their place inside the day
 * body rather than being dropped to make the port tidier.
 */
import StayGallery from './StayGallery.astro'
import { findAccommodation } from '../content/accommodations'
import ZoneImage from './ZoneImage.astro'
import { createTrekZoneRotation } from '../content/trek-zones'
import { findAddon } from '../content/addons'
import type { DayExtra } from '../content/packages'
import type { SafariPackage } from '../content/packages'

/**
 * An "Optional today" row. A catalogue slug resolves to the add-on's name and
 * its price, duration and age limits; the day may override the price and add a
 * note of its own, which is how the operator's own itinerary wording survives.
 * A bare string is a one-off with no catalogue entry and no meta line.
 *
 * The meta line is deliberately three facts at most — how long, from how much,
 * who cannot do it. Everything else the client wrote about these fourteen
 * activities is at /safari-add-ons/, which the name links into.
 */
function resolveExtra(extra: DayExtra) {
    if (typeof extra === 'string') return { label: extra, meta: null, href: null }

    const addon = findAddon(extra.addon)
    const meta = [
        addon.duration,
        extra.price ?? (addon.price === 'On request' ? 'Price on request' : addon.price),
        addon.who,
    ].filter(Boolean)

    return {
        label: extra.note ? `${addon.name} — ${extra.note}` : addon.name,
        meta: meta.join(' · '),
        href: `/safari-add-ons/#${addon.slug}`,
    }
}

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props

/*
 * One rotation for this itinerary, so a climb that crosses the same band on
 * four days shows four different photographs of it. It counts as it goes, so
 * the day loop below must call it in order and only where a band is actually
 * shown. See src/content/trek-zones.ts.
 */
const nextZone = createTrekZoneRotation()
---

<section id="day-by-day" class="gutter scroll-mt-16 bg-white py-20 lg:py-25">
    <div class="shell flex flex-col">
        <div
            class="flex flex-col items-start justify-between gap-6 pb-13 lg:flex-row lg:items-end lg:gap-12"
        >
            <h2
                class="font-display max-w-175 text-[34px] leading-11 font-light tracking-[-0.016em] text-ink lg:text-[46px] lg:leading-14"
            >
                Day by day
            </h2>
            <p class="w-full max-w-100 text-[13px] leading-6 text-muted lg:text-right">
                Every day here is private — your own guide and your own vehicle — so the order holds
                but the hours are yours to move.
            </p>
        </div>

        {
            pkg.itinerary.map((day, index) => {
                const previous = index > 0 ? pkg.itinerary[index - 1] : null
                // Consecutive nights in one camp are marked "(Cont.)" rather than
                // restating the camp as if it were a new stay.
                const sameStay = previous != null && previous.overnight === day.overnight
                // The lodge's own photography, shown on the night you arrive at it
                // and not repeated for the nights that follow. Matched on the
                // property rather than the wording, so a camp written two ways
                // across consecutive days is still one stay.
                const stay = findAccommodation(day.overnight)
                const arriving =
                    stay != null && findAccommodation(previous?.overnight)?.slug !== stay.slug
                const showStay = arriving && stay != null && stay.images.length > 0

                /*
                 * A climb whose camp has no photography shows the band it
                 * walks through instead, off the day's own `Habitat` stat.
                 * Safari days never reach this: they have no `Habitat`.
                 * See src/content/trek-zones.ts.
                 *
                 * `nextZone` is stateful and counts what it has handed out,
                 * so it must be called once per day, in day order, and only
                 * on the days that will actually show a band — hence the
                 * guard here rather than inside it.
                 */
                const zone = showStay
                    ? undefined
                    : nextZone(day.stats?.find((stat) => stat.label === 'Habitat')?.value)

                return (
                    <article class="flex flex-col gap-7 border-t border-line py-13 md:flex-row md:gap-14">
                        <div class="flex shrink-0 flex-col gap-0.5 md:w-37.5">
                            <span class="text-[11px] leading-4 font-medium tracking-[0.24em] text-muted uppercase">
                                {day.label}
                            </span>
                            {/* A tint of `muted` rather than `line`: at this
                                size the hairline khaki was the one warm mark
                                on an otherwise neutral page. */}
                            <span class="font-display text-[58px] leading-16 font-light tracking-[-0.02em] text-muted/28">
                                {day.n < 10 ? `0${day.n}` : day.n}
                            </span>
                        </div>

                        <div class="flex min-w-0 flex-1 flex-col gap-6">
                            <h3 class="font-display text-[26px] leading-8.5 tracking-[-0.008em] text-ink lg:text-[29px] lg:leading-9.5">
                                {day.title}
                            </h3>

                            {day.paragraphs.map((paragraph) => (
                                <p class="text-[16px] leading-7.5 text-muted">{paragraph}</p>
                            ))}

                            {(day.stats?.length || day.meals || day.overnight || day.highlight) && (
                                <dl class="flex flex-col gap-3 py-1 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-10 sm:gap-y-3">
                                    {/* The climb figures — elevation, distance,
                                        hours, habitat — lead the row, because on
                                        a trek they are what the day is. */}
                                    {day.stats?.map((stat) => (
                                        <div class="flex items-baseline gap-2.5">
                                            <dt class="shrink-0 text-[10px] leading-3.5 font-medium tracking-[0.22em] text-muted/70 uppercase">
                                                {stat.label}
                                            </dt>
                                            <dd class="text-[14px] leading-5.5 text-ink">
                                                {stat.value}
                                            </dd>
                                        </div>
                                    ))}

                                    {day.meals && (
                                        <div class="flex items-baseline gap-2.5">
                                            <dt class="shrink-0 text-[10px] leading-3.5 font-medium tracking-[0.22em] text-muted/70 uppercase">
                                                Meals
                                            </dt>
                                            <dd class="text-[14px] leading-5.5 text-ink">
                                                {day.meals}
                                            </dd>
                                        </div>
                                    )}

                                    {day.overnight && (
                                        <div class="flex items-baseline gap-2.5">
                                            <dt class="shrink-0 text-[10px] leading-3.5 font-medium tracking-[0.22em] text-muted/70 uppercase">
                                                Overnight
                                            </dt>
                                            <dd
                                                class:list={[
                                                    'text-[14px] leading-5.5 text-ink',
                                                    sameStay && 'opacity-55',
                                                ]}
                                            >
                                                {day.overnight}
                                                {sameStay && (
                                                    <span class="ml-1.5 text-[12px] text-muted">
                                                        (Cont.)
                                                    </span>
                                                )}
                                            </dd>
                                        </div>
                                    )}

                                    {day.highlight && (
                                        <div class="flex min-w-0 items-baseline gap-2.5">
                                            <dt class="shrink-0 text-[10px] leading-3.5 font-medium tracking-[0.22em] text-muted/70 uppercase">
                                                Highlight
                                            </dt>
                                            <dd class="text-[14px] leading-5.5 font-medium text-ink">
                                                {day.highlight}
                                            </dd>
                                        </div>
                                    )}
                                </dl>
                            )}

                            {/* kan labels its stay block "Where you sleep".
                                StayGallery already captions itself over the
                                foot of the frame, so a label here would say it
                                twice. */}
                            {showStay && stay && (
                                <div class="pt-1.5">
                                    <StayGallery stay={stay} />
                                </div>
                            )}

                            {zone && (
                                <div class="pt-1.5">
                                    <ZoneImage label={zone.label} frame={zone.frame} />
                                </div>
                            )}

                            {day.optional && day.optional.length > 0 && (
                                <div class="flex flex-col gap-3.5 pt-1.5">
                                    <p class="text-[10px] leading-3.5 font-medium tracking-[0.24em] text-muted/70 uppercase">
                                        Optional today
                                    </p>
                                    <ul class="flex flex-col gap-3">
                                        {day.optional.map((extra) => {
                                            const { label, meta, href } = resolveExtra(extra)
                                            return (
                                                <li class="flex items-start gap-3">
                                                    <span
                                                        class="mt-0.5 text-[15px] leading-6 text-muted/60"
                                                        aria-hidden="true"
                                                    >
                                                        +
                                                    </span>
                                                    <div class="flex min-w-0 flex-col gap-0.5">
                                                        {href ? (
                                                            <a
                                                                href={href}
                                                                class="text-[15px] leading-6 text-ink underline decoration-line decoration-1 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
                                                            >
                                                                {label}
                                                            </a>
                                                        ) : (
                                                            <span class="text-[15px] leading-6 text-muted">
                                                                {label}
                                                            </span>
                                                        )}
                                                        {meta && (
                                                            <span class="text-[12.5px] leading-5 text-muted/80">
                                                                {meta}
                                                            </span>
                                                        )}
                                                    </div>
                                                </li>
                                            )
                                        })}
                                    </ul>
                                </div>
                            )}
                        </div>
                    </article>
                )
            })
        }
    </div>
</section>
