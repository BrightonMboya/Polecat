---
/**
 * The band at the foot of an itinerary that asks for the enquiry.
 *
 * It used to be a form. It posted straight to Web3Forms with four fields of
 * its own, which meant the site had two enquiry forms that asked different
 * questions and arrived in the same inbox looking like different businesses.
 * The client asked for one funnel, so this band now hands over to /enquire/
 * with the itinerary named in the query string: the planner opens knowing
 * which journey this is, says so on screen, and carries the page's URL into
 * the email. See the `itineraries` map in src/pages/enquire.astro.
 *
 * The id stays `enquire` — it is a published anchor, the old CTAs pointed at
 * it and someone will have a link to it — and the direct channels stay here
 * too, because plenty of people would rather ring Arusha than answer four
 * questions.
 */
import type { SafariPackage } from '../content/packages'
import { CONTACT, whatsappLink } from '../config'

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props

const whatsapp = whatsappLink(`Hello Polecat Safaris, I'm interested in the ${pkg.name}.`)
const planner = `/enquire/?itinerary=${pkg.slug}`
---

<section id="enquire" class="gutter scroll-mt-16 bg-primary py-20 lg:py-25">
    <div class="shell grid grid-cols-1 gap-10 lg:grid-cols-[1fr_24rem] lg:items-center lg:gap-20">
        <div class="flex flex-col gap-5">
            <h2
                class="font-display max-w-160 text-[30px] leading-10 font-light tracking-[-0.014em] text-white lg:text-[38px] lg:leading-12"
            >
                Travel this one
            </h2>
            <p class="max-w-160 text-[15px] leading-7 text-sage">
                Four questions — what you'd like to see, who is coming and roughly when — and the
                team in Arusha comes back with dates, the camps that are open and what the {
                    pkg.days
                }-day rate looks like for your party. We reply within one working day.
            </p>
            <p class="text-[14px] leading-6 text-sage-dim">
                Or reach them directly — <a
                    href={CONTACT.phoneHref}
                    class="text-gold underline underline-offset-3">{CONTACT.phone}</a
                > or <a
                    href={whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gold underline underline-offset-3">WhatsApp</a
                >.
            </p>
        </div>

        <div class="flex flex-col items-start gap-4">
            <a
                href={planner}
                class="flex w-full items-center justify-center bg-white px-9 py-4.5 text-center text-[12px] leading-4 font-medium tracking-[0.18em] text-primary uppercase transition-colors hover:bg-cream"
            >
                Enquire About This Journey
            </a>
            <p class="text-[13px] leading-5.5 text-sage-dim">
                It opens with this itinerary and its {pkg.days} days already filled in.
            </p>
        </div>
    </div>
</section>
