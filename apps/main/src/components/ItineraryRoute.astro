---
/**
 * The route band: a heading with the destinations ranged right, and the
 * MapLibre map (see RouteMap.astro) under it.
 *
 * It used to carry a horizontal strip of stops below the map — one slot per
 * place with its days above its name, ported from ItineraryRoute.astro in
 * ~/web/kan_safaris. That was removed by request. Nothing is lost with it:
 * the same days and places are set out in full in the day-by-day section
 * immediately below, and the map still carries the stops as pins.
 */
import RouteMap from './RouteMap.astro'
import type { SafariPackage } from '../content/packages'

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props
---

<section id="route" class="gutter scroll-mt-16 bg-stone py-19 lg:py-20.5">
    <div class="shell flex flex-col gap-10">
        <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12">
            <h2
                class="font-display max-w-140 text-[28px] leading-9 font-light tracking-[-0.014em] text-ink lg:text-[34px] lg:leading-10.5"
            >
                The route, and how far apart these places are
            </h2>
            <p class="w-full max-w-105 text-[13px] leading-6 text-muted lg:text-right">
                {pkg.destinations.join(' · ')}
            </p>
        </div>

        {/* The map is square by default, which is right for the sidebar it was
            drawn for and far too tall across a full-width band. Flatter again
            from `lg`, where the shell is wide enough that 2:1 ran to two
            thirds of the viewport. Tailwind v4 takes the important marker as
            a suffix. */}
        <RouteMap route={pkg.route} class="aspect-[2/1]! lg:aspect-[5/2]!" />
    </div>
</section>
