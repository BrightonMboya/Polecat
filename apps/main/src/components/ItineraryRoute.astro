---
/**
 * The route band. Ported from ItineraryRoute.astro in ~/web/kan_safaris — a
 * heading with a note ranged right, then the stops as equal-width slots under
 * a rule, each holding its days and its place on one horizontal lane.
 *
 * kan has only the strip. The MapLibre map this site already draws (see
 * RouteMap.astro) sits above it rather than being thrown away: the strip says
 * how long you spend where, the map says how far apart those places are.
 *
 * kan's stops carry a line of prose each. Nothing in this site's data says
 * anything about a stop beyond its name and its days, so the slots run without
 * one rather than inventing copy for ten itineraries.
 */
import RouteMap from './RouteMap.astro'
import type { SafariPackage } from '../content/packages'

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props

/* The strip lists the places you sleep, in order — the start and end airports
   are on the map but are not stops on the journey. */
const stops = pkg.route.points
---

<section id="route" class="gutter scroll-mt-16 bg-stone py-19 lg:py-20.5">
    <div class="shell flex flex-col gap-11">
        <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end lg:gap-12">
            <h2
                class="font-display max-w-140 text-[28px] leading-9 font-light tracking-[-0.014em] text-ink lg:text-[34px] lg:leading-10.5"
            >
                The route, and how long you spend on each part of it
            </h2>
            <p class="w-full max-w-105 text-[13px] leading-6 text-muted lg:text-right">
                {pkg.destinations.join(' · ')}
            </p>
        </div>

        {/* The map is square by default, which is right for the sidebar it was
            drawn for and far too tall across a full-width band. Tailwind v4
            takes the important marker as a suffix. */}
        <RouteMap route={pkg.route} class="aspect-[2/1]!" />

        {
            stops.length > 0 && (
                <ol class="flex flex-col border-t border-line-dark/40 sm:flex-row">
                    {stops.map((stop) => (
                        <li class="flex min-w-0 flex-1 flex-col gap-2.25 border-line-dark/25 py-6.5 max-sm:border-t max-sm:first:border-t-0 sm:border-l sm:px-5 sm:first:border-l-0 sm:first:pl-0 sm:last:pr-0">
                            {stop.label && (
                                <p class="text-[11px] leading-3.5 font-medium tracking-[0.22em] text-muted uppercase">
                                    {stop.label}
                                </p>
                            )}
                            <p class="font-display text-[21px] leading-7 text-ink">{stop.name}</p>
                        </li>
                    ))}
                </ol>
            )
        }
    </div>
</section>
