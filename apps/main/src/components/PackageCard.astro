---
/**
 * One safari package card. Used by the homepage section and by the
 * /safari-packages index, so the two can't drift apart.
 */
import type { SafariPackage } from '../content/packages'

interface Props {
    pkg: SafariPackage
    /** Index pages load below the fold; the homepage section does too. */
    loading?: 'lazy' | 'eager'
    /**
     * The homepage renders all ten cards and hides the four that aren't
     * featured, so its route filter has something to reveal.
     */
    hidden?: boolean
    /**
     * Where the card sits in the page's outline. The homepage section and
     * /kilimanjaro put these straight under their own <h2>, so 3 is right.
     * /safari-packages groups them under a labelled <h3> per product line,
     * and a card under that is a level deeper.
     */
    headingLevel?: 3 | 4
}

const { pkg, loading = 'lazy', hidden = false, headingLevel = 3 } = Astro.props
const Heading = `h${headingLevel}` as 'h3' | 'h4'

/*
 * The card's own width, so the browser takes the 900w file rather than the
 * hero-sized one. Three columns inside the 1336px shell with a 26px gap is
 * the 428px the aspect ratio above is named for; below that the grid is two
 * columns and then one, each a share of the viewport less the gutter.
 */
const SIZES =
    '(min-width: 1440px) 428px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, calc(100vw - 48px)'
---

<li
    class="flex flex-col border border-line bg-white"
    hidden={hidden}
    data-routes={pkg.routes.join(' ')}
    data-featured={pkg.featured ? 'true' : 'false'}
>
    <a href={`/safari-packages/${pkg.slug}`} class="group flex flex-1 flex-col">
        <div class="overflow-hidden">
            <img
                src={pkg.image}
                srcset={pkg.imageSrcset}
                sizes={SIZES}
                alt={pkg.imageAlt}
                loading={loading}
                decoding="async"
                class="aspect-[428/306] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
        </div>
        <div class="flex flex-1 flex-col items-start gap-2.5 px-6 pt-6.5 pb-7.5">
            <p class="text-[11px] leading-3.5 tracking-[0.16em] text-primary uppercase">
                {pkg.region}
            </p>
            <Heading class="font-display text-[27px] leading-8.5 text-ink">
                {pkg.name}
            </Heading>
            <p class="flex flex-wrap items-center gap-2.5 pt-1.5 text-[13px] leading-4 text-muted">
                <span>{pkg.duration}</span>
                <span class="h-3 w-px shrink-0 bg-line" aria-hidden="true"></span>
                <span>{pkg.price}</span>
            </p>
        </div>
    </a>
</li>
