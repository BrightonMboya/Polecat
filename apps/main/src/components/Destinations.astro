---
/**
 * "Tanzania, and beyond" — one tall photo card per country, after the "Beyond
 * Tanzania" cards on the King Mufasa site: the country name set large over the
 * foot of the photograph, a line of what it holds, and a way in. Three across
 * at 4:5 rather than Mufasa's two, which the client found too large.
 *
 * Copy, photographs and links: DESTINATIONS in src/content/home.ts.
 */
import SectionHeading from './SectionHeading.astro'
import { DESTINATIONS } from '../content/home'

/*
 * The scrim is the background of the text block, not of the card: 0.64 under
 * the type, fading to nothing over the 4rem above it, so the rest of the
 * photograph shows at full colour. White 15px copy over a pure white pixel
 * needs 0.61 for 4.5:1, so 0.64 holds whatever the photograph does.
 */
const SCRIM =
    'background: linear-gradient(0deg, rgba(35,32,27,0.64) 0%, rgba(35,32,27,0.64) calc(100% - 4rem), rgba(35,32,27,0) 100%)'
---

<section class="gutter flex flex-col items-center bg-white py-18 lg:py-24">
    <SectionHeading eyebrow={DESTINATIONS.eyebrow} heading={DESTINATIONS.heading} body={DESTINATIONS.body} />

    <ul class="shell mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3 lg:mt-12 lg:gap-5">
        {
            DESTINATIONS.items.map((country) => (
                <li>
                    <a href={country.href} class="group relative block aspect-[4/5] overflow-hidden bg-ink">
                        <img
                            src={country.image}
                            alt={country.imageAlt}
                            width="800"
                            height="1000"
                            loading="lazy"
                            decoding="async"
                            class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        />
                        <div class="absolute inset-x-0 bottom-0 flex flex-col gap-2.5 px-6 pt-16 pb-6 text-white lg:px-7 lg:pb-7" style={SCRIM}>
                            <h3 class="font-display text-[40px] leading-none font-light lg:text-[48px]">
                                {country.name}
                            </h3>
                            {/* One line on every card, kept short in DESTINATIONS, so the
                                names line up across the row and the line sits close over
                                the link. */}
                            <p class="text-[15px] leading-6">{country.line}</p>
                            <div class="mt-1">
                                <span class="inline-flex items-center gap-2 text-[12px] leading-4 font-medium tracking-[0.18em] uppercase">
                                    {country.cta}
                                    <svg
                                        viewBox="0 0 14 10"
                                        fill="none"
                                        class="h-2.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
                                        aria-hidden="true"
                                    >
                                        <path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</section>
