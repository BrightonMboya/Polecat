---
/**
 * The head of an itinerary page. Ported from ItineraryHero.astro in
 * ~/web/kan_safaris: a fixed-height frame rather than a viewport-height one,
 * the content sitting on the floor of it, with the title on the left and the
 * two facts a visitor actually shops on — how long, how much — ranged right,
 * as bare figures with no label above them.
 *
 * Written in this site's tokens and type rather than kan's stone palette.
 */
import type { SafariPackage } from '../content/packages'

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props

// One itinerary has no published rate yet. "From On request" reads wrong, so
// that one loses the "From" label and the per-person unit.
const onRequest = pkg.priceFrom === 'On request'

// Most of these photographs sit well a little below centre; two do not. See
// `imageFocus` in src/content/packages.ts.
const focus = pkg.imageFocus ?? '50% 55%'
---

<section class="relative flex h-115 w-full flex-col justify-end overflow-hidden bg-ink lg:h-150">
    <img
        src={pkg.image}
        srcset={pkg.imageSrcset}
        sizes="100vw"
        alt={pkg.imageAlt}
        class="absolute inset-0 size-full object-cover"
        style={`object-position: ${focus}`}
        fetchpriority="high"
        decoding="async"
    />
    {/* Scrim, measured by scripts/itinerary-scrim.py against all fifteen
        photographs. Run it again after adding a package, re-cropping one of
        these frames or changing an `imageFocus`.

        This hero carries type at both ends — a breadcrumb along the top, the
        title and the facts along the floor — and it used to meet that with
        one ramp that opened at 0.30 and was still at 0.34 halfway down. That
        put a flat 30% of ink over the whole photograph: the same frame
        arrived here about a third darker and a third less saturated than it
        does on its own card, which is exactly what it looked like.

        So the ink is at the two ends and the middle is left to the
        photograph. The top band is only as deep as the breadcrumb needs and
        is gone by a quarter of the way down; the foot is heavier than it was,
        because the old ramp did not in fact clear AA for the gold eyebrow or
        the sage units beside the figures over a blown-out sky. */}
    <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(35,32,27,0.66) 0%, rgba(35,32,27,0.62) 9%, rgba(35,32,27,0.26) 16%, rgba(35,32,27,0.05) 24%, rgba(35,32,27,0.05) 50%, rgba(35,32,27,0.30) 62%, rgba(35,32,27,0.76) 71%, rgba(35,32,27,0.82) 84%, rgba(35,32,27,0.88) 100%)"
        aria-hidden="true"
    >
    </div>

    <nav
        class="gutter absolute inset-x-0 top-0 z-10 flex items-center gap-2.5 pt-9 text-[11px] tracking-[0.18em] text-white uppercase"
        aria-label="Breadcrumb"
    >
        <a href="/" class="transition-colors hover:text-gold">Home</a>
        <span class="text-white/60" aria-hidden="true">/</span>
        <a href="/safari-packages/" class="transition-colors hover:text-gold">Safari Packages</a>
    </nav>

    <div
        class="gutter relative flex w-full flex-col items-start justify-between gap-8 pb-13 lg:flex-row lg:items-end lg:gap-16"
    >
        <div class="flex max-w-190 flex-col gap-4.5">
            <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-gold uppercase">
                {pkg.category}
            </p>
            <h1
                class="font-display text-[34px] leading-10.5 font-light tracking-[-0.018em] text-white sm:text-[46px] sm:leading-14 lg:text-[66px] lg:leading-19"
            >
                {pkg.name}
            </h1>
        </div>

        {/* The "Duration" and "From" eyebrows are gone from the frame; the
            terms stay in the markup, visually hidden, so a screen reader still
            hears what each figure is and the list stays a valid <dl>. Both
            labels — and the nights — are written out in full in the trip
            summary in the overview directly below. */}
        <dl class="flex shrink-0 items-end gap-10">
            <div>
                <dt class="sr-only">Duration</dt>
                <dd class="font-display text-[30px] leading-8.5 font-light text-white">
                    {pkg.days}
                    <span class="ml-1.5 text-[12px] font-medium tracking-[0.14em] text-sage uppercase">
                        Days
                    </span>
                </dd>
            </div>

            <span class="h-8 w-px shrink-0 bg-white/30" aria-hidden="true"></span>

            <div>
                <dt class="sr-only">{onRequest ? 'Rate' : 'From'}</dt>
                <dd class="font-display flex items-baseline gap-2 text-[30px] leading-8.5 font-light text-white">
                    {pkg.priceFrom}
                    {
                        !onRequest && (
                            <span class="text-[12px] font-medium tracking-[0.14em] text-sage uppercase">
                                per person
                            </span>
                        )
                    }
                </dd>
            </div>
        </dl>
    </div>
</section>
