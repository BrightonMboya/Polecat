---
/**
 * The homepage journal strip: the newest post at half width, the next three
 * stacked beside it. Reads the migrated WordPress posts straight out of the
 * collection, so publishing a post is the only thing needed to change it.
 */
import { JOURNAL } from '../content/home'
import { categoryLabel, formatDate, getPosts, isoDate, primaryCategory } from '../content/journal'

const posts = await getPosts()
const [lead, ...rest] = posts.slice(0, 4)
---

{/* An empty collection is not a broken homepage: a dev server started
    before the content config existed sees no posts, and there is simply
    no strip to draw. */}
{
    lead && (
    <section class="gutter flex flex-col items-center bg-white pt-20 pb-20 lg:pt-26.5 lg:pb-28">
        <div class="shell flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col gap-3">
                <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase">
                    {JOURNAL.eyebrow}
                </p>
                <h2
                    class="font-display text-[34px] leading-[1.22] font-light text-ink lg:text-[44px] lg:leading-14"
                >
                    {JOURNAL.heading}
                </h2>
            </div>
            <a
                href={JOURNAL.cta.href}
                class="rule-link pb-3.5 text-[12px] leading-4 font-medium tracking-[0.2em] text-primary uppercase"
            >
                {JOURNAL.cta.label}
            </a>
        </div>

        {/* Lead story at half width, three stacked briefs in the other half. */}
        <div class="shell mt-10 flex flex-col gap-10 lg:mt-11 lg:flex-row lg:gap-6.5">
            <article class="flex flex-col lg:w-1/2">
                <a href={`/${lead.id}/`} class="group flex flex-col">
                    {
                        lead.data.heroImage && (
                            <div class="overflow-hidden">
                                <img
                                    src={lead.data.heroImage}
                                    alt={lead.data.heroImageAlt || ''}
                                    loading="lazy"
                                    decoding="async"
                                    class="aspect-[656/420] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                                />
                            </div>
                        )
                    }
                    <div class="flex flex-col items-start gap-3.5 pt-6.5">
                        <p class="flex items-center gap-2.5">
                            <span class="text-[11px] leading-3.5 tracking-[0.16em] text-primary uppercase"
                                >{categoryLabel(primaryCategory(lead))}</span
                            >
                            <span class="h-2.75 w-px shrink-0 bg-line" aria-hidden="true"></span>
                            <time
                                datetime={isoDate(lead.data.pubDate)}
                                class="text-[12px] leading-3.5 text-muted">{formatDate(lead.data.pubDate)}</time
                            >
                        </p>
                        <h3
                            class="font-display max-w-150 text-[28px] leading-[1.28] font-light text-ink lg:text-[34px] lg:leading-11"
                        >
                            {lead.data.title}
                        </h3>
                        <p class="max-w-140 text-[16px] leading-7.25 text-muted">
                            {lead.data.description}
                        </p>
                    </div>
                </a>
            </article>

            <div class="flex flex-col lg:w-1/2">
                {
                    rest.map((post, index) => (
                        <article
                            class:list={[
                                'border-line',
                                index === 0 && 'pb-7.5 border-b',
                                index === 1 && 'py-7.5 border-b',
                                index === 2 && 'pt-7.5',
                            ]}
                        >
                            <a href={`/${post.id}/`} class="group flex gap-6">
                                {post.data.heroImage && (
                                    <div class="w-30 shrink-0 overflow-hidden sm:w-50">
                                        <img
                                            src={post.data.heroImage}
                                            alt={post.data.heroImageAlt || ''}
                                            loading="lazy"
                                            decoding="async"
                                            class="aspect-[200/150] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                                        />
                                    </div>
                                )}
                                <div class="flex flex-col items-start gap-2.5 pt-0.5">
                                    <p class="flex items-center gap-2.5">
                                        <span class="text-[11px] leading-3.5 tracking-[0.16em] text-primary uppercase">
                                            {categoryLabel(primaryCategory(post))}
                                        </span>
                                        <span class="h-2.75 w-px shrink-0 bg-line" aria-hidden="true" />
                                        <time
                                            datetime={isoDate(post.data.pubDate)}
                                            class="text-[12px] leading-3.5 text-muted"
                                        >
                                            {formatDate(post.data.pubDate)}
                                        </time>
                                    </p>
                                    <h3 class="font-display text-[22px] leading-[1.3] font-light text-ink lg:text-[25px] lg:leading-8.25">
                                        {post.data.title}
                                    </h3>
                                    <p class="text-[14px] leading-6 text-muted">
                                        {post.data.description}
                                    </p>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
    )
}
