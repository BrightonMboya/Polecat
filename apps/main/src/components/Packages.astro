---
/**
 * The itineraries section: the six featured cards. The pills above them are
 * plain links to /safari-packages/#<route>, which that page reads to show
 * only the itineraries on that route.
 */
import SectionHeading from './SectionHeading.astro'
import PackageCard from './PackageCard.astro'
import { PACKAGES } from '../content/home'
import { ROUTE_LABELS, routeHref, type RouteTag } from '../content/packages'

const routes = Object.keys(ROUTE_LABELS) as RouteTag[]
---

<section
    id="safari-packages"
    class="gutter flex scroll-mt-8 flex-col items-center bg-cream pt-20 pb-20 lg:pt-27 lg:pb-28.5"
>
    <SectionHeading heading={PACKAGES.heading} body={PACKAGES.body} />

    <nav
        class="flex flex-wrap items-center justify-center gap-2.5 pt-8 lg:pt-9"
        aria-label="Browse itineraries by route"
    >
        <a
            href="/safari-packages/"
            class="border border-primary bg-primary px-5 py-2.5 text-[11px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-transparent hover:text-primary"
        >
            All Itineraries
        </a>
        {
            routes.map((route) => (
                <a href={routeHref(route)} class="border border-line px-5 py-2.5 text-[11px] leading-4 font-medium tracking-[0.18em] text-muted uppercase transition-colors hover:border-primary hover:text-primary">
                    {ROUTE_LABELS[route]}
                </a>
            ))
        }
    </nav>

    <ul
        class="shell mt-10 grid grid-cols-1 gap-6.5 sm:grid-cols-2 lg:mt-11.5 lg:grid-cols-3"
    >
        {PACKAGES.items.map((pkg) => <PackageCard pkg={pkg} />)}
    </ul>

    <div class="flex w-full justify-center pt-11 lg:pt-14.5">
        <a
            href={PACKAGES.cta.href}
            class="flex items-center justify-center border border-primary px-9 py-4 text-[12px] leading-4 font-medium tracking-[0.2em] text-primary uppercase transition-colors hover:bg-primary hover:text-white"
        >
            {PACKAGES.cta.label}
        </a>
    </div>
</section>
