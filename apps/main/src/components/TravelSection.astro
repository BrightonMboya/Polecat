---
/**
 * One section of /travel-information/ — heading and standfirst in a left rail,
 * the section's blocks beside it, in the same two-column measure as the
 * itinerary pages' "What the rate covers".
 *
 * The rail sticks while a long section scrolls past, which is the whole reason
 * the copy is not one column: in a guide this long you want to be able to look
 * up from a list of nineteen toiletries and see which list it is.
 *
 * Sections sit inside a chapter band now rather than carrying a ground of
 * their own, so the chapter passes `surface` — the colour notes and cards need
 * in order not to disappear into whatever the chapter is standing on — and
 * `first`, which suppresses the rule above the section that opens a chapter.
 */
import type { TravelSection } from '../content/travel-info'

interface Props {
    section: TravelSection
    /** The chapter's ground. Notes and cards take the other one. */
    ground: 'white' | 'cream' | 'stone'
    first?: boolean
}

const { section, ground, first = false } = Astro.props

/** Notes and cards need a surface that is not the ground they sit on. */
const surface = ground === 'white' ? 'bg-stone' : 'bg-white'

const eyebrow =
    'text-[11px] leading-3.5 font-medium tracking-[0.22em] text-primary uppercase'
---

<section
    id={section.id}
    class:list={[
        'scroll-mt-8',
        first ? 'pt-2' : 'mt-14 border-t border-line pt-14 lg:mt-16 lg:pt-16',
    ]}
>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[19rem_1fr] lg:gap-16 xl:gap-20">
        <div class="flex flex-col gap-4 lg:sticky lg:top-14 lg:self-start">
            <h3
                class="font-display text-[28px] leading-9 font-light tracking-[-0.014em] text-ink lg:text-[34px] lg:leading-10.5"
            >
                {section.heading}
            </h3>
            {
                section.standfirst && (
                    <p class="text-[15px] leading-7 text-muted">{section.standfirst}</p>
                )
            }
        </div>

        <div class="flex max-w-220 flex-col gap-6.5">
            {
                section.blocks.map((block, blockIndex) => (
                    <>
                        {block.type === 'text' && (
                            <p class="text-[16px] leading-7.5 text-muted">{block.body}</p>
                        )}

                        {block.type === 'sub' && (
                            <div class:list={['flex flex-col gap-3', blockIndex > 0 && 'pt-3']}>
                                <h4 class="font-display text-[23px] leading-8 text-ink lg:text-[25px]">
                                    {block.heading}
                                </h4>
                                {block.body?.map((paragraph) => (
                                    <p class="text-[16px] leading-7.5 text-muted">{paragraph}</p>
                                ))}
                            </div>
                        )}

                        {block.type === 'list' && (
                            <div class="flex flex-col gap-4">
                                {block.label && <p class={eyebrow}>{block.label}</p>}
                                <ul
                                    class:list={[
                                        'grid grid-cols-1 gap-x-10 gap-y-3',
                                        block.columns === 2 && 'sm:grid-cols-2',
                                    ]}
                                >
                                    {block.items.map((item) => (
                                        <li class="flex items-start gap-3.5 text-[15px] leading-6.75 text-muted">
                                            {/* The hairline the journal bodies
                                                use instead of a bullet. */}
                                            <span
                                                class="mt-3.25 h-px w-3 shrink-0 bg-primary"
                                                aria-hidden="true"
                                            />
                                            <span class="min-w-0">{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                        {block.type === 'note' && (
                            <aside
                                class:list={[
                                    'flex flex-col gap-2.5 border-t-2 border-primary px-6 pt-5.5 pb-6.5 lg:px-7',
                                    surface,
                                ]}
                            >
                                <p class={eyebrow}>{block.label}</p>
                                <p class="text-[15px] leading-7 text-muted">{block.body}</p>
                            </aside>
                        )}

                        {block.type === 'cards' && (
                            <ul class="grid grid-cols-1 gap-5.5 sm:grid-cols-2">
                                {block.items.map((card) => (
                                    <li
                                        class:list={[
                                            'flex flex-col gap-3 border-t-2 border-primary px-6 pt-6 pb-7 lg:px-7',
                                            surface,
                                        ]}
                                    >
                                        <h4 class="font-display text-[22px] leading-7.5 text-ink">
                                            {card.heading}
                                        </h4>
                                        <p class="text-[15px] leading-6.75 text-muted">
                                            {card.body}
                                        </p>
                                    </li>
                                ))}
                            </ul>
                        )}

                        {block.type === 'steps' && (
                            <ol class="grid grid-cols-1 gap-x-10 gap-y-7 sm:grid-cols-2">
                                {block.items.map((step, stepIndex) => (
                                    <li class="flex items-start gap-4">
                                        <span
                                            class="font-display mt-0.5 text-[20px] leading-6 text-primary tabular-nums"
                                            aria-hidden="true"
                                        >
                                            {String(stepIndex + 1).padStart(2, '0')}
                                        </span>
                                        <div class="flex min-w-0 flex-col gap-1.5">
                                            <h4 class="text-[15px] leading-6 font-medium text-ink">
                                                {step.heading}
                                            </h4>
                                            <p class="text-[15px] leading-6.75 text-muted">
                                                {step.body}
                                            </p>
                                        </div>
                                    </li>
                                ))}
                            </ol>
                        )}

                        {block.type === 'table' && (
                            <div class="flex flex-col gap-4">
                                {block.label && <p class={eyebrow}>{block.label}</p>}
                                {/* Wide on a phone, so it scrolls in its own
                                    box rather than the page — same treatment
                                    the journal tables get in global.css. */}
                                <div class="overflow-x-auto">
                                    <table class="w-full border-collapse text-[15px] leading-6">
                                        <thead>
                                            <tr>
                                                {block.columns.map((column) => (
                                                    <th
                                                        scope="col"
                                                        class:list={[
                                                            'border border-line px-4 py-3.5 text-left align-top font-medium text-ink',
                                                            surface,
                                                        ]}
                                                    >
                                                        {column}
                                                    </th>
                                                ))}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {block.rows.map((row) => (
                                                <tr>
                                                    {row.map((cell, cellIndex) => (
                                                        <td
                                                            class:list={[
                                                                'border border-line px-4 py-3.5 align-top whitespace-nowrap',
                                                                cellIndex === 0
                                                                    ? 'text-ink'
                                                                    : 'text-muted',
                                                            ]}
                                                        >
                                                            {cell}
                                                        </td>
                                                    ))}
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        )}
                    </>
                ))
            }
        </div>
    </div>
</section>
