---
interface Props {
    /** Whole stars to draw. The design uses five gold stars, no half states. */
    count?: number
}

const { count = 5 } = Astro.props
const STAR = 'M8 1l2.06 4.3 4.69.63-3.42 3.3.85 4.68L8 11.68 3.82 13.9l.85-4.67L1.25 5.93l4.69-.63z'
---

<svg
    width={count * 18 - 2}
    height="16"
    viewBox={`0 0 ${count * 18 - 2} 16`}
    xmlns="http://www.w3.org/2000/svg"
    class="shrink-0"
    aria-hidden="true"
>
    {Array.from({ length: count }, (_, i) => <path d={STAR} fill="var(--color-gold)" transform={`translate(${i * 18} 0)`} />)}
</svg>
