---
/**
 * The overview band. Ported from ItineraryOverview.astro in ~/web/kan_safaris:
 * the prose and its facts on the left, a price rail on the right carrying the
 * rate, the price breakdown and the way to start a conversation.
 *
 * kan's rail offers an itinerary PDF beside the enquiry button. There is no
 * PDF to link to here, so the rail carries the phone number instead — the
 * operator answers it, and the design leaves room for a second affordance.
 */
import type { SafariPackage } from '../content/packages'
import { CONTACT } from '../config'

interface Props {
    pkg: SafariPackage
}

const { pkg } = Astro.props

const onRequest = pkg.priceFrom === 'On request'

/* The same five figures the old sticky sidebar carried, in kan's fact grid. */
const facts: [string, string][] = [
    ['Duration', `${pkg.days} days, ${pkg.nights} nights`],
    ['Destination', pkg.region],
    ['Stops', String(pkg.destinations.length)],
    ['Experience', pkg.category],
    ['Best time', pkg.bestTime],
]
---

<section id="overview" class="gutter scroll-mt-16 bg-white py-20 lg:py-26">
    <div class="shell grid grid-cols-1 gap-14 lg:grid-cols-[1fr_23rem] lg:gap-16 xl:grid-cols-[1fr_25rem]">
        <div class="flex flex-col items-start gap-7">
            <p class="text-[11px] leading-3.5 font-medium tracking-[0.28em] text-primary uppercase">
                Overview
            </p>

            <h2
                class="font-display max-w-3xl text-[30px] leading-10 font-light text-ink lg:text-[38px] lg:leading-12"
            >
                {pkg.summary}
            </h2>

            {
                pkg.highlights.length > 0 && (
                    <ul class="flex max-w-3xl flex-col gap-3.5 pt-1">
                        {pkg.highlights.map((line) => (
                            <li class="flex items-start gap-3.5 text-[16px] leading-7.25 text-muted">
                                <span
                                    class="mt-3.5 h-px w-3 shrink-0 bg-primary"
                                    aria-hidden="true"
                                />
                                {line}
                            </li>
                        ))}
                    </ul>
                )
            }

            <dl
                class="mt-3 grid w-full grid-cols-2 gap-x-8 gap-y-7 border-t border-line pt-9 sm:grid-cols-3"
            >
                {
                    facts.map(([term, value]) => (
                        <div class="flex flex-col gap-2">
                            <dt class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                                {term}
                            </dt>
                            <dd class="font-display text-[19px] leading-6.5 text-ink italic">
                                {value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Price and enquiry">
            <div class="border border-line bg-stone p-7 lg:p-8">
                <p class="text-[10px] leading-3 font-medium tracking-[0.2em] text-muted/70 uppercase">
                    {onRequest ? 'Rate' : 'From, per person sharing'}
                </p>
                <p class="font-display mt-3 text-[34px] leading-10 font-light text-ink">
                    {pkg.priceFrom}
                </p>
                <p class="mt-1.5 text-[12px] leading-4.5 text-muted">
                    {pkg.priceNote ?? pkg.priceUnit}
                </p>

                {
                    pkg.priceLines.length > 0 && (
                        <dl class="mt-7 flex flex-col gap-3 border-t border-line pt-7 text-[13px] leading-5">
                            {pkg.priceLines.map((line) => (
                                <div class="flex items-baseline justify-between gap-4">
                                    <dt class="text-muted/80">{line.label}</dt>
                                    <dd class="text-right font-medium text-ink">{line.amount}</dd>
                                </div>
                            ))}
                        </dl>
                    )
                }

                <div class="mt-8 flex flex-col gap-3">
                    <a
                        href="#enquire"
                        class="flex items-center justify-center bg-primary px-7 py-4 text-center text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-[#083329]"
                    >
                        Request This Journey
                    </a>
                    <a
                        href={CONTACT.phoneHref}
                        class="flex items-center justify-center border border-primary px-7 py-4 text-center text-[12px] leading-4 font-medium tracking-[0.18em] text-primary uppercase transition-colors hover:bg-primary hover:text-white"
                    >
                        Call {CONTACT.phone}
                    </a>
                </div>
            </div>
        </aside>
    </div>
</section>
