---
import Wordmark from './Wordmark.astro'
import { NAV } from '../content/home'

/*
 * Travel Information, Journal, About Us and the Enquire button. Four plain
 * links, no hamburger and no dropdown: the design's mobile panel duplicated
 * the footer sitemap, and with a nav this small there is nothing worth hiding
 * behind a toggle.
 *
 * The Journeys menu that used to sit first — a <details>/<summary> splitting
 * the catalogue into safaris and the mountain — went with this change, along
 * with the script that opened it on hover. /safari-packages/ and
 * /kilimanjaro/ are reached from the footer and from the homepage's own
 * sections now. Restoring the menu means restoring that block from the
 * history; it is not kept here commented out.
 */
const current = Astro.url.pathname

/** `/about` and `/about/` are the same page; the trailing slash is canonical. */
const isCurrent = (href: string) =>
    href !== '/' && current.replace(/\/?$/, '/').startsWith(href)

const LINK_CLASS =
    'text-[11px] leading-4 tracking-[0.14em] whitespace-nowrap text-ink uppercase transition-colors hover:text-primary aria-[current=page]:text-primary sm:text-[12px] sm:tracking-[0.18em]'
---

<header class="border-b border-line bg-cream">
    {/* The bar is one row from `lg` and two below it — the wordmark, then the
        nav under it.

        That switch used to be at `sm`, and "Travel Information" is what moved
        it. Measured in Karla at the sizes below rather than guessed: the four
        items come to 490px at `sm` sizes against 398px for the Journeys /
        Blog / About Us row they replace, and with the 199px wordmark and the
        gap the row wants 705px. A 768px viewport only clears 688px of it. So
        the single row starts at `lg`, where there is 920px and room to spare,
        and below that the nav takes its own row and wraps within it — three
        honest rows on a 320px phone beat one that scrolls sideways. */}
    <div
        class="shell gutter flex flex-col items-start gap-3.5 py-4 lg:flex-row lg:items-center lg:justify-between lg:gap-4 lg:py-6.5"
    >
        <Wordmark size="header" />

        <nav
            class="flex w-full flex-wrap items-center gap-x-5 gap-y-3 lg:w-auto lg:flex-nowrap lg:justify-end lg:gap-8.5"
            aria-label="Primary"
        >
            {
                NAV.primary.map((link) => (
                    <a
                        href={link.href}
                        aria-current={isCurrent(link.href) ? 'page' : undefined}
                        class={LINK_CLASS}
                    >
                        {link.label}
                    </a>
                ))
            }
            <a
                href={NAV.enquire.href}
                class="flex shrink-0 items-center justify-center bg-primary px-4 py-2.75 text-[11px] leading-4 font-medium tracking-[0.14em] whitespace-nowrap text-white uppercase transition-colors hover:bg-[#083329] sm:px-6.5 sm:py-3 sm:text-[12px] sm:tracking-[0.18em]"
            >
                {NAV.enquire.label}
            </a>
        </nav>
    </div>
</header>
