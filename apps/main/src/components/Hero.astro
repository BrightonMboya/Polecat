---
import { HERO } from '../content/home'

/*
 * The hero cycles HERO.slides on a CSS-only crossfade: no JavaScript, nothing
 * to hydrate, and nothing that can leave the frame blank if a script fails.
 *
 * Each slide runs the same keyframe over the whole cycle and is offset by its
 * own delay, so exactly one is opaque at a time. HOLD is how long a slide sits
 * still; FADE is the crossfade. The first slide's delay is negative by exactly
 * FADE, which starts it already fully opaque — the hero must not fade in on
 * load, because slide one is the LCP.
 */
const HOLD = 6
const FADE = 0.8
const CYCLE = HERO.slides.length * HOLD

/*
 * Keyframe stops, as a percentage of the whole cycle. A slide delayed by
 * `i * HOLD - FADE` fades in over FADE, holds until HOLD, fades out by
 * HOLD + FADE, and is transparent for the rest of the cycle — so exactly one
 * slide is opaque at any moment and consecutive slides cross over.
 *
 * The stylesheet is built here rather than written out below because a CSS
 * keyframe selector cannot read a custom property: `var(--x) { }` is not a
 * valid stop. Class and animation names are global for the same reason
 * (set:html skips Astro's scoping), so both are named for this component.
 */
const stop = (seconds: number) => `${((seconds / CYCLE) * 100).toFixed(3)}%`
const slideStyles = `
.hero-slide {
    opacity: 0;
    animation: hero-slide-fade ${CYCLE}s linear infinite;
}

@keyframes hero-slide-fade {
    0% { opacity: 0 }
    ${stop(FADE)} { opacity: 1 }
    ${stop(HOLD)} { opacity: 1 }
    ${stop(HOLD + FADE)} { opacity: 0 }
    100% { opacity: 0 }
}

/* A carousel nobody asked for is exactly what this setting is about: hold the
   first photograph and never move. */
@media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none }
    .hero-slide:not(:first-of-type) { display: none }
}
`
---

<section class="relative flex min-h-[620px] flex-col items-center justify-end overflow-hidden lg:h-195">
    {/* The photographs are <img> rather than backgrounds so the first can be
        preloaded with fetchpriority and decoded eagerly — it is the LCP.

        Only the first carries alt text and eager loading. The rest are a
        decorative loop over the same subject, so they take an empty alt rather
        than reading four more descriptions out to a screen reader, and they
        load lazily so they cost nothing until after the first paint. */}
    {
        HERO.slides.map((slide, index) => (
            <img
                src={slide.image}
                srcset={slide.srcset}
                sizes={HERO.imageSizes}
                alt={index === 0 ? slide.alt : ''}
                aria-hidden={index === 0 ? undefined : 'true'}
                class="hero-slide absolute inset-0 h-full w-full object-cover"
                style={`animation-delay: ${index * HOLD - FADE}s`}
                fetchpriority={index === 0 ? 'high' : undefined}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
            />
        ))
    }

    {/* Scrim: the least that keeps white type legible, so the photographs
        carry the frame. It is all but clear at the top, gathers weight only
        where the copy sits, and eases back off under it.

        Re-measured for the loop by scripts/hero-scrim.py, which renders every
        slide the way object-cover does at a 1440x780 desktop hero, finds the
        brightest pixel under the centred copy column in each band, and solves
        for the alpha that clears AA over it. Run it again after adding,
        removing or re-cropping a slide, or after moving the copy stack.

        A single photograph could be fitted closely. Eight cannot: every slide
        in this loop puts a pure-white pixel (255,255,255) under the column
        somewhere — a blown-out sky, a cloud, a white shirt, pale thatch — so
        the worst case is the same for all of them and the stops are set once,
        to it:
            headline  62px        46-56%  needs 0.48  (3:1, large text)
            sub-head  22px italic 58-68%  needs 0.61  (4.5:1 — at this size it
                                                       is not large text)
        Hence 0.52 where the headline opens, 0.64 where the sub-head does, and
        both held past where each one closes. Below 68% there is only the call
        to action — white on solid green, which no photograph can reach — and
        then bare frame, so the ink is pulled back from there to the floor
        rather than held at full weight. That foot is the part of every
        photograph the old scrim buried: the fire, the laid table, the
        ground. */}
    <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(35,32,27,0.02) 0%, rgba(35,32,27,0.12) 28%, rgba(35,32,27,0.52) 46%, rgba(35,32,27,0.58) 56%, rgba(35,32,27,0.64) 58%, rgba(35,32,27,0.66) 68%, rgba(35,32,27,0.56) 82%, rgba(35,32,27,0.50) 100%)"
        aria-hidden="true"
    >
    </div>

    {/* One centred stack on the floor of the frame: the headline, the italic
        line, then the single call to action.

        The column widens to max-w-270 at lg so the headline sets on one line.
        It is 886px at 62px/500 with the -0.01em tracking, and the tightest lg
        viewport — 1024px, where max-w-270 is not yet reached — leaves 920px
        inside the 52px gutters. Two lines at 72px cost more than the 10px of
        type: the second line pushed the stack up over the fire. The sub-head
        keeps its own max-w-215, so its measure is unchanged.

        The stack is on the floor of the frame and then pushed back up off it
        by its own bottom padding, which is what sets how much photograph is
        left in the clear underneath. At lg that is 160px, putting the
        headline at 47% of the 780px frame, the sub-head at 59% and the button
        at 73% — so the bottom fifth of every slide carries nothing at all.
        That band is where this loop keeps its subject: the game drive vehicle
        under the acacia, the laid tables, the fire. Dropping this padding
        back down buries them again, and moving it means re-running
        scripts/hero-scrim.py with the new bands. */}
    <div class="gutter relative flex w-full max-w-240 flex-col items-center gap-6 pt-32 pb-28 lg:max-w-270 lg:gap-7 lg:pb-40">
        <h1
            class="font-display max-w-215 text-center text-[40px] leading-[1.08] font-medium tracking-[-0.01em] text-balance text-white sm:text-[54px] lg:max-w-none lg:text-[62px] lg:leading-[1.06]"
        >
            {HERO.heading}
        </h1>
        <p
            class="font-display max-w-215 text-center text-[18px] leading-7.5 text-balance text-white italic sm:text-[20px] sm:leading-8 lg:text-[22px] lg:leading-9"
        >
            {HERO.subheading}
        </p>
        <a
            href={HERO.cta.href}
            class="mt-2 flex items-center justify-center bg-primary px-9 py-4.75 text-center text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-[#083329]"
        >
            {HERO.cta.label}
        </a>
    </div>
</section>

<style is:inline set:html={slideStyles}></style>
