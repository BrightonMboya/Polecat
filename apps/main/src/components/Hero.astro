---
import { HERO } from '../content/home'
---

<section class="relative flex min-h-[620px] flex-col items-center justify-end overflow-hidden lg:h-195">
    {/* The photograph is an <img> rather than a background so it can be
        preloaded with fetchpriority and decoded eagerly — it is the LCP. */}
    <img
        src={HERO.image}
        srcset={HERO.imageSrcset}
        sizes={HERO.imageSizes}
        alt={HERO.imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
    />

    {/* Scrim: pared back to the least that keeps white type legible, so the
        photograph carries the frame. It is all but clear across the sky and
        only gathers weight where the copy sits. Every stop was solved against
        the photograph's own pixels — the lowest alpha per 20px slice that
        clears AA on the single worst pixel under the column — then rounded up.
        On the worst pixel, white reads:
            headline  72px        3.55:1  ✅ AA  (needs 3:1, large text)
            sub-head  22px italic 5.05:1  ✅ AA  (needs 4.5:1 — at this size it
                                                  is not large text)
        Lightening these stops fails the headline. A new photograph means this
        measured again; a darker one would let the scrim go lighter still. */}
    <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(35,32,27,0.02) 0%, rgba(35,32,27,0.52) 44%, rgba(35,32,27,0.64) 70%, rgba(35,32,27,0.7) 100%)"
        aria-hidden="true"
    >
    </div>

    {/* One centred stack on the floor of the frame: the headline, the italic
        line, then the single call to action. */}
    <div class="gutter relative flex w-full max-w-240 flex-col items-center gap-6 pt-32 pb-16 lg:gap-7 lg:pb-24">
        <h1
            class="font-display max-w-215 text-center text-[40px] leading-[1.08] font-medium tracking-[-0.01em] text-balance text-white sm:text-[54px] lg:text-[72px] lg:leading-[1.06]"
        >
            {HERO.heading}
        </h1>
        <p
            class="font-display max-w-215 text-center text-[18px] leading-7.5 text-balance text-white italic sm:text-[20px] sm:leading-8 lg:text-[22px] lg:leading-9"
        >
            {HERO.subheading}
        </p>
        <a
            href={HERO.cta.href}
            class="mt-2 flex items-center justify-center bg-primary px-9 py-4.75 text-center text-[12px] leading-4 font-medium tracking-[0.18em] text-white uppercase transition-colors hover:bg-[#083329]"
        >
            {HERO.cta.label}
        </a>
    </div>
</section>
