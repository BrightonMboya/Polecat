---
/**
 * The route of one itinerary, drawn on a MapLibre basemap: a numbered pin per
 * stop, a dashed line through them in order, and the start and end marked
 * separately. Ported from ~/web/atlas with this site's palette.
 *
 * The library is loaded lazily — the map lives in a sticky sidebar well below
 * the hero, so most visitors scroll to it rather than land on it — and the
 * stops are listed in plain text for anyone without JavaScript.
 */
import type { Route } from '../content/packages'

interface Props {
    route: Route
    class?: string
}

const { route, class: className = '' } = Astro.props

// The full ordered chain the line is drawn through: start, every stop, end.
const chain = [
    ...(route.start ? [route.start] : []),
    ...route.points,
    ...(route.end ? [route.end] : []),
]

const payload = JSON.stringify({
    start: route.start ?? null,
    points: route.points,
    end: route.end ?? null,
})
---

{
    chain.length > 0 && (
        <div
            class:list={[
                'route-map relative aspect-square w-full overflow-hidden border border-line bg-stone',
                className,
            ]}
            data-route-map={payload}
        >
            <div class="absolute top-3.5 left-3.5 z-10">
                <h3 class="text-[10px] leading-3 font-bold tracking-[0.2em] text-muted uppercase">
                    Route Map
                </h3>
            </div>
            <div class="route-map__canvas absolute inset-0" />
            <noscript>
                <ol class="absolute inset-0 flex flex-col justify-center gap-1.5 overflow-auto p-6 text-[13px] leading-5 text-muted">
                    {chain.map((stop) => (
                        <li>{stop.label ? `${stop.label} · ${stop.name}` : stop.name}</li>
                    ))}
                </ol>
            </noscript>
        </div>
    )
}

<style is:global>
    /* MapLibre paints its own attribution and controls; tone them down so the
       map reads as part of the card rather than an embedded widget. */

    /* maplibre-gl.css adds `.maplibregl-map { position: relative }` to the
       container it is given, which at equal specificity and later source order
       beats Tailwind's `.absolute` and collapses the element to zero height.
       Two classes outrank it. */
    .route-map .route-map__canvas {
        position: absolute;
        inset: 0;
    }
    .route-map .maplibregl-ctrl-attrib {
        font-family: var(--font-body);
        font-size: 9px;
    }
    .route-map .maplibregl-ctrl-bottom-right {
        z-index: 5;
    }
    .route-map__pin {
        display: flex;
        height: 22px;
        min-width: 22px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 2px solid #fff;
        background: var(--color-primary);
        padding: 0 5px;
        font-family: var(--font-body);
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        color: #fff;
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    }
    .route-map__pin--start,
    .route-map__pin--end {
        background: var(--color-ink);
    }
    .route-map .maplibregl-popup-content {
        padding: 5px 9px;
        border-radius: 0;
        font-family: var(--font-body);
        font-size: 11px;
        line-height: 1.3;
        color: var(--color-ink);
        box-shadow: 0 2px 10px rgb(0 0 0 / 0.15);
    }
    .route-map .maplibregl-popup-tip {
        display: none;
    }
</style>

<script>
    import 'maplibre-gl/dist/maplibre-gl.css'

    // MapLibre resolves its worker relative to its own module URL, which the
    // bundler does not emit; point it at the copy served from public/ instead.
    // See scripts/vendor-maplibre.mjs.
    const WORKER_URL = '/vendor/maplibre/maplibre-gl-worker.mjs'

    interface Point {
        name: string
        coordinates: [number, number]
        label?: string
    }

    const STYLE = 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json'

    function pin(text: string, variant?: 'start' | 'end') {
        const el = document.createElement('div')
        el.className = 'route-map__pin' + (variant ? ` route-map__pin--${variant}` : '')
        el.textContent = text
        return el
    }

    async function init(container: HTMLElement) {
        const raw = container.dataset.routeMap
        if (!raw) return

        let data: { start: Point | null; points: Point[]; end: Point | null }
        try {
            data = JSON.parse(raw)
        } catch {
            return
        }

        const chain: Point[] = [
            ...(data.start ? [data.start] : []),
            ...data.points,
            ...(data.end ? [data.end] : []),
        ]
        if (chain.length === 0) return

        const canvas = container.querySelector<HTMLElement>('.route-map__canvas')
        if (!canvas) return

        // Kept as a namespace rather than destructured: pulling `Map` into scope
        // shadows the global `Map` type that MapLibre's own declarations lean on.
        const maplibre = await import('maplibre-gl')
        maplibre.setWorkerUrl(WORKER_URL)

        const lngs = chain.map((p) => p.coordinates[0])
        const lats = chain.map((p) => p.coordinates[1])
        // A single-point route has no extent to fit, so give it a small one.
        const spread =
            Math.max(...lngs) === Math.min(...lngs) && Math.max(...lats) === Math.min(...lats)
                ? 0.5
                : 0

        const map = new maplibre.Map({
            container: canvas,
            style: STYLE,
            bounds: [
                [Math.min(...lngs) - spread, Math.min(...lats) - spread],
                [Math.max(...lngs) + spread, Math.max(...lats) + spread],
            ],
            // Pixel padding, so pins clear the card edges regardless of how wide
            // the route's span is: extra at the top for the label, at the right
            // for the widest pin, at the bottom for the controls.
            fitBoundsOptions: { padding: { top: 46, right: 58, bottom: 42, left: 34 } },
            minZoom: 3,
            maxZoom: 12,
            attributionControl: { compact: true },
            cooperativeGestures: true,
        })

        map.addControl(new maplibre.NavigationControl({ showCompass: false }), 'bottom-left')

        // Markers are DOM overlays, so they can go on immediately; only the route
        // line needs the style to have loaded before it can be added as a layer.
        const marker = (p: Point, text: string, variant?: 'start' | 'end') => {
            new maplibre.Marker({ element: pin(text, variant) })
                .setLngLat(p.coordinates)
                .setPopup(
                    new maplibre.Popup({
                        offset: 14,
                        closeButton: false,
                        closeOnClick: false,
                    }).setText(p.label ? `${p.label} · ${p.name}` : p.name),
                )
                .addTo(map)
        }

        // These itineraries mostly fly in and out of the same airstrip; stacking
        // two pins there just hides one behind the other, so collapse them.
        const isRoundTrip =
            data.start != null &&
            data.end != null &&
            data.start.coordinates[0] === data.end.coordinates[0] &&
            data.start.coordinates[1] === data.end.coordinates[1]

        if (data.start) {
            marker(
                isRoundTrip ? { ...data.start, label: 'Start & end' } : data.start,
                isRoundTrip ? 'GO/END' : 'GO',
                'start',
            )
        }
        data.points.forEach((p, i) => marker(p, String(i + 1)))
        if (data.end && !isRoundTrip) marker(data.end, 'END', 'end')

        map.on('load', () => {
            if (chain.length < 2) return

            map.addSource('route', {
                type: 'geojson',
                data: {
                    type: 'Feature',
                    properties: {},
                    geometry: {
                        type: 'LineString',
                        coordinates: chain.map((p) => p.coordinates),
                    },
                },
            })
            map.addLayer({
                id: 'route-line',
                type: 'line',
                source: 'route',
                layout: { 'line-cap': 'round', 'line-join': 'round' },
                paint: {
                    'line-color': '#0c4c40',
                    'line-width': 2,
                    'line-opacity': 0.85,
                    'line-dasharray': [2, 2],
                },
            })
        })
    }

    const containers = document.querySelectorAll<HTMLElement>('[data-route-map]')
    if (containers.length > 0) {
        // Defer both the MapLibre download and the GL context until the card is
        // close to the viewport.
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue
                    observer.unobserve(entry.target)
                    init(entry.target as HTMLElement)
                }
            },
            { rootMargin: '300px' },
        )
        containers.forEach((c) => observer.observe(c))
    }
</script>
